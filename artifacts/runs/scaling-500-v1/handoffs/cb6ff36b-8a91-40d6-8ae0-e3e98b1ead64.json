        "role": "user",
        "content": "{\"reviews\":[{\"review_id\":\"8217b221-be03-48da-8f20-6e493e603eed\",\"review_text\":\"I'm enjoy Spotify it's a Nice app\"},{\"review_id\":\"447eafd7-c542-4791-b5d7-deeace4ad4fc\",\"review_text\":\"App is very very nice song\"},{\"review_id\":\"298f0013-4e19-4ff2-a623-17c8f67cf321\",\"review_text\":\"It has served me nicely for years but this year wrapped didn't arrive for me, I contacted customer service and they simply said i am not eligible this year, and closed the chat without even giving me a chance to ask why. This was highly disappointing due to all my friends getting wrapped from the same region. At least answer your customers questions.\"},{\"review_id\":\"c594e074-353c-4802-a3f5-1333bad4f512\",\"review_text\":\"Fc this app\"},{\"review_id\":\"60f9d67e-5ddb-4bdd-b0d0-dec98556b082\",\"review_text\":\"Everyone else had said it - the new UI is terrible. This isn't instagram or tiktok, please give us the option to revert back.\"},{\"review_id\":\"571463a9-b8b2-4919-bdd5-3f52d846f102\",\"review_text\":\"It's bloody sewdish App.Hell with them devils\"},{\"review_id\":\"fab0f01b-bc8e-4a47-b003-5fdd0c8ac8ea\",\"review_text\":\"Best app when it comes to music. Nice job Spotify.\"},{\"review_id\":\"0767df13-578c-4731-a31b-72f335cf54b2\",\"review_text\":\"I hate this application 🖕🏽🖕👎\"},{\"review_id\":\"f901109f-261f-421c-9167-d03319b9b408\",\"review_text\":\"😡🤬🤬🤬🤬\"},{\"review_id\":\"1a1d76c4-57a1-4f9d-a8f9-1449ba98a4f2\",\"review_text\":\"I got a 23 hour long play lost\"}]}"
