        "content": "{\"reviews\":[{\"review_id\":\"439aaf33-d6cb-4fad-8084-b0d4e2a5062d\",\"review_text\":\"Eu pago o Spotify já fazem dois anos, eu amo esse app, não tem nenhum defeito para mim, adoro usar ele para qualquer ocasião, eu vivo de música kk\"},{\"review_id\":\"d3cba8ad-4b69-42a8-be20-61333e62279a\",\"review_text\":\"App closes everytime i open a song\"},{\"review_id\":\"4f43f66c-597f-47c3-a98a-7082be93acb8\",\"review_text\":\"New to this So far loving it. Hope it stays this way\"},{\"review_id\":\"de9bc939-1349-46e4-bc88-caacd351eb22\",\"review_text\":\"Can't listen to my personal lists anymore. Supposed to be free. Bs\"},{\"review_id\":\"1500a782-7a69-40ec-8884-cdb86d49063e\",\"review_text\":\"Best app for listen music 💯 This app is speechless ✅ . . I have no words🤐\"},{\"review_id\":\"19b96dcb-1673-4b30-ad63-da68becaae10\",\"review_text\":\"Love Spotify music and podcasts.\"},{\"review_id\":\"b7e52aed-8e96-4eed-a6d5-40c3fb0c2a22\",\"review_text\":\"I can't log in to the app using my phone number it says you can use a different number\"},{\"review_id\":\"11c516b9-59de-49d9-b614-f932cf9f4a47\",\"review_text\":\"Very nice!!!!\"},{\"review_id\":\"70c609a8-5f01-457a-b32d-51612b182888\",\"review_text\":\"Much better than Amazon Music for quality.\"},{\"review_id\":\"8ec2c32e-ef02-4e44-948d-447d0516c93c\",\"review_text\":\"Has everything on here and I have premium so it's awesome!\"}]}"
