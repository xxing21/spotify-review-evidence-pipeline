        "content": "{\"reviews\":[{\"review_id\":\"aedcc69d-de01-4792-b373-216e60bf3c19\",\"review_text\":\"very good aaap form listing song\"},{\"review_id\":\"7a39aa80-38d8-4d7f-a7cf-b5f81f2d9dd4\",\"review_text\":\"New updates just ruined the app..... can't turn shuffle off, playlist always Play in shuffle mode only... what's the point of having a playlist then. Plus we can't add add songs to queue... they just want us to buy premium subscription.\"},{\"review_id\":\"547c8185-63d2-4b98-bac0-bbb3c3784be4\",\"review_text\":\"Good stuff on spotify\"},{\"review_id\":\"fc6a598b-d9a9-4d05-aa9f-df61bba1390b\",\"review_text\":\"jr www , 😞, 😞 Too\"},{\"review_id\":\"41b63391-8dc2-44cc-b83b-e3f5ee6c3312\",\"review_text\":\"Very easy app to use and has always the most updated music. Offline mode works great and i can listen music 24/7\"},{\"review_id\":\"8e63746b-e057-4f2d-bdd9-4bd891484c93\",\"review_text\":\"Hi I love Music and Podcasts because I like to listen music 🎶\"},{\"review_id\":\"698fcbfb-78c5-43a1-b498-a128f45a2461\",\"review_text\":\"Nice good amazing\"},{\"review_id\":\"b5646487-c1ed-4979-a6a1-003d0cde3c4f\",\"review_text\":\"Horrible the only good thing about free membership on mobile is you can go on other apps with the music. I can't play a song THAT I WANT horrible app for mobile\"},{\"review_id\":\"2cff78c7-c312-4bf1-a5fc-b72e58b1e726\",\"review_text\":\"New update sucks🤦🏾‍♂️\"},{\"review_id\":\"e43947b5-db85-45c6-a2ff-f25b92c1d030\",\"review_text\":\"This app is so good and I love that I can find any song I want\"}]}"
