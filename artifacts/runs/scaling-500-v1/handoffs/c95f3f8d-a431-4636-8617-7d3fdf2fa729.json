        "content": "{\"reviews\":[{\"review_id\":\"6efd44a2-f720-433f-8f44-9d834860c32a\",\"review_text\":\"Spotify is the goat. Apple music is for broke people\"},{\"review_id\":\"c7d92601-16c4-41f3-9c75-192cbfdce964\",\"review_text\":\"Too many ads and mobile has less features than desktop (not premium)\"},{\"review_id\":\"004e5334-79c6-4cef-977d-6f334e4a1855\",\"review_text\":\"You guys are so done if I want to repeat the songs I've to take premium? Huh seriously we should all just stop using this useless app\"},{\"review_id\":\"04e08aa0-04a0-401e-a729-a6ced79a883c\",\"review_text\":\"inangyan lamon na nga kami sa ads di pa makapili ng gustong song na patugtogin naknang\"},{\"review_id\":\"009899d6-d6ba-427f-9e25-3c1e9a350f97\",\"review_text\":\"This is the best apps ever\"},{\"review_id\":\"9ae47fdd-c9a3-44b9-8d63-2a067cc92191\",\"review_text\":\"Resend update very worst 👎\"},{\"review_id\":\"b8fb8ef9-784b-444c-a5e0-a3191c5f1fcb\",\"review_text\":\"Recent update has made literally every function a premium feature. You cant listen to a particular part of a song, you can't listen to the previous song, you can't add music to your queue, no more lyrics, auto shuffling in your playlist restricts you from listening to songs in a particular order. It's absolutely ridiculous.\"},{\"review_id\":\"8655f464-f8d5-46d3-a8a6-ffbbc35f5506\",\"review_text\":\"Good but adds are too much\"},{\"review_id\":\"ae514173-0294-4a36-a36c-d55a2c67a058\",\"review_text\":\"Tumbaron \\\"Spotify nos Interrumpio\\\"\"},{\"review_id\":\"f56311de-3b6e-4b1c-9793-c4da662fde45\",\"review_text\":\"Im unable to log in using my mobile num till yesterday it was working whats wrong today\"}]}"
