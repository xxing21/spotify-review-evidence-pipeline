        "content": "{\"reviews\":[{\"review_id\":\"5777c4cb-9bb7-46a4-b194-cba539b83076\",\"review_text\":\"I love the daylimix\"},{\"review_id\":\"0a641956-3d9e-4af4-ac6e-85b9fc6e4906\",\"review_text\":\"Enjoy building my own playlists\"},{\"review_id\":\"6840dee3-51b9-48a5-b3f7-c1aa22652f87\",\"review_text\":\"Super 💞\"},{\"review_id\":\"2ffba33e-b091-4dee-86a0-cd38c6574e43\",\"review_text\":\"Cannot login into my account😭😭\"},{\"review_id\":\"b3f8ed6d-768b-4eec-8421-d0ac0a375e22\",\"review_text\":\"I love it but how do I use songs as my ringtone\"},{\"review_id\":\"52f8d7e8-edf6-4d80-85bf-68f67161f525\",\"review_text\":\"I like your 30 mins uninterrupted, but its hard to enjoy when you software runs with the processing power of a 2 year old with down syndrome! Take a lesson from YouTube and actually play what people search for!\"},{\"review_id\":\"6b3f4ea6-dded-40db-adeb-5fce9d9c087b\",\"review_text\":\"Never has failed me. I love it had I'd for so long can't compare to any other\"},{\"review_id\":\"abc4795b-4197-47f0-bd4a-7e33a54a5816\",\"review_text\":\"This new update men it sucks, im uninstalling it\"},{\"review_id\":\"7cdfa3bf-417e-4b12-86d2-c2d0b9e07c71\",\"review_text\":\"For my ladies.\"},{\"review_id\":\"5c99b000-5268-4fa9-b21a-759512db1ada\",\"review_text\":\"Boycott sewden 💩💩💩\"}]}"
