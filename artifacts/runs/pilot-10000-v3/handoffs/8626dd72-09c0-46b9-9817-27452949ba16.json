        "content": "{\"reviews\":[{\"review_id\":\"0150b44e-a0c9-445f-9adb-9b78a7babf4d\",\"review_text\":\"I don't want to buy subscription\"},{\"review_id\":\"416709cf-7aeb-4837-8b72-2cb75f40eb8a\",\"review_text\":\"The app overall is great ,but for non-English songs there's no translations (for the title)even with Spotify premium Need a fix for this\"},{\"review_id\":\"eb2d450a-8981-42dd-9cf8-c82e3ad3fccc\",\"review_text\":\"I love Spotify. He's a Great Dane. I named after my favorite app.\"},{\"review_id\":\"822c0a28-18c7-4d21-b6a7-9756b55fa051\",\"review_text\":\"You can't go any lower than this bruh\"},{\"review_id\":\"61f32bb4-d7e9-4d80-bf61-ce4f5c81772d\",\"review_text\":\"Lyrics stopped working with latest update..always something with Spotify that glitches!\"},{\"review_id\":\"4bcd58a0-4bad-4cd1-8de6-bbc67a6e1402\",\"review_text\":\"Its good to just blast music in my ears and not worry about people\"},{\"review_id\":\"8aee4525-d523-46bf-bcae-ea7a2582fd6c\",\"review_text\":\"I want a small update for music play timer\"},{\"review_id\":\"477969e5-9eaf-42db-92bc-65723247c74c\",\"review_text\":\"i love it so much😄😄😄😄\"},{\"review_id\":\"2fb36f34-d94c-4ee3-a06e-cdb90d10901d\",\"review_text\":\"Super\"},{\"review_id\":\"6d70b59e-eaa3-4029-a227-18a21539f3a9\",\"review_text\":\"Best, most advanced music platform for sure, it's just the way to go and super pleasing to look at, use, works with everything, Spotify ftw\"}]}"
