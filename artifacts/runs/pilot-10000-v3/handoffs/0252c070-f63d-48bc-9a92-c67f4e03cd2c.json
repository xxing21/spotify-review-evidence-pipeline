        "role": "user",
        "content": "{\"reviews\":[{\"review_id\":\"8c36690c-d0ac-4b7c-86f4-418391d8e604\",\"review_text\":\"The Spotify company has become extremely money oriented and has stripped the app from all its original positives and has turned it into negatives. Wouldn't recommend at all\"},{\"review_id\":\"5e664644-c630-4d64-adcf-3937a4f37124\",\"review_text\":\"Osm blosm dosm 🥳🥳🥳🥳🥳🥳\"},{\"review_id\":\"b0c02be0-4317-48e4-b05b-788f11691902\",\"review_text\":\"Amazing 🤩\"},{\"review_id\":\"76699f3d-15db-49b3-9c25-ad73f1259b8b\",\"review_text\":\"Soooo nice 👍👍👍👍\"},{\"review_id\":\"2c5477de-5dfe-4c41-974d-1082d08f1370\",\"review_text\":\"It's very good for being able to listen to whoever you want to listen to.\"},{\"review_id\":\"2c566b2f-684b-4cda-940f-23ec9385f61a\",\"review_text\":\"Good app to use. Hopefully more music can be added and customize the app a bit.\"},{\"review_id\":\"99e83076-ce84-49d6-8d50-eb91d88ebde1\",\"review_text\":\"Automaticaly logout my account\"},{\"review_id\":\"f96e1c75-650b-4e27-ad5b-53c138d57406\",\"review_text\":\"Excellent choice of selection great algorithm and a overall great listening experience.\"},{\"review_id\":\"90614e21-3f8f-4ba1-97a8-1db8d8c7a764\",\"review_text\":\"I love this app but previously I logged into my old account on my laptop and then proceeded to give me that account on my phone so now I've lost my new, better account. I would appreciate a choice to toggle between users like YouTube if that's possible\"},{\"review_id\":\"cf8e5a26-5a72-4b78-b61a-4f5df0de50e6\",\"review_text\":\"Hate this application 😡😡🤬🤬🤬\"}]}"
