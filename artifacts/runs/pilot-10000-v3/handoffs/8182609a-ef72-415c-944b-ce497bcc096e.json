        "content": "{\"reviews\":[{\"review_id\":\"19933896-50d6-4e9a-8196-271d6e4360fa\",\"review_text\":\"Love the app\"},{\"review_id\":\"fb701920-494f-4538-be6f-079ef46b6f5b\",\"review_text\":\"Too much of advertisements .. and sometimes doesn't work\"},{\"review_id\":\"a6874ffb-c25a-49d0-a58c-7c5c2bb562d1\",\"review_text\":\"Very good\"},{\"review_id\":\"7e03c2c5-81f9-4c63-bbaa-155e16de8007\",\"review_text\":\"Its awsome, wonderful\"},{\"review_id\":\"9a6978e2-b112-4312-a464-da6f905c9b64\",\"review_text\":\"Ads dont last the 30 minutes how they say they do but overall good app\"},{\"review_id\":\"67fdb49c-6833-4cfb-93e8-285ed7dcddcb\",\"review_text\":\"I don't know if it is just my headphones, my device, or the app but it only makes the background sound and the shouting audible, but the melody in the songs doesn't play at all. If this problem is fixed I will rate 5 stars.\"},{\"review_id\":\"9bdd5988-43bd-480f-8a6b-9e52098e1c16\",\"review_text\":\"Relaxing\"},{\"review_id\":\"0c4c8caf-b774-4d35-bd49-ad30ffd0d4ae\",\"review_text\":\"Best app put there, I cannot live without my Spotify snd neither can my kids and my boyfriend. SPOTIFY IS LIFE\"},{\"review_id\":\"c2211abb-f5fb-4c13-baaa-8613521b6058\",\"review_text\":\"Great\"},{\"review_id\":\"2cee833b-e3c5-4b31-b611-993cd072975f\",\"review_text\":\"Bikod\"}]}"
