        "role": "user",
        "content": "{\"reviews\":[{\"review_id\":\"f58b79cc-2ee2-4a93-a653-6a601ea3a813\",\"review_text\":\"GOOD\"},{\"review_id\":\"4af6ff50-05a4-4c10-a69a-6e2406d16686\",\"review_text\":\"They have removed all the basic fearures from the app like we can't listen to some part of the song, we can't even play the song of our choice, they have removed the lyrics of most of the songs, there is atleast one add after every 2 songs. Now we have to get the premium version for these basic features\"},{\"review_id\":\"f187db02-ef63-4dfa-b0fc-7e4c99580597\",\"review_text\":\"Love everything about it\"},{\"review_id\":\"a9e908cc-b5c2-4ee8-ac40-9b19692bb4b5\",\"review_text\":\"It says \\\"enjoy your next 30 minutes of uninterrupted music\\\" and then after 2 songs the next ad starts playing.\"},{\"review_id\":\"30320dd1-fd34-4e72-a2d7-3fe34c834b02\",\"review_text\":\"Spotify is good application\"},{\"review_id\":\"931ae38c-d9c3-4e5b-9c1c-dac699b62c8e\",\"review_text\":\"It's a good app, but I don't like how you have to get premium to unshuffle your playlists.\"},{\"review_id\":\"84b72fa7-5a49-46d9-9500-17a112d7f632\",\"review_text\":\"Great 👍\"},{\"review_id\":\"37490349-82d2-42d8-9b52-19216c936423\",\"review_text\":\"New version is so bad\"},{\"review_id\":\"3508ac83-8f39-4ee3-995e-3efe65ead722\",\"review_text\":\"Its taking alot of phone memory. Ads are very frequent .\"},{\"review_id\":\"f8bbf985-4c3d-4ac2-ae3a-17791667c480\",\"review_text\":\"this AMAZING!!! Spotify is very very good highly recommended\"}]}"
