        "content": "{\"reviews\":[{\"review_id\":\"a6d64321-9580-49b6-a92a-4a16fc8e2148\",\"review_text\":\"Good and best app to listen song.\"},{\"review_id\":\"5387d8fe-d84f-46ca-874d-f385e6ef281a\",\"review_text\":\"Everything was going well till the latest update in the app. The experience got more n more horrible, you can't play songs in order n neither can you rewind your songs. I'm sorry to say but this keeps going on you might lose your customers\"},{\"review_id\":\"6e44fc95-8d62-4d6a-8b44-d922d0b9cc75\",\"review_text\":\"Spotify updates forced me to rate 1 star and uninstall it...\"},{\"review_id\":\"fa5eba46-75b8-4aba-8efd-a0e47c186906\",\"review_text\":\"i really hate this app so much whats wrong with it like why is shuffle a thing? please remove it its horrible and the ad thing is such a lie i dont get a ad every 30 minutes i get it every 5 minutes spotify please fix your app and make it good!\"},{\"review_id\":\"ad2633dc-5876-4ddd-b15a-bd8677dd3864\",\"review_text\":\"Very useful app- access to a huge catelogue of music and podcasts.\"},{\"review_id\":\"682eacf2-36f8-425d-8bf9-215fd43df912\",\"review_text\":\"Love it\"},{\"review_id\":\"004a9e2a-cc74-474b-a3c3-d63a8afd30da\",\"review_text\":\"Amazing\"},{\"review_id\":\"4b92a3aa-8303-407a-86b3-3c83e8afbcc6\",\"review_text\":\"I use it everyday....\"},{\"review_id\":\"5a144aed-3fdb-4d56-a045-7e021cc7de47\",\"review_text\":\"Can't fault it listen to ones favourite music anytime anywhere\"},{\"review_id\":\"adbe60b6-9a38-4be9-b502-225710a537d1\",\"review_text\":\"Best app to worst now!!all basic features removed\"}]}"
