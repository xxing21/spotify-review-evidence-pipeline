        "content": "{\"reviews\":[{\"review_id\":\"a0feb4d8-59d5-4ef0-8102-86b454007a5c\",\"review_text\":\"Every worrst handling this app\"},{\"review_id\":\"8af5f71c-4053-44e5-b0ff-6c6a5a0ba294\",\"review_text\":\"Good songs good to listen helpful.\"},{\"review_id\":\"31bb3905-3358-47ef-a802-010683c63e89\",\"review_text\":\"I am not able to login into my own account, it shows \\\"check your no\\\" Rubbish\"},{\"review_id\":\"23685af6-de32-4187-91d8-9471fd69fc20\",\"review_text\":\"I am using Spotify for so long. But this time I am totally disappointed with this app as it removed the \\\"repeat\\\" option from it.\"},{\"review_id\":\"f9fd3f3b-06e3-4d99-87aa-1d16c76cc2fc\",\"review_text\":\"The old versions of spotify is better. I cant even play a song that i want. When i click play a song i want to play. It plays other songs that im not familiar with. And i found put bc of the shuffle playlist. I dont need even need it to play randomly when i wanna play a song i want. Pls go back to the better spotify old days. Where you can pick and play a song you want freely. But for now 1 star.\"},{\"review_id\":\"ceb484d1-3903-4cf5-9b64-b97d6c7cb889\",\"review_text\":\"Great\"},{\"review_id\":\"164d3fa0-723f-4325-a12e-9fa85edde9de\",\"review_text\":\"I like it so much this app is very good but the ads are so long but I can deal with it\"},{\"review_id\":\"85908a73-7de5-4cd7-b244-82663c16633b\",\"review_text\":\"So cool app!\"},{\"review_id\":\"22beb7b8-a5b5-4c80-9755-37adf8ade60b\",\"review_text\":\"Add paying monthly subscription using mpesa. Otherwise great app\"},{\"review_id\":\"78bdaa56-167b-4647-bb9c-476b3ec97e6f\",\"review_text\":\"Hate this app, veru bad experience\"}]}"
