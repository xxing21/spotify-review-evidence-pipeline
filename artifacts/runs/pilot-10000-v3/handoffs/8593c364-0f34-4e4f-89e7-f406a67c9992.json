        "content": "{\"reviews\":[{\"review_id\":\"2bc3d7b4-1cdd-46a2-8f26-fb408f0e332d\",\"review_text\":\"Why after update Spotify app is not logging in with username hope you'll fix that issue Best regards\"},{\"review_id\":\"8197eac1-b915-40ea-b3c8-3b73059073b0\",\"review_text\":\"Greed company trying to milk for money. Pathetic. Most basic features of any music player is totally messed up and paid. Don't know which management jok...r sitting in the decision making for Spotify took these steps to make the most basic features paid. Will be quitting from Spotify shortly\"},{\"review_id\":\"88f43cb5-4aec-4e02-bd5b-ecf88e167fc4\",\"review_text\":\"This app is super\"},{\"review_id\":\"159e9b7c-e7c5-4f11-9cc1-b456462295c2\",\"review_text\":\"Noo past life is gone\"},{\"review_id\":\"dc1fd80a-65c5-46d4-9156-09023665ce87\",\"review_text\":\"Best\"},{\"review_id\":\"9fc7d969-10d7-4af9-8467-62e2df6f0508\",\"review_text\":\"Okay\"},{\"review_id\":\"24e63383-4646-4f63-ae37-2014857c236b\",\"review_text\":\"Very good\"},{\"review_id\":\"808df0fa-c2f6-4eac-9b58-fdc354e85a38\",\"review_text\":\"Very bad rules\"},{\"review_id\":\"989283f8-cd15-463d-acc7-063af6ac61dd\",\"review_text\":\"May add more songs\"},{\"review_id\":\"c79d3c8f-d6d0-48fb-9f0e-bdb555fbd027\",\"review_text\":\"Guchi\"}]}"
