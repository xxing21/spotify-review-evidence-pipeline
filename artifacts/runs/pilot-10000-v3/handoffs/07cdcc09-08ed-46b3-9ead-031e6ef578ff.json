        "content": "{\"reviews\":[{\"review_id\":\"40ca6b9b-ece9-4318-9a04-149c2bfeddf9\",\"review_text\":\"Boycut for all Sweden product and software\"},{\"review_id\":\"7ccb5cb0-89de-49ba-ac77-6c21ecd3c40b\",\"review_text\":\"Being toooo professional 😑😑😑😑\"},{\"review_id\":\"17744c90-fbf0-4806-92fe-981e1f8302af\",\"review_text\":\"I honestly thinks its one of the best if not best music downloader app.\"},{\"review_id\":\"f934e939-1234-4f6a-8714-7af05f495e28\",\"review_text\":\"Love it, dosnt have my favorite song called \\\"rent week\\\" by hilltop hoods though so....\"},{\"review_id\":\"d28fad43-a3fb-44a1-8b66-58e90e340871\",\"review_text\":\"Easily the best music app ever! Love the new features coming in everytime! There's hardly any bugs and connects to so many things! I would definitely suggest for premium too if you're a true music lover as well!! 🎶🎶🎶\"},{\"review_id\":\"a9ce50bc-0e67-4ffe-8354-e1c322769be9\",\"review_text\":\"Adss 🙄\"},{\"review_id\":\"e9ded7ff-eca0-499b-a45e-dc54c5dba91d\",\"review_text\":\"Songs are good but lot of update problems doesn't allow to deny any update and open the app\"},{\"review_id\":\"0eb06f2a-7ec3-4d46-92a9-8079f886ef59\",\"review_text\":\"Greatest\"},{\"review_id\":\"1b4e73d8-4c81-4864-92f4-217484dbada1\",\"review_text\":\"Terrible\"},{\"review_id\":\"399a000b-f4a1-48f9-906f-8592c4d749f9\",\"review_text\":\"Making app more wise than ever through update\"}]}"
