        "content": "{\"reviews\":[{\"review_id\":\"d6c18461-4baf-4833-8c01-9c7db1f8dee9\",\"review_text\":\"This is a very good app for music ☺☺\"},{\"review_id\":\"ed475c64-c636-4806-a22b-b41fa1fa8ef2\",\"review_text\":\"Easy\"},{\"review_id\":\"441099af-e6a6-4a70-96f9-70e255074e9b\",\"review_text\":\"Nice app\"},{\"review_id\":\"053ec353-6168-4737-a6bd-e01069695694\",\"review_text\":\"In love with the music 🎶\"},{\"review_id\":\"3f569a73-2f74-499d-9efe-c5a21be9fe3e\",\"review_text\":\"Great\"},{\"review_id\":\"7dd59fe4-b27a-4a66-8eca-db233b4d26d4\",\"review_text\":\"What is wrong with this app?? Why are they trying to lure people to pay for premium to access such a basic function of a music player?? Like I have to pay to be able to go back to my previously played song. I cannot use my backward button. So money hungry that they will eliminate the basic of the basic features to make people pay. That's why people are leaning towards downloading pirated mod apk version online.\"},{\"review_id\":\"8948f1b1-8e98-4d0d-b8f6-788a8790ce7b\",\"review_text\":\"Premium for everything. I hope spotify will not ask for premium to uninstall this from my phone.. Thanks Spotify team... I'm happily uninstalling this app from my phone. 😂\"},{\"review_id\":\"ee92c6f7-f79a-415a-ae59-0218b50e1347\",\"review_text\":\"AWESOME!!!!\"},{\"review_id\":\"0e2552aa-3560-4373-b9a4-ec5185a9a394\",\"review_text\":\"Tati aap\"},{\"review_id\":\"823b8d6b-e2c8-4436-b22f-4fc140eb77fd\",\"review_text\":\"Keeps stopping frequently.\"}]}"
