        "content": "{\"reviews\":[{\"review_id\":\"7e56d8c8-1a9f-49a4-bd6c-2de9b1bbdcb0\",\"review_text\":\"I don't even have to say a word, on why it's amazing\"},{\"review_id\":\"02b580ab-5704-418b-a79f-689d1952f1d5\",\"review_text\":\"Well.. Its just the best.\"},{\"review_id\":\"b33a2fcc-dc40-4a26-85a3-7021a265fed0\",\"review_text\":\"SPOTIFY NEEDS A COMMENT SECTION UNDER THE SONGS LIKE YOUTUBE VIDEOS OR TIKTOK ETC\"},{\"review_id\":\"95c8f148-38a3-44d8-b832-672895f4b9e9\",\"review_text\":\"wheres the lyric lol\"},{\"review_id\":\"9e73a0d9-81b1-4ad6-8cc9-f3d590199b55\",\"review_text\":\"Cannot live without it. I listen to music for the majority of my day. This app has everything I ever search for. Love it.\"},{\"review_id\":\"62ad2462-7b07-4238-9025-8cdcaf4e7c8d\",\"review_text\":\"It's aight\"},{\"review_id\":\"8fb5427d-a06d-4f12-aaef-b5063048b978\",\"review_text\":\"Lately the music keeps stopping while using bluetooth in the car. After it stops it wont start back up till I try multiple things to get it to work. Its a newer phone so connection not an issue. I used to love this app not sure whats going on with it lately but its been a pain\"},{\"review_id\":\"9366cfa1-9a9d-4451-aa94-a5f29c028ee3\",\"review_text\":\"So far so good\"},{\"review_id\":\"48e2132a-4f7a-4547-b46c-dd5d686dd7fe\",\"review_text\":\"Amazing App, they truly know me\"},{\"review_id\":\"ad50a1fd-1d82-4c34-85eb-fdd4f35c9694\",\"review_text\":\"Amazing\"}]}"
