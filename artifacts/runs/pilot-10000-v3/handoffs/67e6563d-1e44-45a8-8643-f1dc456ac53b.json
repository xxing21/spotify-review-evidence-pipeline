        "content": "{\"reviews\":[{\"review_id\":\"87768294-bfa2-4a25-92f0-9e21769a6da4\",\"review_text\":\"It is really a good app for listening to music and I would rate this a 9/10. The only thing I don't like is the adds\"},{\"review_id\":\"c8d094d2-3af0-4eea-a63a-28c627f72f5b\",\"review_text\":\"Just all round good stuff\"},{\"review_id\":\"318d04b3-9524-4244-bd6b-5fb1726c6a9b\",\"review_text\":\"Mast\"},{\"review_id\":\"b4c840a5-d693-4d24-bf14-ec7155c20cb3\",\"review_text\":\"Very good\"},{\"review_id\":\"34a7f857-5d2f-48ef-a2df-d9064c522053\",\"review_text\":\"If theres no ad, will be better.\"},{\"review_id\":\"793bb38f-f9ff-42b3-a801-d0ae2c3e5a19\",\"review_text\":\"You should apologize to LISA!?! Such a shame Spotify??/?\"},{\"review_id\":\"ee10177b-a6ad-4512-8c1f-330ad835c890\",\"review_text\":\"Very bad on the watch. I faced multiple desync issues IN A SINGLE DAY and an overall laggy ui experience. Massive headache!\"},{\"review_id\":\"3e97cfac-8cb5-4c46-948b-b4ccfb9b85db\",\"review_text\":\"Awesome app\"},{\"review_id\":\"cc61a333-02fe-4fa0-bee4-be81494862d0\",\"review_text\":\"I like entire albums\"},{\"review_id\":\"b5744d4c-f7e2-4464-8acb-87315e621016\",\"review_text\":\"It is bad\"}]}"
