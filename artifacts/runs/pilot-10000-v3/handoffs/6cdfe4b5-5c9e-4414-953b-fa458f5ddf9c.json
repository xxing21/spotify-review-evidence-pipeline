        "role": "user",
        "content": "{\"reviews\":[{\"review_id\":\"d75d0860-2d1e-4634-97a8-ca6ca63d9d0e\",\"review_text\":\"This app WAS the best app for listening songs. New updates are making me abandon this app and use other apps. Everything needs premium, even the basic features need premium. This is actually a pretty bad move by you guys. I'm already using other apps now. If you are not bringing the old version back, you guys will be out of the market very soon. You should definitely remove these new updates.\"},{\"review_id\":\"e13f5b0e-07ca-401d-80c3-5bf2b2bc0cb1\",\"review_text\":\"Dustbin\"},{\"review_id\":\"f146ca2b-6f20-4b4a-8530-e19889c625c2\",\"review_text\":\"New to this the truth is still music and loving it!!!\"},{\"review_id\":\"a61ccd6b-07ef-4076-b10b-73b6b3ae9a8a\",\"review_text\":\"One of the worst app after they changed their condition of free use\"},{\"review_id\":\"31c587ab-ab25-4262-8c0d-185b7f5e5b30\",\"review_text\":\"add lanscape mode when viewing the lyrics\"},{\"review_id\":\"8fee08ec-fa87-492b-8655-980fc18c2ef9\",\"review_text\":\"Loved the app, music quality is good and simple to sync with my other devices\"},{\"review_id\":\"1c83a8d6-ad36-4de6-9bcf-71bf17890712\",\"review_text\":\"Why I rate Spotify 5 stars because I can listen to music like YouTube premium free\"},{\"review_id\":\"d1c8823b-b7f8-4127-970c-fe3fe33526c3\",\"review_text\":\"New update has totally destroyed the app\"},{\"review_id\":\"13845fff-ccbb-4c56-be66-77d4a33c69f6\",\"review_text\":\"This \\\"WAS\\\" the best app ever to listen. This was my favourite app to listen to music.Now, because of the new update , I m hating it. Better to change the new update or no one will use this app .\"},{\"review_id\":\"f27d46d6-67d3-4380-b670-da32b4b2bcf7\",\"review_text\":\"Good experience\"}]}"
