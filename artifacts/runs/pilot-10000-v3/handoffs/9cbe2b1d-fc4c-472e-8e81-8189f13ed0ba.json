        "content": "{\"reviews\":[{\"review_id\":\"b20076f5-ef36-4e8f-9ceb-3bb031d16353\",\"review_text\":\"I can't choose the songs I want to play. Has to be a premium subscription for that, the most basic thing to do. No thanks!\"},{\"review_id\":\"80149312-3dd1-4623-ac90-e820e9969aa7\",\"review_text\":\"They keeps it 💯\"},{\"review_id\":\"0368e2b6-b2dd-4671-9072-5d429b24a4a8\",\"review_text\":\"If you are ready to take the premium, then it's the best place to spend your money on for music.\"},{\"review_id\":\"ba6de95b-eb42-4794-ac3d-7f4eda49a5af\",\"review_text\":\"I make a playlist and it will play through normally on my computer but on my phone it will just randomly play music NOT in my playlist. Makes it hard to go to sleep when I can't listen to the music I want to fall asleep to.\"},{\"review_id\":\"db874588-83e2-462f-a515-d79ab9211702\",\"review_text\":\"Great\"},{\"review_id\":\"45f50a2d-4f73-49b3-8c92-02e6950ff041\",\"review_text\":\"I have a problem if i enter my playlist it will not show me my music\"},{\"review_id\":\"ca4ba39b-9252-47af-a311-16eab2c7130e\",\"review_text\":\"Bad app\"},{\"review_id\":\"d473460a-d456-4a0a-be93-c25b6d1ccbe4\",\"review_text\":\"Ads want to remove\"},{\"review_id\":\"f3111e23-5a71-45d2-af75-d1f19595759d\",\"review_text\":\"i hate this application\"},{\"review_id\":\"628b3c3a-8370-4515-99b9-18699d219dd9\",\"review_text\":\"Nice\"}]}"
