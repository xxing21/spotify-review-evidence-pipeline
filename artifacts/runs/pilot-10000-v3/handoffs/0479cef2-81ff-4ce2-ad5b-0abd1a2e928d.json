        "content": "{\"reviews\":[{\"review_id\":\"9fb9bfaa-0304-4d1a-a60b-ad86a9bd0961\",\"review_text\":\"Been offline for a few days now, also there should be a \\\"pay now, update payment\\\" feature within the app.\"},{\"review_id\":\"09e134f9-124f-474f-8e0c-324e6e953304\",\"review_text\":\"Dernière mise à jour horrible. Interface utilisateur inutilisable.\"},{\"review_id\":\"8fe183d0-b907-41e7-918b-8a46112e8cec\",\"review_text\":\"It doesn't have many folders and gaana is better.. It's more comfy without premium also\"},{\"review_id\":\"60bd0602-aecc-4086-9d29-890a28b58d25\",\"review_text\":\"Very good but the service crashed today =/\"},{\"review_id\":\"d458800c-b837-4a0e-a219-71d7a445e2c1\",\"review_text\":\"I have premium and everything I need something more like I have made my Audio loud and it's not loud enough can you make the audio louder please if you do that it'll make my day\"},{\"review_id\":\"6e60f518-3f6e-44f6-be7c-aa065b93abbc\",\"review_text\":\"Love it, havd been using it for ages and its just great\"},{\"review_id\":\"c0a05686-6a0a-49dd-8be7-b34caadd16ac\",\"review_text\":\"Yay, music is awesome and I love being able to listen while my phone is in my pocket unlike the other music ppl. Thanks sootify.\"},{\"review_id\":\"3b62b532-35d9-4d67-a559-783835c24fd0\",\"review_text\":\"Pretty amazing songs, podcasts\"},{\"review_id\":\"0534b9a0-715d-4eee-8b59-0a79d9031738\",\"review_text\":\"Impressed\"},{\"review_id\":\"2b55b30f-a726-4fb6-8473-cef57252652b\",\"review_text\":\"Trash app now, won't purchase premium ever\"}]}"
