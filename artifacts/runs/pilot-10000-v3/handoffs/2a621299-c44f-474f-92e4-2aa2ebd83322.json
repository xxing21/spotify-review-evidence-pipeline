        "content": "{\"reviews\":[{\"review_id\":\"612231f1-b917-4b6c-8f25-1f26d3003d09\",\"review_text\":\"Bycourt\"},{\"review_id\":\"20defdcb-9118-4b6c-b37e-397593d40e3f\",\"review_text\":\"Brand\"},{\"review_id\":\"d84b85b6-476f-4cce-8cac-4268bac1db7f\",\"review_text\":\"I've had a nice experience with Spotify and it's worth it.\"},{\"review_id\":\"f9345a7c-6da2-43ac-9204-96db24d9ae65\",\"review_text\":\"Its a great app but.. Since the new update spotify is just no💀 you cant even play your fav song over and over why did you removed that in the app idk whos idea to put random songs in your playlist who EVER thought of that is a horrible idea\"},{\"review_id\":\"403cff42-dcc9-4432-b80a-796d78fee3fb\",\"review_text\":\"Overall a great app, algorithm tends to overplay songs and leave older ones collecting dust. I've also been having trouble recently using offline mode, as it'll just buffer forever when selecting a song even if it's downloaded, pretty irritating considering that's one of the main reasons for a premium subscription\"},{\"review_id\":\"c4cf5200-bc7b-442c-9036-348057f623b5\",\"review_text\":\"I can't set up a new account it just doesn't work\"},{\"review_id\":\"a6486a2e-a50d-4fbd-9d0d-aac07a48fd70\",\"review_text\":\"Stuff here and there but honestly good\"},{\"review_id\":\"ee468bec-b56f-4749-9690-6a1c7a9352e6\",\"review_text\":\"Good Music\"},{\"review_id\":\"4eeec15b-3c5d-408c-ae39-27bfae547b84\",\"review_text\":\"Great app love it I liked it B4 n like it now great sound\"},{\"review_id\":\"1a33fc32-4db7-4c4f-939f-76ff09988eed\",\"review_text\":\"Nice\"}]}"
