        "content": "{\"reviews\":[{\"review_id\":\"cbc20eb8-441a-44a2-9481-f84baa8755ab\",\"review_text\":\"Very poor service and I'm using there family plan of 1 year by the crazy hype of ad. Now I'm suffering of the \\\"no internet connection\\\" bug. Even tho I'm using the latest updated version.. also tried changing my network even the wifi connection no use of it meanwhile my YouTube, Instagram working completely healthy It's been 2 weeks I'm not sure what to do tried the Spotify support no use no reply. Very worst service don't ever think of using this app.\"},{\"review_id\":\"090e5335-15a7-4f6b-8dc7-ffbd430bdef4\",\"review_text\":\"Extrasensorial!!\"},{\"review_id\":\"fa1150c5-ff72-48e1-a0d7-5777f4b257c6\",\"review_text\":\"I like this app for song's...i love it...🥰\"},{\"review_id\":\"327c50a6-7dee-4c79-aa55-06cc9b105fca\",\"review_text\":\"I highly recommend!\"},{\"review_id\":\"418bcc9d-c472-47ad-a0cd-20a1720c6b04\",\"review_text\":\"The best\"},{\"review_id\":\"29c0810b-7415-4acb-b053-681baae928ca\",\"review_text\":\"My go to for music allows you to do whatever without touching one knobb\"},{\"review_id\":\"dab1a070-5c7f-44a0-b271-8f1a489fe09d\",\"review_text\":\"So far I love Spotify. Had great results so far.\"},{\"review_id\":\"fecb91de-b614-4c22-8753-0495fb58cb00\",\"review_text\":\"Not\"},{\"review_id\":\"8e9de94c-25dd-4481-bfb7-f44b30f515c6\",\"review_text\":\"Great\"},{\"review_id\":\"028a64a7-1917-401e-9068-ae44e2f09b6a\",\"review_text\":\"Nice songs\"}]}"
