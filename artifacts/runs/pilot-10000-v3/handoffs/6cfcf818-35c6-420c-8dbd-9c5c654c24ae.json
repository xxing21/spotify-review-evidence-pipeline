        "content": "{\"reviews\":[{\"review_id\":\"fd4bb9c6-ea8f-449e-8431-5e8c07a507d8\",\"review_text\":\"Love love Love Spotify\"},{\"review_id\":\"2ef16d48-e0b5-498d-a8d8-8f8ee7553be7\",\"review_text\":\"The only streaming app where you can't fast forward or rewind. The most basic thing ever for a streaming app. Shocking\"},{\"review_id\":\"26b12ee4-d554-4f43-92dd-ad29ac1a2343\",\"review_text\":\"Hate this app\"},{\"review_id\":\"0a32186a-4034-434e-96b6-d5ec7f6bbcc3\",\"review_text\":\"Best in class for streaming music imo\"},{\"review_id\":\"305c3fe1-109c-4f52-b7c4-5b95bb526035\",\"review_text\":\"Why am I paying for this? Unable to login, can not reach tech support. Looks like the account was hacked.\"},{\"review_id\":\"6fdd219c-5a24-4454-baaf-9f1358f617d4\",\"review_text\":\"get all gospel im searching for...\"},{\"review_id\":\"e6b09762-c548-4bd4-8fb1-1c65c49771e4\",\"review_text\":\"Amazing ☝️❤️💯\"},{\"review_id\":\"7fd63051-28ec-4e51-a06e-97f7010eae40\",\"review_text\":\"I uninstalled this app as a form of protest and boycott due to the fact that the Swedish Government allows the burning of the HOLY QUR'AN.\"},{\"review_id\":\"ae2e8bbc-49a5-4e88-a9b3-0432f7405274\",\"review_text\":\"Super all and nice all songs 😍I am daily use this app\"},{\"review_id\":\"c64801b6-65b5-4d00-b43c-1eff39dbdf33\",\"review_text\":\"Yall need to chill out on the advertisements yo. Seriously. I'm getting 8 - 12 advertisements every 2 songs!\"}]}"
