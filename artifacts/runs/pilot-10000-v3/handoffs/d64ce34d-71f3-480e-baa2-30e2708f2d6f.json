        "content": "{\"reviews\":[{\"review_id\":\"5fd7f94a-65a8-47b1-98ca-8fe673579798\",\"review_text\":\"I LOVE spotify. I would love to see a way to share music within the app.\"},{\"review_id\":\"2cef0924-bf5f-4448-9479-98866f36baaf\",\"review_text\":\"I love Spotify so much and it is also my favourite app because music is what makes me happy and Spotify just gives me that you have so many songs too choose from and the playlists they make for you are amaizing thanks too this app I know my real taste in music. These 5 stars that I gave are well deserved 👏🏻\"},{\"review_id\":\"1ca850b5-4a20-469a-8605-b018240b7b46\",\"review_text\":\"Very bad app😡\"},{\"review_id\":\"b394d2b4-7381-4ed9-98b9-3cf009311f3a\",\"review_text\":\"Always on top\"},{\"review_id\":\"2ce3e75e-f96a-41ca-8c6a-3c00432038bb\",\"review_text\":\"Too much ads\"},{\"review_id\":\"7f27bbab-ef19-4fb1-80d8-cd014da3e002\",\"review_text\":\"I HATE the new update , the app is also not showing lyrics and I also can't add songs to queue. Listening to music on Spotify is now a painful experience.\"},{\"review_id\":\"02415977-8057-46f8-8bc1-20806b6136ce\",\"review_text\":\"Ewww app 💔\"},{\"review_id\":\"fe3edac7-ef21-4c7d-94da-061c22596bae\",\"review_text\":\"Bad app.\"},{\"review_id\":\"d2259163-18e0-48ac-b7ce-bcc866702e6e\",\"review_text\":\"I like this app but after updating 😡\"},{\"review_id\":\"41c0c736-6617-466a-8e4d-3a2b551185e5\",\"review_text\":\"I had unsubscribed, and Spotify stole My money!!!\"}]}"
