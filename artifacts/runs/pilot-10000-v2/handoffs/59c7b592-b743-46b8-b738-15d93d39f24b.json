        "content": "{\"reviews\":[{\"review_id\":\"130f7c3e-fa6e-4a92-9563-07a3f9b58583\",\"review_text\":\"Overall good platform but too much add\"},{\"review_id\":\"4c30da62-2ea7-41eb-bca4-b9bb4c19b415\",\"review_text\":\"Recent updates are making it more worse. To listen in shuffle or skip parts, we need premium?? 😮‍💨\"},{\"review_id\":\"4cb6e8e1-659d-4af8-81fb-9b7320fe42f3\",\"review_text\":\"new update\"},{\"review_id\":\"42238e6d-798e-4800-ab36-92764f3cf786\",\"review_text\":\"Didn't queue songs\"},{\"review_id\":\"eb6f728e-8703-4ebf-8cc3-a0bcce4ba7d7\",\"review_text\":\"Now it has happened in Spotify that unless you buy premium, you will not be able to do anything, which is very bad.\"},{\"review_id\":\"e1199001-b1f5-49cf-b7a1-7bf59756b021\",\"review_text\":\"The best online music streaming app It just gives u what u want The app is amazing Its not a waste of data\"},{\"review_id\":\"9bb6d1da-4d31-4995-a7d9-ee6f6308f8e0\",\"review_text\":\"Best songs collection and UI\"},{\"review_id\":\"fb5a1140-3317-4ffb-849e-64a11384ad87\",\"review_text\":\"The music of Spotify is very good\"},{\"review_id\":\"fcda57bd-2592-46a2-8d3c-8d356c773fbc\",\"review_text\":\"Gooooooood\"},{\"review_id\":\"73b034cb-375d-4675-b6bf-78b8e220f7af\",\"review_text\":\"Loved the app but I absolutely hate the update! Also there are bugs running it, it stops at times.\"}]}"
