        "content": "{\"reviews\":[{\"review_id\":\"de1db735-bf17-4878-a5f8-5d13010ca784\",\"review_text\":\"Amazing content and quality\"},{\"review_id\":\"707ced2f-8abe-423a-ba16-6218d7b53d66\",\"review_text\":\"With premium it's very good music app\"},{\"review_id\":\"c848d654-d232-493d-b96e-4b3c6df24ed5\",\"review_text\":\"Very nice 🖤🖤\"},{\"review_id\":\"b3c12721-0641-4af4-b3c7-f586f4a5ae92\",\"review_text\":\"Apologise to Lisa, you dumbass app\"},{\"review_id\":\"4ce89317-d2a2-4aca-bb37-5b2c5994a7ec\",\"review_text\":\"Love it, but it sometimes stops my music\"},{\"review_id\":\"10357057-1b81-436b-b542-bb20aff3b6fe\",\"review_text\":\"Thik hi hai\"},{\"review_id\":\"e0287806-2797-434c-9db6-b186fbc59445\",\"review_text\":\"Love Spotify, all the music you could ever want! Easy to search and easy to get brand new music! 10/10\"},{\"review_id\":\"f56c4cf1-e30c-4a98-95f8-c327304870e4\",\"review_text\":\"Now every basic feature will come after you pay . Very good spotify.।Unistalled!!\"},{\"review_id\":\"7e962c4f-442b-44d8-8b6c-0a9661af9dc6\",\"review_text\":\"Due to new update\"},{\"review_id\":\"c3e72e97-ef7c-4156-a16f-982ca0fcf145\",\"review_text\":\"Love this app.\"}]}"
