        "content": "{\"reviews\":[{\"review_id\":\"790dfc60-b9af-4795-aee8-c9898da7010b\",\"review_text\":\"I get what I'm looking in music can't ask more than that. Thank you.\"},{\"review_id\":\"6e6ccbe9-e35b-4558-9920-388109dea79f\",\"review_text\":\"I can't scroll back to my favourite line of the song and every few minutes there are annoying ad pop ups\"},{\"review_id\":\"102624ae-3181-416c-9dc5-917adfbbbf8c\",\"review_text\":\"I hate this app due to sweedon occasion\"},{\"review_id\":\"9705c329-d7d7-45f8-a18b-a1140429525e\",\"review_text\":\"Just uninstalling this app cause off playing order premium feature not available for free users\"},{\"review_id\":\"a9e5050a-d6b8-419f-8cfe-ab92674ff277\",\"review_text\":\"I try to play my music and it plays other songs the songs I pick it plays the begin then stops\"},{\"review_id\":\"88807498-c3ba-4b39-b053-048b5fffddc5\",\"review_text\":\"My default app for Music and Podcasts. Especially if you have high/unlimited data or wifi.. content is always ready to stream, and very easy to find/play.\"},{\"review_id\":\"468e0f0c-fbdf-4b66-93b0-8c06ce661193\",\"review_text\":\"I hate this app😡🤬👎\"},{\"review_id\":\"b320b67b-ce70-4ed1-a19e-831987fa6194\",\"review_text\":\"6 skips per hour, cant add songs to queue, can't hear the previous song, can't even select a song to play.. Will just uninstall this app and hear songs in FM Radio..\"},{\"review_id\":\"161c41f7-96fd-49d8-b24f-3da1412179d4\",\"review_text\":\"Waste app don't use it\"},{\"review_id\":\"21b00189-1d05-4300-9ea5-6a1b68fb2aa1\",\"review_text\":\"That s amazing experiance adipoli what a miracle my eyes are filled with teras .\"}]}"
