        "content": "{\"reviews\":[{\"review_id\":\"2e5b8749-f82b-4fdc-8b07-bbfa8f9898c5\",\"review_text\":\"Khtam aap\"},{\"review_id\":\"03c7321b-1f5c-481c-b0b7-75ffeaa07390\",\"review_text\":\"is this after the update? why can't i play music\"},{\"review_id\":\"437ee927-2802-41fb-b3ab-fd27d6f98cda\",\"review_text\":\"Good App! Love it\"},{\"review_id\":\"8ef647ff-078b-435a-9515-e93387f43abb\",\"review_text\":\"Amazing app.. best 😌... But to many ads\"},{\"review_id\":\"2b651ab9-caf0-4471-a587-4db942270a80\",\"review_text\":\"I did have the app. with ads. But I don't mind because I find all the songs and artists I like.\"},{\"review_id\":\"c8b86948-cd8d-4d50-ad99-f7a9ac02a787\",\"review_text\":\"Love it. Let's me put together my own personal lists.\"},{\"review_id\":\"a7e98732-6fe0-403b-a488-75d598792159\",\"review_text\":\"The latest update screwed everything up. The songs will stop playing and I'll have to close to app and restart whatever song I was listening to. Just patch your terrible update, Spotify. You've got loads of money. Chop chop.\"},{\"review_id\":\"5d2b9bc2-cd2e-440b-baed-79078688a911\",\"review_text\":\"It's good but it always plays other songs than the ones I put and it also stops randomly.\"},{\"review_id\":\"fe7c7baf-cae4-479c-8120-89b73ba6a920\",\"review_text\":\"Very good app\"},{\"review_id\":\"539c68ae-e905-4d0f-bf96-40a54c1c3093\",\"review_text\":\"Good music quality, and almost every song is available\"}]}"
