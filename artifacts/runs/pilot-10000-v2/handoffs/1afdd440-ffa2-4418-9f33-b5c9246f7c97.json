        "content": "{\"reviews\":[{\"review_id\":\"e466daf2-e5c7-463e-86cc-9540bc65ba45\",\"review_text\":\"Good music and very clear sound\"},{\"review_id\":\"d4c8cee0-a8b3-4b20-b36d-12ee822e687b\",\"review_text\":\"Unable to control the PLAY BAR and can't turn off the shuffle. Please fix. Everything else is fine, but this is making it difficult to play songs.\"},{\"review_id\":\"ad177008-b218-4258-aec2-dd4a51e185b6\",\"review_text\":\"This app is amazing......😍\"},{\"review_id\":\"1bc04688-90b2-4f3d-ba7b-4d627481a91c\",\"review_text\":\"I love how you put emotion to it it macs me feel carmer\"},{\"review_id\":\"69140533-6c3f-418f-b235-e74114a415ba\",\"review_text\":\"It helps me to Y\"},{\"review_id\":\"ccc583df-58fa-47a0-821e-ba97677aec5d\",\"review_text\":\"Best place for podcasts\"},{\"review_id\":\"e3d35e71-56a8-4305-9ca1-abe4ca1c10ed\",\"review_text\":\"Broo i would give it 5 star but before it was sooo good there were like very few ads like nothing and now every two to three songs we get ads and i just clicked shuffle button by music and it ask me premium to turn off that button broo what it was by mistake why it happens to me\"},{\"review_id\":\"8d31f548-8329-44c9-b86c-2ddd387da72a\",\"review_text\":\"Very bad app i have done my OTP wrong ,so they say try with another number, if I have 1 number only so fixed this problem ok Spotify\"},{\"review_id\":\"d015d535-e94c-4200-a947-a2556a5aef9b\",\"review_text\":\"Awesome 👍💯💯\"},{\"review_id\":\"d85325a2-290d-46de-8efd-c14235e0f6d1\",\"review_text\":\"missing basic features, constantly badgering even paid users to upgrade plan\"}]}"
