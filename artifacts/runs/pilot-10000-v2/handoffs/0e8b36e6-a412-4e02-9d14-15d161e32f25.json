        "content": "{\"reviews\":[{\"review_id\":\"b4c2624c-522f-4030-94a6-08d1c3dba802\",\"review_text\":\"Excellent App\"},{\"review_id\":\"c98d7689-1203-473d-9ddd-e09207754e0e\",\"review_text\":\"I hate the shuffle and the premium thing\"},{\"review_id\":\"210d2718-b92e-46ed-90c6-58062c9c6e7b\",\"review_text\":\"This is A Best Music App in The World\"},{\"review_id\":\"c8468521-21af-4cf8-a29f-7590c15ab965\",\"review_text\":\"Because it is belong to Sweden\"},{\"review_id\":\"b76be87b-07db-4fbc-9fed-bfa14fe9bba6\",\"review_text\":\"I cant see the lyrics😭\"},{\"review_id\":\"15ff50dc-b813-40d5-90d7-e7a7f2426613\",\"review_text\":\"I can't log into my account even though I uninstalled it and reinstalled it. It still says something went wrong please try again\"},{\"review_id\":\"23685af6-de32-4187-91d8-9471fd69fc20\",\"review_text\":\"I am using Spotify for so long. But this time I am totally disappointed with this app as it removed the \\\"repeat\\\" option from it.\"},{\"review_id\":\"29a61cfb-d383-44d2-8df4-c7f7b83e14b0\",\"review_text\":\"Two thumbs up\"},{\"review_id\":\"8fee08ec-fa87-492b-8655-980fc18c2ef9\",\"review_text\":\"Loved the app, music quality is good and simple to sync with my other devices\"},{\"review_id\":\"a6f8dcfb-2a8d-4bec-b01a-d128187e4167\",\"review_text\":\"Ruined it for Indian users\"}]}"
