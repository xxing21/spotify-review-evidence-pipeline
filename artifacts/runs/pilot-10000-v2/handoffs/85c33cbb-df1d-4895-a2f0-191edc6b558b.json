        "content": "{\"reviews\":[{\"review_id\":\"9c0d95ab-4947-4c42-93af-e8fbad0f1a9f\",\"review_text\":\"Hope i can get premium for free,haha\"},{\"review_id\":\"fb230ede-c00e-4651-b62a-144c41ec80ea\",\"review_text\":\"This application not working my phone ISOO7\"},{\"review_id\":\"fe67c15c-b62d-4281-813d-3fba63c74685\",\"review_text\":\"The gift of music cannot properly be described in words. Thank you.\"},{\"review_id\":\"1d5d31e3-268b-4d58-9884-bd7d5cc5fa38\",\"review_text\":\"Very worst app.....the ads are annoying in the middle of song...also no regional songs like we get in YouTube....we are forced to listen what are available and difficult to search favourite songs, some times not available my favourite songs.....I don't know how oppo provide in-built service this app.......very disappointed.....\"},{\"review_id\":\"56790f15-cdca-445c-b991-60637037cc9a\",\"review_text\":\"Their recommended music has suggested some hits.\"},{\"review_id\":\"9e4866db-f965-4833-9ebc-7adca40abde4\",\"review_text\":\"Updates 📉📉\"},{\"review_id\":\"5e4aec75-ed5b-400b-9bb7-d3dfa132ef96\",\"review_text\":\"Love the app best music app there is.\"},{\"review_id\":\"ae9dd3a4-4983-4193-ae4f-f5c7c96c93ba\",\"review_text\":\"Why can't we download music\"},{\"review_id\":\"8fe183d0-b907-41e7-918b-8a46112e8cec\",\"review_text\":\"It doesn't have many folders and gaana is better.. It's more comfy without premium also\"},{\"review_id\":\"1aab3d6e-c9cc-4e7b-ad36-60b6ad74012c\",\"review_text\":\"Best music app since Pandora! \\\"Best thing since sliced bread!!\\\" 🫶😉\"}]}"
