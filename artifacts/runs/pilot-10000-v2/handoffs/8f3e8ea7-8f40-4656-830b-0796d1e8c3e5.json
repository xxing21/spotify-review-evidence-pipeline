        "content": "{\"reviews\":[{\"review_id\":\"4be3ef16-b7fb-4f36-9ffa-5fdc91a87bd2\",\"review_text\":\"Hay ne tera cocak\"},{\"review_id\":\"834f4606-9732-4988-a75e-1bc4f41d8718\",\"review_text\":\"Hello good\"},{\"review_id\":\"5cb8dac0-d90b-4c15-9784-1abe89dbd5b6\",\"review_text\":\"Excellent sound quality. Need to add a downloading option\"},{\"review_id\":\"8197eac1-b915-40ea-b3c8-3b73059073b0\",\"review_text\":\"Greed company trying to milk for money. Pathetic. Most basic features of any music player is totally messed up and paid. Don't know which management jok...r sitting in the decision making for Spotify took these steps to make the most basic features paid. Will be quitting from Spotify shortly\"},{\"review_id\":\"cb680f4d-8f80-4441-a1df-9883a86224c4\",\"review_text\":\"Worst music appp\"},{\"review_id\":\"3589bc06-7835-4e12-a853-f42107c62743\",\"review_text\":\"Excellent 😍\"},{\"review_id\":\"f067499e-63fc-4d85-88cf-8551c720e3af\",\"review_text\":\"I love love Spotify! I use it everyday. I can listen to my favorite artists from across the decades, every possible genre. For me, paying for the ad free version is well worth it. Thank you Spotify for keeping me going, on the go and everywhere!\"},{\"review_id\":\"bf3f0ecf-4e28-46af-b4d9-18e4ca99b1aa\",\"review_text\":\"Ban karo\"},{\"review_id\":\"3accd623-1830-4719-9e44-19da4e54755f\",\"review_text\":\"NICE\"},{\"review_id\":\"26e8e7d1-69ae-4a74-b86d-3c1a81ebc93e\",\"review_text\":\"Very Bad app\"}]}"
