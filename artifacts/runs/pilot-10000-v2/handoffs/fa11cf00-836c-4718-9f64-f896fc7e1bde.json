        "content": "{\"reviews\":[{\"review_id\":\"7d6995dd-f4be-4746-ad2d-25d592c41f5b\",\"review_text\":\"This is the worst app in the universe 🤬\"},{\"review_id\":\"2b2f2682-9f65-4267-8161-66aad3465039\",\"review_text\":\"Great music listening service. But You sould update with a way to show what button do what in when you listen to the first ever song\"},{\"review_id\":\"8766e6e2-3dbe-4374-b0e6-13adf11fc73b\",\"review_text\":\"Best music app👌👌👌\"},{\"review_id\":\"caf467b5-4894-42e8-8968-5dbe9a65311e\",\"review_text\":\"Very interesting and resource ful\"},{\"review_id\":\"472ac25f-ca42-48ab-9462-844a71e28a48\",\"review_text\":\"some issue but ok 👌 nice app\"},{\"review_id\":\"ed925c9a-7e41-45d9-89da-6941da7bdb16\",\"review_text\":\"I like being able to listen to radio stations on my phone.\"},{\"review_id\":\"e69d5692-05bc-4304-b911-53cacb7c7469\",\"review_text\":\"I am using Spotify for past few years and the sudden premium updates are just useless . Plz work on it I like to play my songs in order and not in shuffle mode .\"},{\"review_id\":\"dddbeb33-e334-46c0-bd34-24ab51252d57\",\"review_text\":\"It's a good App.\"},{\"review_id\":\"5eee18a2-a385-404f-b56e-13a0bd199096\",\"review_text\":\"💯%EXCELLECT THANKS BUT I DON'T LIKE THE APPS WHEN LISTENING TO ALBUMS I WANT TO ENJOY WHEN BUSY PLAYING RELAXING MUSIC IVE GOT EPILEPSY AND I SUFFER WITH STRESS AND ANXIETY AND WOULD LIKE YOU TO GET RID OF THE SAME ADVERTS PLEASE THAT REPEAT\"},{\"review_id\":\"655864e2-312a-4149-a25d-9a64c9ffe5d5\",\"review_text\":\"🗿🗿💥💥\"}]}"
