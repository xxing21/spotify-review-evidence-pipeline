        "content": "{\"reviews\":[{\"review_id\":\"9ffed4b6-9792-4d02-b7b6-0ee649ad2bc1\",\"review_text\":\"💞🍀\"},{\"review_id\":\"b5876eb3-6f99-419a-9569-999a185c6253\",\"review_text\":\"I absolutely love this app. Never had any issues.\"},{\"review_id\":\"3848ce29-61df-4a4a-b663-4542364daca7\",\"review_text\":\"ALLAH is the greatest\"},{\"review_id\":\"008ac3ab-c67d-4e21-bd6a-d36f8eced01d\",\"review_text\":\"Much reliable and descreet\"},{\"review_id\":\"bcc085de-f5e1-4d7d-8c47-416d66594516\",\"review_text\":\"Worst application. Why do we need pay for seeking. They are just greedy. Shutdown spotify. Bad experience.\"},{\"review_id\":\"b90dbe13-789b-40ca-bdf3-19bc56ea6006\",\"review_text\":\"I would like the hottest 🎶 out ▶️ now\"},{\"review_id\":\"9f02ee7c-5268-4781-849e-30dbe6bad0e0\",\"review_text\":\"Everything I wanted.\"},{\"review_id\":\"63c2a96c-f601-4e00-84a0-f184c20c46c1\",\"review_text\":\"Best app for music there is.!\"},{\"review_id\":\"c86e4902-5560-47a7-85d6-43f33e96646c\",\"review_text\":\"It's very good\"},{\"review_id\":\"24422da5-4cc0-43a7-a5af-daa373f23a2d\",\"review_text\":\"Since the new update the Widget doesn't work anymore. Any idea how to fix that?\"}]}"
