        "content": "{\"reviews\":[{\"review_id\":\"33b7811d-9853-40e4-81e0-8d0203610b90\",\"review_text\":\"Not working as it should on Samsung S22+\"},{\"review_id\":\"06849454-825a-4ab1-bf54-d8387a35c00c\",\"review_text\":\"Nice.app\"},{\"review_id\":\"c07de738-cb30-4c4c-85e4-b78117d85e55\",\"review_text\":\"Playlists are constantly bugging. Media just stops playing for no reason.\"},{\"review_id\":\"953d28e9-8c29-4f72-b855-a84fe3185601\",\"review_text\":\"Nice application for listening to music and podcast\"},{\"review_id\":\"01e3ea08-f21d-4c7e-bc02-5cce2b546e1f\",\"review_text\":\"Good app but lacks content like the Now That's What I Call Music 64 from 2017\"},{\"review_id\":\"9e8f4310-9ed0-4565-966c-cb2e2a708133\",\"review_text\":\"Very frustrating to sign up. This app is trash\"},{\"review_id\":\"7a23b108-8e7c-4ae8-885e-0e82711289d5\",\"review_text\":\"It's very nice\"},{\"review_id\":\"6eeea4ac-cd39-48cc-a7a6-c0aff184cd6e\",\"review_text\":\"What a good App\"},{\"review_id\":\"176f0c71-f4ed-4b6d-82b5-fe19ee179e85\",\"review_text\":\"It is a very good app to use, but it gives too many ads\"},{\"review_id\":\"b01dbec6-0fd8-4b86-ad51-b95c79f57f1f\",\"review_text\":\"Best Music App.. Music quality:- Excellent Collection:- Mind Blowing\"}]}"
