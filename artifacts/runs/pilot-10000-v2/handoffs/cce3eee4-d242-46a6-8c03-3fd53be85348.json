        "content": "{\"reviews\":[{\"review_id\":\"a2136b4c-e5ac-47e3-a1ea-20235a6905d4\",\"review_text\":\"Ethiopian music 2021\"},{\"review_id\":\"645f5455-2668-43eb-8e11-2a5703dd8eb8\",\"review_text\":\"This app was great a fews days back. But now this shuffle option is irritating me. Why are you giving unwanted updates\"},{\"review_id\":\"78bdaa56-167b-4647-bb9c-476b3ec97e6f\",\"review_text\":\"Hate this app, veru bad experience\"},{\"review_id\":\"737405a9-40c5-4b9f-a97c-d470fb63e6d5\",\"review_text\":\"Kept saying something was wrong with my connection when there wasn't. Did not let me play any of my playlists. Still has Joe Rogan.\"},{\"review_id\":\"c39e04d0-e0ac-4796-95e2-2952d1b75eea\",\"review_text\":\"Very good and nice song app\"},{\"review_id\":\"7b72def1-ea4d-4d77-a1a4-4d54f4e7885b\",\"review_text\":\"Brilliant.. no other word to explain it\"},{\"review_id\":\"7eb65af9-bb71-4b3c-a111-d0794fa2eaa3\",\"review_text\":\"👍 it's nice\"},{\"review_id\":\"74d4c820-f915-406e-bfec-e837d2e4796f\",\"review_text\":\"always needed subscription to listen songs cheerfully. ads are very annoying\"},{\"review_id\":\"6b0b1526-49e0-4e1b-b17d-aa23b6684617\",\"review_text\":\"This app is amazing I love it it makes my day better every day I love it my life is much better now I can play music ever day can no one cares I don't care about YouTube I love this app.😃😃😃😃😃😃 Frome hannah♥️🤓\"},{\"review_id\":\"5936fbf7-8858-48f8-b4ee-173a0eaa186b\",\"review_text\":\"Can play all types of music while I do many things\"}]}"
