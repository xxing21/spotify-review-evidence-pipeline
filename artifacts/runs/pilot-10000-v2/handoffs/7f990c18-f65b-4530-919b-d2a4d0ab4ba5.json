        "content": "{\"reviews\":[{\"review_id\":\"d8f522ad-298b-4145-bc36-3108ce108196\",\"review_text\":\"Amazing 👏 recommend this app with the premium feature\"},{\"review_id\":\"fec751ae-e02a-43b1-bd56-be139c3b9f05\",\"review_text\":\"es it is nice app and phalanx dimkana\"},{\"review_id\":\"b1064d9e-630e-42e5-91d5-f8d42b56545f\",\"review_text\":\"It's quite but there's no option to set any song as caller tune\"},{\"review_id\":\"c6fed5dd-dc06-4aef-8f82-e71fb3d99f7a\",\"review_text\":\"You chiter bro\"},{\"review_id\":\"0c2fea5b-4663-43fa-a767-76425f32c47d\",\"review_text\":\"I'm in premium plan but I can listen to music when I was offline\"},{\"review_id\":\"94001edb-756e-4081-838a-31731d1273e5\",\"review_text\":\"I hate this app so much\"},{\"review_id\":\"98877753-8a45-4526-a9d9-07224ddea392\",\"review_text\":\"So easy to access. Educational and entertaining.\"},{\"review_id\":\"94133e78-e1ac-4188-8adc-543674832f7d\",\"review_text\":\"Its great.\"},{\"review_id\":\"772bcf66-f425-4e1c-997f-e3080e9f75c2\",\"review_text\":\"I love it and I can listen to any song I want\"},{\"review_id\":\"44b08972-d31e-40be-af3f-03d8589c54b5\",\"review_text\":\"I listen to music on a couple different apps but Spotify really dives into the artist I want, when I click on the artist I want to listen to they give me an entire Playlist on that one artist and I enjoy it, I also enjoy creating my own Playlist and Spotify even recommends songs that are similar to the ones in my Playlist.\"}]}"
