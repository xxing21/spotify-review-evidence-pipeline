        "content": "{\"reviews\":[{\"review_id\":\"5e684c2d-8830-4d24-921e-dec2e45c2e38\",\"review_text\":\"Every 10 listen songs than after add 😩\"},{\"review_id\":\"afd1d521-d065-460f-9f49-c0db2fd74b1d\",\"review_text\":\"Love\"},{\"review_id\":\"d0cedf5b-d956-472b-9a31-c1adc5b71229\",\"review_text\":\"Obvious five stars just the best music streaming service out there\"},{\"review_id\":\"0b7a1d03-3029-4847-b5f7-1eea65cd2b8f\",\"review_text\":\"besides the ads is the best but it's getting to a point where there are just too many ads I usually get double 30 second ads after every song which is like 3 minutes max\"},{\"review_id\":\"b5e821de-bae7-4ab0-b04f-2b5f35083575\",\"review_text\":\"Few things in life make me as happy as Spotify ad free.\"},{\"review_id\":\"5713a5fe-fabe-47b9-96ab-15d61f0514a1\",\"review_text\":\"It is very good app\"},{\"review_id\":\"64744fe4-3984-47a1-b845-247047f2a0e5\",\"review_text\":\"I love my Spotify, would recommend to anyone\"},{\"review_id\":\"f9dd2c8b-87f1-4ff5-9739-a44f02b45184\",\"review_text\":\"Idk why its was working fine till earlier it's stop playing music and when I try to play anything it so I had try to Uninstalled it and work fine for a min than it stop playing again idk what the problem is\"},{\"review_id\":\"ad4239ff-44e7-44f5-bfee-ccb7c0f14168\",\"review_text\":\"Spotify is very customized and I enjoy the mixed for me playlists:-)\"},{\"review_id\":\"eeb65892-8136-4a57-9ea5-720c0dcea6db\",\"review_text\":\"Immaculate\"}]}"
