        "content": "{\"reviews\":[{\"review_id\":\"609e04c3-66fe-4b7e-9026-bfd52393d90f\",\"review_text\":\"🎧\"},{\"review_id\":\"667819f6-399a-42f4-8df9-b2c74c60649b\",\"review_text\":\"I love how I can listen to anything on this app like Black pink, BTS, Twice, Arianna Grande, Red Velvet Doja Cat, Dezzy Hollow, Jack Harlow and so many more all I have to say is love it so much KEEP UP THE WORK\"},{\"review_id\":\"d4ecc1ad-dc99-4984-b315-41c112e385d2\",\"review_text\":\"With the new updates, Spotify works like a charm.\"},{\"review_id\":\"410fc23d-ee6a-478d-9f32-654185f3adeb\",\"review_text\":\"It \\\"was\\\"the best app....but rn after the updation the option for replay had gone..at first we could touch the lyrics and play those lines but now its not available and we could not also move the song...what is wrng with it?Do anyone have the same probelms??\"},{\"review_id\":\"9c8bf672-bd22-4caf-b8b0-7682246e86ee\",\"review_text\":\"Worse than before\"},{\"review_id\":\"27015f8a-07d8-44d3-8498-b8c02d806b52\",\"review_text\":\"Very bad experience It's just like aa dogs wasteage\"},{\"review_id\":\"55427b61-792d-4eac-a71a-76b4a272f2c1\",\"review_text\":\"Boom tings\"},{\"review_id\":\"6355a633-4892-4abc-9b6d-85ce2251879e\",\"review_text\":\"Every thing is good but adds not good\"},{\"review_id\":\"ba7e1d57-68e1-4a5d-94a3-a4ae3149c044\",\"review_text\":\"Xxx video lao\"},{\"review_id\":\"6e74969d-45d5-4336-bf33-2306337a6dd0\",\"review_text\":\"Very bad app 👎\"}]}"
