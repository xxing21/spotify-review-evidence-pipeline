        "content": "{\"reviews\":[{\"review_id\":\"a00c4ed2-8574-48e1-836d-4412433a0c4d\",\"review_text\":\"It WAS a best one.. Now it is a Worst one\"},{\"review_id\":\"d157c425-9510-4243-a935-e8c7899f172c\",\"review_text\":\"Why does it add songs to my playlist if I don't want them and why can't I just play any song any time. Also too many adds\"},{\"review_id\":\"b242ef2b-a98c-41da-a84d-bc593ecbe5bf\",\"review_text\":\"Very good...\"},{\"review_id\":\"d5ef25cd-ae8b-4da3-a33e-612728d4b07c\",\"review_text\":\"Stop auto playing music when I open the app. You're a music app, not TikTok.\"},{\"review_id\":\"57066953-9ae5-4382-b6b9-af1fff401132\",\"review_text\":\"I really love it but i had to want six hours fir skips\"},{\"review_id\":\"79730899-a0a1-402f-89bd-3ffdcf236898\",\"review_text\":\"It's just good. Never had any problems with it, I use it 24/7.\"},{\"review_id\":\"080a39a5-a4d2-4088-8c71-5af80560d889\",\"review_text\":\"I've had spotify for years I love this app I have no complaints, they literally walk on water\"},{\"review_id\":\"9772a6f1-81c4-401f-823b-1d17d09184c5\",\"review_text\":\"Apparently the app doesn't work everywhere very FRUSTRATING\"},{\"review_id\":\"a39fda06-0325-4927-8775-85dd98922d22\",\"review_text\":\"Suggest some more song as per their interests\"},{\"review_id\":\"d1407f3f-e021-4e74-8714-5aaba7fe5867\",\"review_text\":\"Worst service update🤮🤮, i Uninstall Spotify...\"}]}"
