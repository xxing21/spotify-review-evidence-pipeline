        "content": "{\"reviews\":[{\"review_id\":\"c3a26471-eedb-4ee6-876a-4e8e133d67b8\",\"review_text\":\"Does this app ever work? updated 11/2023.. like seriously does it ever?\"},{\"review_id\":\"12c34d9b-a093-4ff1-a4e0-f6b855ec5313\",\"review_text\":\"I hate this app i love 🇮🇳india\"},{\"review_id\":\"e58b3fd4-c4ed-4b0a-aa8f-9a42367969f4\",\"review_text\":\"They just want money\"},{\"review_id\":\"6dd6fca7-f224-4762-b3e5-54408427d8a7\",\"review_text\":\"Good app want to see Jape's song\"},{\"review_id\":\"8cf70f3f-cbe6-4fd1-b97b-e160950e16be\",\"review_text\":\"It always crashing down; unable to play and just stop working everytime I use it\"},{\"review_id\":\"7142ad2b-7178-4353-aa39-1393bfd2cda1\",\"review_text\":\"THE worst app. first my account automatically Log out and then all my favourite songs are gone. I update this app but still nothing. And I'm also uninstalling this. 😤😤😤😤😤\"},{\"review_id\":\"fca9706f-ff17-4c5c-ad62-4de6eb54fe92\",\"review_text\":\"The variety of music available is amazing, however an option for most listened to music should be availed\"},{\"review_id\":\"d5d18196-7a49-4d7e-8ded-9cdf0c074514\",\"review_text\":\"You have only 1 work to play music and that also you can't do properly worst app😡\"},{\"review_id\":\"58297e3a-f0e3-41c3-ab0f-aa593946c169\",\"review_text\":\"Reasonable\"},{\"review_id\":\"e500fc0e-0e04-4b70-b3f3-eae96cac424f\",\"review_text\":\"Smooth\"}]}"
