        "content": "{\"reviews\":[{\"review_id\":\"95ce996c-7e37-41dd-86f0-e1af4a5406a3\",\"review_text\":\"Its very good to use\"},{\"review_id\":\"5e2ca53d-1b9a-4274-9cd7-2baf5eff4ecd\",\"review_text\":\"App is good i recommend it to all music lovers 🤩\"},{\"review_id\":\"4a5d01bc-75d1-4c87-9eb3-b05d0c3b04c7\",\"review_text\":\"It's a great nice app but I wish you could be able to download music in this app\"},{\"review_id\":\"cc2c7156-7595-405c-bd58-f983ebad3322\",\"review_text\":\"Very good app though it is slow when loading at times\"},{\"review_id\":\"ddda2e20-5b6a-4d2b-9e85-2bdbe91a163f\",\"review_text\":\"Love 😍 this app\"},{\"review_id\":\"e1b961e5-668c-47b2-96eb-67998c29341a\",\"review_text\":\"Very happy with the 60-70-80s music\"},{\"review_id\":\"334faaae-93e0-47dc-84eb-1f063299c3d5\",\"review_text\":\"I love how you can put the songs on ➿\"},{\"review_id\":\"2dfd7ba9-6013-45d4-acb1-16127da298c3\",\"review_text\":\"I HATE SWEEN\"},{\"review_id\":\"3299edb3-7e0c-48a3-a9f3-a071e52c67f1\",\"review_text\":\"I love this playlist\"},{\"review_id\":\"819d74a8-45c5-4260-afde-72cb2cd1f876\",\"review_text\":\"I'm using this app for More than 3 years but the “New update“, you guys removed all features. I don't like it . Please make the features free . Those 3 features I needed it the most . And the lyrics tooo Please......... It's my fav music app .\"}]}"
