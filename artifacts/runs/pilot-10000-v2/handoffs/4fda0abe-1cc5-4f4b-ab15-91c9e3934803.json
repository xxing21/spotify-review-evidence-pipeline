        "content": "{\"reviews\":[{\"review_id\":\"91f49c48-ed57-4520-bcbd-49b523b9e734\",\"review_text\":\"I'm Very disappointed by this app now because of the new feature where you will have to buy the premium to access the lyrics that's no good the old spotify was good atleast we didn't have to pay for lyrics!!\"},{\"review_id\":\"80572ed3-e692-4243-9fa6-597de8b6e812\",\"review_text\":\"Works well and has good play lists.\"},{\"review_id\":\"ea974272-69ef-4cec-967e-e0bb4347a4ac\",\"review_text\":\"NO ADDS\"},{\"review_id\":\"8fdffd8b-7bbb-4e8c-bc77-2a69c6064ef3\",\"review_text\":\"Incredible\"},{\"review_id\":\"ae41282d-03b4-45f0-87d0-4620204e35c3\",\"review_text\":\"This app is good but not so good as resso app. That app is very usefull and you all must try resso app\"},{\"review_id\":\"3a39e8ac-a51f-4d4a-840c-18c60259c88d\",\"review_text\":\"I dont like\"},{\"review_id\":\"b1f6fbe5-73d0-4c20-84e7-a7012acc1aff\",\"review_text\":\"Love my toby Keith music especially peso In my pocket\"},{\"review_id\":\"8f123443-3dd7-4378-a560-29cd11e517eb\",\"review_text\":\"Sensational\"},{\"review_id\":\"6c77ddfb-ba00-493a-a5ea-84c3643b4231\",\"review_text\":\"Brilliant 👍\"},{\"review_id\":\"53439ca2-0594-4fb8-bab2-1f3155dec29c\",\"review_text\":\"Great Music App\"}]}"
