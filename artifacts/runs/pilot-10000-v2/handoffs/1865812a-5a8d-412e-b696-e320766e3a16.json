        "content": "{\"reviews\":[{\"review_id\":\"1c115a68-2c92-488f-bbfb-28c28fa4bd94\",\"review_text\":\"The only problem is that you can't download any song, until you subscribe\"},{\"review_id\":\"9f68c228-5c94-4771-b0a6-4f930b718d87\",\"review_text\":\"Great app..Love it!\"},{\"review_id\":\"a034f726-05c3-4256-a271-89fc981b69f4\",\"review_text\":\"Nice 👍👍\"},{\"review_id\":\"52534888-c748-4c0f-9295-aa0172583e59\",\"review_text\":\"It's a very very very very good app\"},{\"review_id\":\"8f778945-b454-4b9c-98b2-f473f58b0ed9\",\"review_text\":\"the best oldies and new\"},{\"review_id\":\"006b8080-637f-497f-893a-e8b2e44f1a0c\",\"review_text\":\"Worst app , having bug every 7-8 days Can't search song showing no network connection even after having good network speed\"},{\"review_id\":\"0a55a92f-770b-4ba4-b628-be660982ae01\",\"review_text\":\"The free app version of this is absolute dog water I do not recommend... I've been listening to ads more than I've been listening to music\"},{\"review_id\":\"e7c4ea6b-a423-4edc-8e29-ddad5cba67dc\",\"review_text\":\"I hate sowdon\"},{\"review_id\":\"6d4d525d-29cf-4c5c-804d-1405d7b44b47\",\"review_text\":\"👍 👍 👍 👍 👍\"},{\"review_id\":\"c48bc8aa-be23-4f41-a9d6-efdac22ac0e8\",\"review_text\":\"I wish I could give it a negative 5 stars cause this app is really a big failure...u can't even use another app while ur listening to songs and it not cause of my phone cause the quality of my phone is high enough to display over other apps but it ain't\"}]}"
