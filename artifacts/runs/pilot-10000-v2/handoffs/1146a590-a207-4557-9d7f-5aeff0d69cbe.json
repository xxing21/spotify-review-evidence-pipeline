        "content": "{\"reviews\":[{\"review_id\":\"256155ff-39a2-4a16-846f-fa1c5b14cef0\",\"review_text\":\"Just one think i have to say I download this app for listening podcast of rj vashisth its amazing\"},{\"review_id\":\"ee0a7f78-cb57-4f2b-9683-b9ccc5328214\",\"review_text\":\"The safety pause when running Android auto is the most annoying thing ever and distracts me even more. It's also very annoying if your passenger is the one trying to control it.\"},{\"review_id\":\"16e8e2fc-df00-489e-b11d-e609e330adf5\",\"review_text\":\"Hate this application 😠😠👎👎👎👎\"},{\"review_id\":\"153063a6-6c9d-41f9-ad3a-b8608d210761\",\"review_text\":\"very bad can't even adjust the music\"},{\"review_id\":\"c91c48db-4d4b-4e40-8c2e-71d49fdb6aaf\",\"review_text\":\"So far Spotify treated me so good I've got no complaints\"},{\"review_id\":\"6b41d735-0ddc-43c2-8670-c7a991f610ac\",\"review_text\":\"It's just awesome\"},{\"review_id\":\"f2396a84-f196-46d4-9121-7942f504eeb7\",\"review_text\":\"Interesting\"},{\"review_id\":\"1d9f5a41-72d6-4886-aa7b-66139a1b2e46\",\"review_text\":\"Can't login to my phone because spotify also installed on my tab using same email id. Try to login many time with mobile number, but still unable to use app.\"},{\"review_id\":\"2b3e455b-590d-4a4a-b352-48dfa8c4dd51\",\"review_text\":\"Excelente\"},{\"review_id\":\"850b91b1-e838-4461-9843-f9aec878bcaf\",\"review_text\":\"Music is my life!!!!\"}]}"
