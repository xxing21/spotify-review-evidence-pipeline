        "content": "{\"reviews\":[{\"review_id\":\"14f2ea31-7290-4aa9-861d-bb60bcba652f\",\"review_text\":\"Very disappointed app\"},{\"review_id\":\"bb819134-2cb3-4e4d-ae3c-a4c3882db308\",\"review_text\":\"There isn't a way to stop this junk app from playing from the queue. I'm trying to play a playlist and the queue keeps interrupting\"},{\"review_id\":\"492a7b2c-c6c9-4260-96ee-c8201c9dfefa\",\"review_text\":\"when i want to open the song i want to listen it doesn't let me listen to it and it plays another song .. That's why i give 2 star\"},{\"review_id\":\"d053f6d4-73fa-4956-b6bf-81debdef1544\",\"review_text\":\"You guys are the best\"},{\"review_id\":\"d446a9e7-d966-49bc-9b87-17cfb38a3b01\",\"review_text\":\"Good app Better clarity\"},{\"review_id\":\"ebae8b22-1b4f-4103-912f-3b255d2444d3\",\"review_text\":\"Great mix of music easy to use.\"},{\"review_id\":\"b5379880-6ef0-4231-956b-88f95ca6b878\",\"review_text\":\"Hate this app v bad this App.\"},{\"review_id\":\"64d17619-90eb-4a46-93d4-7f203ddcb5c1\",\"review_text\":\"Very good. App!!!\"},{\"review_id\":\"99fd2405-086a-46f2-adc4-036dae8cf434\",\"review_text\":\"Pay premium to scroll through the song...? Cheap one, Spotify.\"},{\"review_id\":\"f1505de0-6350-4751-8eb6-3f632bc0e8de\",\"review_text\":\"Spotify use to be my favorite app but now I hate this app it's update version is so worst\"}]}"
