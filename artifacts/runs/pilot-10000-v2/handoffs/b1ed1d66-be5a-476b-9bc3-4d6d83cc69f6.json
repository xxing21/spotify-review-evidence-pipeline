        "content": "{\"reviews\":[{\"review_id\":\"4a311a70-d9a5-482b-8c3f-c95eb9b49d5c\",\"review_text\":\"Hate the application 🇵🇰\"},{\"review_id\":\"eda8d062-34e7-49c8-b6a1-a5bc827e097b\",\"review_text\":\"All music available in one platform..amazing\"},{\"review_id\":\"d37e36bc-7d40-4466-96d7-ad82d6a2f20e\",\"review_text\":\"I'm using the premium version but disappointed on Spotify's actions with the free user . Dude you are already not paying the so much. taking all their money . And now you want do it to your consumers?. Just give ads and stop block restrictions. Also you don't even give high quality audio to the premium users you only offer ad free plus downloading feature\"},{\"review_id\":\"888550cd-a479-4468-b02a-2842325557d2\",\"review_text\":\"The only app thats worth it for a monthly subscription.\"},{\"review_id\":\"1c110729-1580-4a2c-b7f6-f6d454de71a7\",\"review_text\":\"This app is very best and use this app from three month\"},{\"review_id\":\"73f863db-a23e-4ebb-9195-9b4fd5967bf2\",\"review_text\":\"Cada día se me hace más difícil abrir la app. No quiere comenzar, se queda en negro\"},{\"review_id\":\"6da164b9-bf3e-437a-afa8-c6ad82fe8ea5\",\"review_text\":\"It's Beautiful place music 🎶🎵 lover's\"},{\"review_id\":\"7977e379-f5f7-4171-924d-57107c347171\",\"review_text\":\"I love this app ❤️😊\"},{\"review_id\":\"8680c7ea-d1b4-4dcb-b5c8-d212a80fe5dc\",\"review_text\":\"🤢🤢🤢🤮🤮🤮\"},{\"review_id\":\"2fe96a96-978f-4502-a17e-2c7ac8999cd5\",\"review_text\":\"I love Spotify its the best!\"}]}"
