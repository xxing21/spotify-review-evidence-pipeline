        "content": "{\"reviews\":[{\"review_id\":\"9388609e-28c2-4b4d-8097-c9c4d5028322\",\"review_text\":\"Worst app now because u can't play a song twice a day... They asked for money so friend delete this app\"},{\"review_id\":\"b9f5cbdc-8a0c-46e5-b9fe-321e01f3d8d1\",\"review_text\":\"The new home page is awful. It auto plays every time you open the app and daily mixes are now impossible to find\"},{\"review_id\":\"f6092df1-ddef-41c1-99d5-bf29f822a27c\",\"review_text\":\"When i try to put a song it plays another song....fix this spotify\"},{\"review_id\":\"0242e2de-e96b-4983-9afc-094ebdec12b9\",\"review_text\":\"4 ads in 3 songs. Puck it! 😠\"},{\"review_id\":\"4981c5ad-6889-4388-a138-d057e638fcca\",\"review_text\":\"Seek bar not working 😕\"},{\"review_id\":\"f8b49233-2071-4c98-86d0-4b91129c3544\",\"review_text\":\"Love to make my playlist and life that it's updated me on everything\"},{\"review_id\":\"1e352786-c3e2-4fa4-a003-43943d948d1a\",\"review_text\":\"won't play a song without \\\"premium\\\" but this didn't happen on my Realme device.\"},{\"review_id\":\"f3ef3ead-e5ae-4e59-9e87-eef9d9cd8cc0\",\"review_text\":\"I all ways listen to music and it let's me to save Nd make playlists\"},{\"review_id\":\"4feb75fc-4456-4279-b54c-d7c4f60e9b40\",\"review_text\":\"The best app for listening to your favourite songs.\"},{\"review_id\":\"c31d996e-26f7-43bc-812f-4389416cbd9e\",\"review_text\":\"I'd give 5 stars if didn't stop every 10 minutes.. it's really frustrating\"}]}"
