        "content": "{\"reviews\":[{\"review_id\":\"51c4e541-1410-4816-b7e8-e87efaa1e34b\",\"review_text\":\"Dope app! And always looking out for the ppl! Apple music could NEVER\"},{\"review_id\":\"8342b610-694f-4ad7-8cba-723dadb29ac6\",\"review_text\":\"Just hate\"},{\"review_id\":\"c79477ca-e67c-46e9-9200-b46a9df05da4\",\"review_text\":\"Verry good\"},{\"review_id\":\"dbdff141-fcaa-45c5-9d78-0acd75b12dab\",\"review_text\":\"It's very nice app but please DON'T GIVE ADDS🙏🏻😠😤\"},{\"review_id\":\"b406cddb-f0fd-44f6-a26c-66c8e2dda360\",\"review_text\":\"For a premium music app this one sucks. Constant crashes and stopping in the middle of songs, makes me think of switching back to Amazon. Fix the app!!\"},{\"review_id\":\"a5b0a726-90e6-4e4f-b8a8-8af367a88492\",\"review_text\":\"new update is worse\"},{\"review_id\":\"a0e50ac1-1728-4a56-af7c-2ebaad26d0f1\",\"review_text\":\"Welcome to music...and playability,...not radio...\"},{\"review_id\":\"72aa67a1-5930-44a3-a8ea-f84fe804184f\",\"review_text\":\"the ads are too long like 2-3 minutes but skips aren't in a limit anymore so thats good\"},{\"review_id\":\"2418fce8-7483-4233-92a7-f36078472d12\",\"review_text\":\"I love this app I can hear to bts songs🎧🎵, hurray! And this is jst awesome for all, but especially for armys 💜💜💜🥰❤\"},{\"review_id\":\"60ef39a1-7e80-430a-afae-e020ab29a840\",\"review_text\":\"Hate this application👎👎👎👎👎👎👎\"}]}"
