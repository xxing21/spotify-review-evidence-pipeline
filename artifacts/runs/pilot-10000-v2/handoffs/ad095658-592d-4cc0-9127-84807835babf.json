        "content": "{\"reviews\":[{\"review_id\":\"4c81966d-52c5-46b9-b10f-b6b086ac52ca\",\"review_text\":\"Works good\"},{\"review_id\":\"6106dfdd-618e-4da6-b4e4-2212a1626d20\",\"review_text\":\"Spotify became worst after upate i can't even stop shuffle without purchasing premium\"},{\"review_id\":\"9332c84a-5acd-4614-aaf7-781fdc73d840\",\"review_text\":\"I was usually very interested in this app. But I HV noticed that adds the popping so much. I had installed this app BCS before it had rare ads.. lyrics also got disappeared. Very disappointed Spotify team... Unistalling the app I had also told my friends to do so\"},{\"review_id\":\"0a91200d-9eb4-4837-bb7b-eaff5aecab3c\",\"review_text\":\"The amount of ads is completely unnecessary!\"},{\"review_id\":\"123a04a3-c3e7-40f2-a1f8-fcdb0bb2ab1e\",\"review_text\":\"Supreme quality of audio playback\"},{\"review_id\":\"8c475398-bbab-4e1b-83e6-1a3ff56c49af\",\"review_text\":\"Good bad ,because for playing one w song we need to pay premium 😊\"},{\"review_id\":\"64bc1fad-81ba-403a-8e82-8603430bc3d1\",\"review_text\":\"Very good i use it to blast my neighbors eardrum out for having sex with my wife\"},{\"review_id\":\"b3bc437a-6007-4105-93d7-5faeab786de3\",\"review_text\":\"Coz the only useful thing in the app was the lyrics and now it's a premium feature holy this ain't good Spotify\"},{\"review_id\":\"e0dbde6f-a395-4dde-a014-52f7d2c1dabf\",\"review_text\":\"Very bad can't even get through the desired part of my song\"},{\"review_id\":\"e15cccf1-f190-4df5-ad70-3e8970451a19\",\"review_text\":\"Update is not nice\"}]}"
