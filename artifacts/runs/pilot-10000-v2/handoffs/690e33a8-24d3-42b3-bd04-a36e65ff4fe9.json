        "content": "{\"reviews\":[{\"review_id\":\"59fb8b52-9c11-4fd1-913a-644b1f45b2a9\",\"review_text\":\"This version its worse you cant play a song,The old version is better than this please change for us if not you are going to lose,its becoming worse\"},{\"review_id\":\"425b9fea-91b2-44b4-9bc0-1ea2dce94883\",\"review_text\":\"Really Thanks 🙏\"},{\"review_id\":\"b78ae3f7-f89a-4a7c-9710-3324e4fac763\",\"review_text\":\"The recent update is the worst update ever we came to Spotify for releif but we can't play a song of our choice we can't shuffle the songs now and can't play any song on loops also preferring to uninstall this app after this update\"},{\"review_id\":\"4bdbb9ab-8935-45eb-a7e5-c6c36bb2e0f2\",\"review_text\":\"I only gave it five stars cause I use panda apk for no adds.\"},{\"review_id\":\"be4dc114-4994-4ff5-842b-4160f1fe38de\",\"review_text\":\"got lots of music\"},{\"review_id\":\"846176c9-e6fe-40d3-a7f8-f04c40c8460e\",\"review_text\":\"Tt has a\"},{\"review_id\":\"333d407e-2fd3-461a-8340-0d5e5c3ad40f\",\"review_text\":\"In my opinion This is The Best app that we can use for listen to, learn and practice music...\"},{\"review_id\":\"4fa95703-6f19-45b7-86de-db097cb9967a\",\"review_text\":\"This is so good i love it\"},{\"review_id\":\"6ce7255a-5ad7-4dab-9884-f3f5f5fe45be\",\"review_text\":\"So glitchy, even on a premium subscription. Albums won't load or play, the app runs extremely slowly and the controls are really buggy. Barely a week goes by without some sort of issue.\"},{\"review_id\":\"87397fee-05d3-4572-9a91-0e0cf1fc711d\",\"review_text\":\"Love Spotify!\"}]}"
