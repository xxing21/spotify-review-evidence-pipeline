        "content": "{\"reviews\":[{\"review_id\":\"2d760804-c138-4704-b3d4-097bdc404e77\",\"review_text\":\"All the songs i wanted to hear are here\"},{\"review_id\":\"dbf373dc-b8c3-48a6-8728-92984fd327c3\",\"review_text\":\"I like this app so much,i think kailangan pa nilang mag lagay ng maraming features para mas madami din ang mahumaling na i download ang app na'to❤❤\"},{\"review_id\":\"cebc8d02-ac1e-450f-ba43-a36e27ccffbb\",\"review_text\":\"Can't log in. No matter how I try to log in I get \\\"Something went wrong\\\"\"},{\"review_id\":\"fbb96066-52f2-4b22-a890-f110e6bb331a\",\"review_text\":\"I reallyyyyyyyyyyyy loved this apppp best one ❤️\"},{\"review_id\":\"6794a952-1afb-479b-af54-eaa9c0704922\",\"review_text\":\"I love this.\"},{\"review_id\":\"025fe321-b3a7-4651-8bc2-76ed3ada939c\",\"review_text\":\"Why does this app have to update EVERY SINGLE DAY ? This is VERY ANNOYING ! It is a good way to listen to music, but IT UPDATES EVERY SINGLE DAY. WHY ?\"},{\"review_id\":\"b82b1b62-7880-4adb-9d1d-525148322019\",\"review_text\":\"Awesome experience 🙂🔥👍\"},{\"review_id\":\"cf2baf33-8df1-4018-9922-b09e556e3c4b\",\"review_text\":\"Me enxanta la aplicación, aunque hay veces que mi música no aparece descargada y tarda en descargar de nuevo\"},{\"review_id\":\"54fe272b-628a-4a60-ab6c-5864920f3904\",\"review_text\":\"Cuak\"},{\"review_id\":\"8ac25466-d59b-429a-be04-85e67332552d\",\"review_text\":\"Love your app!\"}]}"
