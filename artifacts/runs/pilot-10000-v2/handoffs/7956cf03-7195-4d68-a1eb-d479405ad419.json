        "content": "{\"reviews\":[{\"review_id\":\"6e0ee00e-1c06-4d7b-a211-5a5413b5b48f\",\"review_text\":\"Did you think you could force people to buy your premium subscription? Shame on you.\"},{\"review_id\":\"5b9f1a72-9d88-4be6-b65c-148af0dd8cc6\",\"review_text\":\"Justt horrible!!!!!\"},{\"review_id\":\"6233f3ea-e94d-4d89-9661-a8c10b586094\",\"review_text\":\"Best app Ghf\"},{\"review_id\":\"c2c4a1ec-69cc-4a5e-93e4-909fc389e37e\",\"review_text\":\"Getting worse with each update\"},{\"review_id\":\"e3c75ae8-8572-4bd8-b093-fe6f9a918cd2\",\"review_text\":\"Stop changing things that doesn't need to be changed\"},{\"review_id\":\"173a3087-11b1-4627-8ff5-78960d3e420b\",\"review_text\":\"Could be cheaper\"},{\"review_id\":\"9e48657b-d3b9-454e-b954-bb693c40a8c9\",\"review_text\":\"if you pause a song for too long en then keep listting or skip to the next song it stops playing anything en you have to click a new song before it works again\"},{\"review_id\":\"8e73c6d1-c85f-406a-8a15-6874b46426ab\",\"review_text\":\"Very worst experience, it's like that you can't even listen your favorite songs and what is the shuffle feature , i am not happy from this update\"},{\"review_id\":\"e44fc747-8826-4222-af19-9ab410e7dd0b\",\"review_text\":\"Recent update had made this app worse because we have to get premium for basic things such as rewinding or forwarding song\"},{\"review_id\":\"40c5b2b3-9d7a-48a3-96b7-b22a74b22ba5\",\"review_text\":\"I hate this app .... Proud muslim... No respect for swedon\"}]}"
