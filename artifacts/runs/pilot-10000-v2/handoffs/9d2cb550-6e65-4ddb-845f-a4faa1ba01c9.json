        "content": "{\"reviews\":[{\"review_id\":\"7dc829a1-37be-43d8-866f-b6e813bae428\",\"review_text\":\"This app is so spicey\"},{\"review_id\":\"0c2d0e9c-c6bb-4854-bb02-6818bfb18851\",\"review_text\":\"It's a really good app!But it doesn't let me listen to what I want only for like 5 seconds.\"},{\"review_id\":\"c04ee7e6-5805-4f28-9818-14af82a9f55c\",\"review_text\":\"Worst update. Pls fix it. U are just making yourself the worst\"},{\"review_id\":\"b0ca3564-4f3c-443a-8873-c7e087e83292\",\"review_text\":\"Nice one - Phone\"},{\"review_id\":\"4757a141-571d-4903-8b2e-f6f910f594f6\",\"review_text\":\"I thoroughly enjoy listening to my own music here on Spotify.\"},{\"review_id\":\"99d27ae0-644e-4c12-99ec-361563448936\",\"review_text\":\"Really good app for listening to music and podcasts\"},{\"review_id\":\"3e9ebd52-bb00-4efb-a79b-ef445ac97cad\",\"review_text\":\"This thing malfunctions every time It now cannot even play the song of my choice without premium\"},{\"review_id\":\"f62d1d40-4699-4cce-a0ad-02ad4f6f7f32\",\"review_text\":\"Stop autoplay default!!!!!!!!! This app sucks because you cant atop autoplay. Ill never use until its fixed!\"},{\"review_id\":\"0177cf22-b939-4a8e-a0de-9cf1d563eefb\",\"review_text\":\"Music I grow up with 👍\"},{\"review_id\":\"bf9d1d59-b45e-4795-bc41-5a8f98b4d588\",\"review_text\":\"Great app ? . All the music you ever needed.Edit still a very good music player,quality is high. Using free version, still very good app.\"}]}"
