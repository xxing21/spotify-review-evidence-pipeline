        "content": "{\"reviews\":[{\"review_id\":\"701bc0e3-6cbe-4629-a6fb-3604e789f76a\",\"review_text\":\"I love this app it let you play any song you want repeatedly the ads aren't even long probably like a 5second ad it's way better than a 15second one this app is great,awesome , excellent, love worth downloading guys ,😊\"},{\"review_id\":\"c1d5142d-acf3-4019-b81d-5e5999cdfa45\",\"review_text\":\"I can't install the app wth\"},{\"review_id\":\"aa77af91-457e-4235-a870-96302992dbf8\",\"review_text\":\"Teribal\"},{\"review_id\":\"4454f8d3-6f3e-4059-9f4f-cdf5bea6e733\",\"review_text\":\"Enjoying Spotify\"},{\"review_id\":\"a368f938-6cef-42a8-ac66-31800e3b2f14\",\"review_text\":\"Well even after you pay for premium it takes sometimes days to reflect you as a premium user, shouldn't this be immediate? it is immediate with almost every other app on the planet. why should it take days, why should you have to reach out to support every single time, and why does support take forever to get it correct it for us?\"},{\"review_id\":\"25a1f4d5-b240-4fab-b039-f82ca9385182\",\"review_text\":\"Too long ads problem 😞\"},{\"review_id\":\"7ed472cc-edb4-4300-aca2-8ba58bddee4a\",\"review_text\":\"It's good music when I need it\"},{\"review_id\":\"4036ab6e-08f6-4694-bcaa-639f2758fb84\",\"review_text\":\"Worst experience while searching a song\"},{\"review_id\":\"f4446491-5a51-494a-8da5-36204883657c\",\"review_text\":\"I've come late to the party, but it is still rockin'! Whether it is custome mixes I might like, or just your favorite sonds from thousands of bands, podcasts and comedians!\"},{\"review_id\":\"e94602fb-9394-4368-ae8f-41f11fce53e4\",\"review_text\":\"very enjoyable\"}]}"
