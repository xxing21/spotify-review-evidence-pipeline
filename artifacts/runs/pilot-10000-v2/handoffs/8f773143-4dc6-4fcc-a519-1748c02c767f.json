        "content": "{\"reviews\":[{\"review_id\":\"55773dad-29cd-40ba-804d-923a6576d83e\",\"review_text\":\"I can jam out... nonstop!! Love the app!\"},{\"review_id\":\"706732b5-7c44-4227-b7ab-ee54ce1130c0\",\"review_text\":\"Excellent app, been listening for years.\"},{\"review_id\":\"fbe8190e-c4fc-4703-ae4b-c9363809e8c5\",\"review_text\":\"Spotify is very nice app it has podcast and it's show's lyrics also l like this app so l'll give 5 stars\"},{\"review_id\":\"fb2a99e7-d652-4745-8dfd-8b15e8887586\",\"review_text\":\"It is very good and I prefer this one rather than others 🔥❤️😍\"},{\"review_id\":\"6231ddf3-3649-41da-9ac6-dce04cae2f11\",\"review_text\":\"You know what spotify is going from best song app to worst song app because after recent update i can't play songs in order i can't play songs on repeat, i can't read the lyrics everytime i have to listen next song i have to open the app please fix these otherwise i am deleting this Spotify soon\"},{\"review_id\":\"061613d3-81a1-4275-9f67-81c4b47a37b1\",\"review_text\":\"Fire\"},{\"review_id\":\"4942681e-06a1-4b1b-a069-0fc2a0c8bd9f\",\"review_text\":\"This app just fell down so bad because of its new premium features all the common and necessary features can't be used now and we need to have premium for these features\"},{\"review_id\":\"338241fc-9516-4252-9f81-30cd57d0f60a\",\"review_text\":\"I am honestly in love with this app\"},{\"review_id\":\"6e7890ec-3770-46dd-b21b-514915c439e9\",\"review_text\":\"To many advertising\"},{\"review_id\":\"03eb2ccb-a537-474c-99f2-76478c7db401\",\"review_text\":\"Lol app\"}]}"
