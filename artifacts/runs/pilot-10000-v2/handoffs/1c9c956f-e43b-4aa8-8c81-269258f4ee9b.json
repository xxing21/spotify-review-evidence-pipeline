        "content": "{\"reviews\":[{\"review_id\":\"55f45edd-3983-4a29-9bc1-0ee13db82a3b\",\"review_text\":\"Best App For Music\"},{\"review_id\":\"91d44e81-f265-42eb-a2a6-794520b104f0\",\"review_text\":\"If you want Less music and more advertisment then chose Spotify\"},{\"review_id\":\"9ecf71e0-7dbf-4f43-960b-9250b4e2476f\",\"review_text\":\"Love it - great way to listen to songs\"},{\"review_id\":\"f1848566-efb8-42f0-9370-0c686d0a038a\",\"review_text\":\"Best app in song\"},{\"review_id\":\"f9ab9e7a-c760-4dd8-88f3-ef9df0eb7ae6\",\"review_text\":\"It's very glitchy and hard to work with ngl although at least it plays music tho your better off with YouTube music\"},{\"review_id\":\"ea117de0-9eee-45d3-ac3c-a04ceaf32def\",\"review_text\":\"Like having the biggest music shop in the world at your finger tips! Don't know how I lived without it.\"},{\"review_id\":\"c5338856-c42c-4128-8691-8d0dbf817127\",\"review_text\":\"U know why\"},{\"review_id\":\"48bfd4a7-5ad1-4275-932f-e609bf83cdde\",\"review_text\":\"The canvas feature in not coming on my app. I have updated and reinstalled the app multiple times, and even cleared the cache.\"},{\"review_id\":\"5d133d22-5f1f-4d0d-9374-ddb83b008ed1\",\"review_text\":\"I love this app. I use it everyday!\"},{\"review_id\":\"00168741-ef81-4267-9cb9-b82ad5b43a8c\",\"review_text\":\"You took away the ability to watch video podcasts on my TV. This is literally the reason I have a paid subscription.\"}]}"
