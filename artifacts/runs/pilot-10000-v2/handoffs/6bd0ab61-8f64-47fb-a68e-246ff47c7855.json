        "content": "{\"reviews\":[{\"review_id\":\"b756c21a-7637-4006-aef0-f8e93d84d62f\",\"review_text\":\"Best music streaming platform\"},{\"review_id\":\"250fc5d1-5682-4133-9423-1ece27b2af01\",\"review_text\":\"Lovely music\"},{\"review_id\":\"86fbcb0d-74f9-4687-91a4-91e54ed57df7\",\"review_text\":\"Love the app music is great on here only down side is of you want to play any song you want you'll need premium\"},{\"review_id\":\"3f062954-0210-419c-8000-9c3ef0bd081d\",\"review_text\":\"Excellent for TV\"},{\"review_id\":\"fbbf8223-4ed8-4702-b63a-aab8eec3af93\",\"review_text\":\"Ham ko one rating Dana hai\"},{\"review_id\":\"dd8818a2-f08c-465a-b77b-4cab4bf17b6d\",\"review_text\":\"I know Spotify want money in exchange of premium but dont give too much pressure on users acctualy it take premium to play song otherwise purchase premium or listen it tomorrow that's unfair now i am deleting this app their are many much app for music listening that doesn't have this level of non sense\"},{\"review_id\":\"5be3fb97-0dbc-47c8-816b-256a43b23777\",\"review_text\":\"DON'T TELL JUST LISTEN\"},{\"review_id\":\"993c877a-cdfa-4218-9f78-b2f7e4d2b536\",\"review_text\":\"Open Hunting\"},{\"review_id\":\"40275447-a214-4829-9ccf-8d23e111d925\",\"review_text\":\"Worst app ever never downloaded it. 0 stars if I could. It keeps adding song to my playlist and I don't even get to here my songs.\"},{\"review_id\":\"815e7b58-f14d-4d59-8a58-3058322cd6fc\",\"review_text\":\"Great until today. Podcasts has sound. Have lost all sound on my music. What can I do?\"}]}"
