        "content": "{\"reviews\":[{\"review_id\":\"9ce418bd-fc96-49cb-abee-1fe95ca50223\",\"review_text\":\"Very holy.\"},{\"review_id\":\"da3948c2-249b-4862-afee-8d14380f9d42\",\"review_text\":\"It is an amazing app\"},{\"review_id\":\"89c3a539-acf5-4783-b756-2ec87b8bea51\",\"review_text\":\"Best playlist ever Want to give 10 stars.😀😀😇😇\"},{\"review_id\":\"d64f7204-a695-4491-86f7-d971f436d2ab\",\"review_text\":\"It was ok intially, but the premium mode has started becoming hurldle in daily usage. After 2 or 4 songs you can't listen more for free.\"},{\"review_id\":\"c59270e2-f2b2-47bc-be83-11a3a1a037fa\",\"review_text\":\"Spotify is the Best app for music around the world..im greatful.\"},{\"review_id\":\"8b575d7f-18b3-49f7-a7a2-8d996686da71\",\"review_text\":\"Its the song app ever\"},{\"review_id\":\"2ae245b7-9a18-4233-a6f9-b1d955d8a583\",\"review_text\":\"App was good earlier, but recently i am facing problem while login in to the app not good at allthis thing.\"},{\"review_id\":\"1bb5dadc-d86f-44d7-98cf-99ec157a6909\",\"review_text\":\"I love Spotify. I use it at home, work, in the car lol. One ear budand I'm good to go.\"},{\"review_id\":\"a5a3cb8e-80f7-45d8-b759-3170b77480ad\",\"review_text\":\"This app is amazing. Definitely recommend it.\"},{\"review_id\":\"ad8dcc64-4bd5-4b02-b602-6c53f38f63c1\",\"review_text\":\"I hate this app now the recent update sucks tbh\"}]}"
