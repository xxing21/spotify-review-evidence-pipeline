        "content": "{\"reviews\":[{\"review_id\":\"bc0d5d51-973e-4947-ac0b-084b4eb39f19\",\"review_text\":\"Baddd\"},{\"review_id\":\"647af4f3-d719-4512-aed7-0308a206d88f\",\"review_text\":\"Wow!\"},{\"review_id\":\"a3d927f5-49ca-4405-9ca2-7a0b7d6c7557\",\"review_text\":\"This aap is fantastic\"},{\"review_id\":\"04cacca8-18b9-4472-885b-9fa8ea35c232\",\"review_text\":\"In the middle of songs its pauses and then restarts the whole song. You have to go into the app and play the song again. Songs randomly get hidden I look for what playlist to un hide them cant find it it's a problem cause some of my favorite songs are hidden.\"},{\"review_id\":\"2492f10f-9ade-4b74-a28d-bd112c9b0ffd\",\"review_text\":\"Don't make fun with islam\"},{\"review_id\":\"53ca3ca6-79c8-4c82-8e3f-f40a9ee3f910\",\"review_text\":\"The qpp is awesome\"},{\"review_id\":\"666084fb-1837-47f1-8eb7-67ee1e860bc2\",\"review_text\":\"UWUWUWUWUW ANG GANDA\"},{\"review_id\":\"c724d3c6-1027-46ee-bd4b-1e993b56156c\",\"review_text\":\"Excellent, I love it\"},{\"review_id\":\"52e1c84e-a6ff-4254-a492-3303a57f8c7c\",\"review_text\":\"I love my Spotify the only thing I don't like is that you sometimes have to delete songs 1by1 and also when you make a playlist and add the same songs you have to go and take your doubles out but I still love it\"},{\"review_id\":\"ff7d9996-1590-4b3f-8e73-7cec84479e74\",\"review_text\":\"Hate this application 👎👎👎👎\"}]}"
