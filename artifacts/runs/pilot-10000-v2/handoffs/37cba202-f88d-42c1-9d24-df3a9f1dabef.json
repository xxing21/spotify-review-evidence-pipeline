        "content": "{\"reviews\":[{\"review_id\":\"7ba57fcb-6355-49de-b024-216ddc5c8b5f\",\"review_text\":\"This app is amazing and so cool\"},{\"review_id\":\"4426ccca-483e-4cff-be73-7bb547df5257\",\"review_text\":\"The volume is raising to max between each tracks. Even ears started to pain. Toooo bad....\"},{\"review_id\":\"bf6e98e2-c168-414f-9ca1-d6835674594d\",\"review_text\":\"It shuffle the song that you don't like\"},{\"review_id\":\"7716bd2c-9de0-436e-af2f-615e474dc887\",\"review_text\":\"Spotify is my go-to for podcasts!\"},{\"review_id\":\"86d1db2c-b95c-41b2-ada7-c8bd01cbdb6d\",\"review_text\":\"Good app always used with all types of songs and easily traced out any song .\"},{\"review_id\":\"b3bb83ee-e078-4eef-909c-87b9a12350a1\",\"review_text\":\"ground data waze audio map about the blank. files and doc (bridges) ground network romel v. rosal OK ba\"},{\"review_id\":\"0338bca1-908a-4b5e-aba3-38a70e5f2138\",\"review_text\":\"pretty chill\"},{\"review_id\":\"f2af645d-4311-4799-a91b-1ffac36f24ee\",\"review_text\":\"Esta bien perronsisima\"},{\"review_id\":\"fea0d4f6-184a-444b-a45e-b4f77c18baba\",\"review_text\":\"Very cheap app\"},{\"review_id\":\"6ff20c19-fe45-41af-b658-6141dc220fba\",\"review_text\":\"It just doesn't load 90% of the time, or will only play what I've downloaded. I can't get the app to open most days.\"}]}"
