        "content": "{\"reviews\":[{\"review_id\":\"c0bc0e37-472d-4a9f-8069-b77d6c4f8d71\",\"review_text\":\"It has become the worst app after the new update,you can't even do the basic things that need in a music app it's almost like they are punishing you for not getting the premium\"},{\"review_id\":\"372b946c-0d3a-43e1-a50b-ddf18b163f04\",\"review_text\":\"BYOCOT SEWDEN\"},{\"review_id\":\"0c929c95-9572-411c-bf83-b819a5fff17a\",\"review_text\":\"who in their right minds thought this too be a good update? U want to view the lyrics pay us. U want to loop the song? U have to pay us.. The free tag on this app now is just for show as half of the basic functionalities is behind a pay-wall and the UI is extremely glitchy and unpolished\"},{\"review_id\":\"aa285dd1-fd57-42df-98a1-6303df977342\",\"review_text\":\"Hate this application ban it immediately 👎🙏\"},{\"review_id\":\"678437da-8b15-4ea6-b7ea-0454548c105a\",\"review_text\":\"I keep getting recomended songs i hate\"},{\"review_id\":\"a79615e4-85d5-4008-9ae5-e3b13565fcf5\",\"review_text\":\"This app is very good for music\"},{\"review_id\":\"4cb925d5-1da7-4101-a0ba-7915b99b46fb\",\"review_text\":\"New update is so bad cant even access basic features like putting a song on repeat or playing a playlist is order its so bad 😞\"},{\"review_id\":\"2df416f7-4b66-466e-80ed-fc945864ad62\",\"review_text\":\"I want the Spotify Wrapped again\"},{\"review_id\":\"17a2c050-5a58-4c1d-bdc6-002a39b0d1f5\",\"review_text\":\"The playlist, selection of Music, artist , Here is app that is more than A Therapy ❤️❤️\"},{\"review_id\":\"cbb26d7f-0c14-4d47-9bed-7cb3a7459996\",\"review_text\":\"It's a very good music app\"}]}"
