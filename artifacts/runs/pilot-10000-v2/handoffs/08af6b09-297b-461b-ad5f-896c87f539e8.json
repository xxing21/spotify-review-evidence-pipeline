        "content": "{\"reviews\":[{\"review_id\":\"611adcf4-004a-4ec3-8916-a176e9205505\",\"review_text\":\"I love paying for this music app worth it !!\"},{\"review_id\":\"002106cf-73c1-437f-b382-4885691e2af0\",\"review_text\":\"Easy to use\"},{\"review_id\":\"55405a60-0436-4401-b47e-05cb125a4209\",\"review_text\":\"Nice aap\"},{\"review_id\":\"7f97fc16-5d52-4c7e-bca6-fc6726dd9e22\",\"review_text\":\"Couldn't ask for better!\"},{\"review_id\":\"79d697c3-4c42-44a5-a09f-9a9a4adf08e0\",\"review_text\":\"Superb quality 👍💟\"},{\"review_id\":\"46b03935-05b9-4eb9-a433-96d774f99d01\",\"review_text\":\"App pauses randomly while listening. This usually happens a during commercials.\"},{\"review_id\":\"988406bb-d06a-43a8-a37c-f8d9dd3f8a14\",\"review_text\":\"Very nice old evergreen song collection, But limited song collection. Add more evergreen 50 to 90 century songs. Thankyou\"},{\"review_id\":\"1c912ff5-4105-4d49-bf3d-439680ef1eca\",\"review_text\":\"the app is awesome, it doesn't let me down. love the fact that I can listen to my playlist offline if my phone losses connection in a dead zone.\"},{\"review_id\":\"8de67a85-2a3a-4d65-a9f6-e0013bf752c5\",\"review_text\":\"Wala akong Pera eh\"},{\"review_id\":\"20defdcb-9118-4b6c-b37e-397593d40e3f\",\"review_text\":\"Brand\"}]}"
