        "content": "{\"reviews\":[{\"review_id\":\"3569509e-6d73-47ee-8146-72959e672385\",\"review_text\":\"Not at all pleased with this app would recomend you tube premium. Offline mode does not work at all. All my playlists are missing.\"},{\"review_id\":\"189360e9-a392-4b42-ad29-23915e075e5c\",\"review_text\":\"Good vibes only\"},{\"review_id\":\"0e0c1459-1408-48a5-af0d-de6ee079fa88\",\"review_text\":\"Bro you know it all the big bang update.\"},{\"review_id\":\"28b8f6cc-0450-459e-8cce-f2403de818bf\",\"review_text\":\"Good selection dependable\"},{\"review_id\":\"1f6b7d2e-2172-449a-9d7f-efe418d7b394\",\"review_text\":\"Brilliant\"},{\"review_id\":\"069b4350-7f04-4866-a942-19c824ab7919\",\"review_text\":\"ఐ లవ్ ఐస్ అప్\"},{\"review_id\":\"414aad0b-d968-4707-81be-af0634ccdc4c\",\"review_text\":\"DIESNH 😘❣\"},{\"review_id\":\"d84b85b6-476f-4cce-8cac-4268bac1db7f\",\"review_text\":\"I've had a nice experience with Spotify and it's worth it.\"},{\"review_id\":\"6fd7671f-0059-4bc0-a831-b2f6e4a53809\",\"review_text\":\"New update very bad😔\"},{\"review_id\":\"2ee68490-35b8-45f0-9094-59c80c136845\",\"review_text\":\"I hate this application 👎\"}]}"
