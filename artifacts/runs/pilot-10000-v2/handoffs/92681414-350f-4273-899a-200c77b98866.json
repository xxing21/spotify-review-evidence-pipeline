        "content": "{\"reviews\":[{\"review_id\":\"dff83b18-b895-4d48-970c-111e98225035\",\"review_text\":\"New uodate sucks\"},{\"review_id\":\"53c8ec08-90a5-4b8f-b23a-997ec3581bf8\",\"review_text\":\"Bahot Ganda aap hai bhai\"},{\"review_id\":\"931ae38c-d9c3-4e5b-9c1c-dac699b62c8e\",\"review_text\":\"It's a good app, but I don't like how you have to get premium to unshuffle your playlists.\"},{\"review_id\":\"d0ac6f0d-462b-4af5-858a-de470b2fa9b3\",\"review_text\":\"Keeps repeating the same songs and not ones I have queued. Frustrating and not sure whether I want to continue\"},{\"review_id\":\"c16ea394-91db-482a-b7c0-8feea17c20c5\",\"review_text\":\"The um BEST\"},{\"review_id\":\"ea1585eb-f5af-40a9-a87b-d1bfb8623b39\",\"review_text\":\"Excellent app. It gives us the ability to choose different songs for different moods I would recommend this to everyone\"},{\"review_id\":\"927b9d5b-568d-4bdd-b0f4-2df49ea90eb8\",\"review_text\":\"Itsfun\"},{\"review_id\":\"1894203c-fd0e-4394-b593-ed8ced2f7894\",\"review_text\":\"I usei in the past, but so many ads used to annoy me. Now it looks much better and not too many ads if you're a standard user like me\"},{\"review_id\":\"62d82908-555a-4191-a6de-6ccca03c881c\",\"review_text\":\"Worst appp koi download nh kare issy bekar h farzi\"},{\"review_id\":\"0148ad58-a4de-4f28-b81b-073ce9a24a68\",\"review_text\":\"Not working on my phone now after updating the damn app\"}]}"
