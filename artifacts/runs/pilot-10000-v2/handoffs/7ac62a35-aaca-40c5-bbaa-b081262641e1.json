        "content": "{\"reviews\":[{\"review_id\":\"38a807af-44d9-4660-86d1-eb7b7a627c26\",\"review_text\":\"Either premium or uninstall Very annoying app now....\"},{\"review_id\":\"ab83e890-9076-4fc9-a069-c32943e9dc53\",\"review_text\":\"Great app but I can't open the playlist of my favorite songs anymore I hope it gets better\"},{\"review_id\":\"df14fc02-1b82-496f-9da4-887ab20e69cb\",\"review_text\":\"This new update came and I'm not allowed to play music, the loading screen keeps showing up and it likes the close itself, I love Spotify but right now it's getting a 1/5 until it's fixed\"},{\"review_id\":\"093e8847-9b7c-4e48-95d3-c3f068c20542\",\"review_text\":\"Love the music\"},{\"review_id\":\"19bf53ca-5131-4448-8041-cb37c38f1f44\",\"review_text\":\"Really good app to listen and find music\"},{\"review_id\":\"28e8c56b-4ef4-4538-8065-40da88b6c0b3\",\"review_text\":\"So far I've enjoyed using this app. I made a playlist for my party and I also have one for more holiday. Brilliant.\"},{\"review_id\":\"141becdf-d093-41c3-acfb-eec092950ea2\",\"review_text\":\"So much for a music enthusiast!\"},{\"review_id\":\"bf9d0fb6-97be-49de-a1cf-9c30c0f57cdc\",\"review_text\":\"The recent update has worsened everything\"},{\"review_id\":\"03552f35-d10d-440e-9c0b-0739b24af322\",\"review_text\":\"Download 1b Khushi\"},{\"review_id\":\"476002b2-0d2b-443c-b586-71d4b4596f1d\",\"review_text\":\"For islam\"}]}"
