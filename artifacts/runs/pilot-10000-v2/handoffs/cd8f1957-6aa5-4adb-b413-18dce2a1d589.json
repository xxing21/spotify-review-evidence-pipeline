        "content": "{\"reviews\":[{\"review_id\":\"0f794e92-1c5a-4020-8eea-e75d836a626f\",\"review_text\":\"Just wow❤️\"},{\"review_id\":\"8203183d-69d6-402a-b48f-89fc839ff92a\",\"review_text\":\"Using the Spotify app listen listen to music no matter where you are is fantastic , especially if you if you have really good quality ear plugs or an ear headset Spotify rocks 😀\"},{\"review_id\":\"772dba3c-8a9a-481a-a6b2-0decb0d4cf93\",\"review_text\":\"See the power of muslims\"},{\"review_id\":\"c7708024-e341-4e46-bd8f-0ff0838c8b9e\",\"review_text\":\"I cannot retrieve my account which I had opened previously with my phone number... please help me ...I want to get back my saved songs..\"},{\"review_id\":\"6a9e5013-8c00-4455-a2b5-0482a74909ea\",\"review_text\":\"Your app is bad\"},{\"review_id\":\"619dff9d-81a5-4a89-91a5-66ba8cfa2a28\",\"review_text\":\"good music but the app service is very dishonest 😕\"},{\"review_id\":\"ad4c0347-fe4b-47c5-8b0a-d453bc3aa727\",\"review_text\":\"Ocassionally removes some of my songs from my playlist. Its rare, but it happens and can get annoying. Otherwise good app Edit: now sometimes it changes my songs to clean version and adds new songs to playlist idk if its them nudging me to different songs or whatever but it is kind of annoying\"},{\"review_id\":\"a709acbb-4a89-4168-a6a9-3e368e7df28a\",\"review_text\":\"Gr8\"},{\"review_id\":\"508885cf-4aed-4f59-8a56-af3677826ee7\",\"review_text\":\"☹️👎👎\"},{\"review_id\":\"4da3b37c-2c02-4257-84d1-a3ee4dc5d795\",\"review_text\":\"Good my ysuc,lots of variety\"}]}"
