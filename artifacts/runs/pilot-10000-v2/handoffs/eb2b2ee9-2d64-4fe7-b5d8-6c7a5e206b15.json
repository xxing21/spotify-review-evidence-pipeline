        "content": "{\"reviews\":[{\"review_id\":\"5d0765dc-3f6b-4a82-a34e-d8a0194069ac\",\"review_text\":\"A very good sound experience. Has all types of songs in it .Really smooth app. Controls are so good. Ads are a bit too much .Ads can be reduced. Finally a nice app for music\"},{\"review_id\":\"a6a04f84-f12f-4dd5-8290-2c795f05d03f\",\"review_text\":\"Spotify is amazing\"},{\"review_id\":\"d9842937-f434-4430-b02b-0fd8fb794b4f\",\"review_text\":\"Perfect song partner❤️\"},{\"review_id\":\"88f43cb5-4aec-4e02-bd5b-ecf88e167fc4\",\"review_text\":\"This app is super\"},{\"review_id\":\"0f78fb52-bae6-48fa-8bfd-a280b057f782\",\"review_text\":\"❤️❤️❤️❤️❤️\"},{\"review_id\":\"10838e00-1714-47c6-91f4-e4b5b8e142c0\",\"review_text\":\"Well uninstalling this because of the horrible updated version\"},{\"review_id\":\"e7fb8d7e-33b3-4b56-b1ba-4ec42d923148\",\"review_text\":\"Very bad experience Even free functions are included in premium like repeat song fast forward etc. Use wynk instead of spotify\"},{\"review_id\":\"5dd359ea-739c-453e-8208-88b3e8bd6cb6\",\"review_text\":\"🤨\"},{\"review_id\":\"acb7808a-9dd9-416b-a95f-dac846a8c65d\",\"review_text\":\"Super awesome 👍😎\"},{\"review_id\":\"b34e2521-f309-4a05-8e9d-317b7d49dfb3\",\"review_text\":\"Really this is a good aap for songs I like it\"}]}"
