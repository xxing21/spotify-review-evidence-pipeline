        "content": "{\"reviews\":[{\"review_id\":\"04f725b6-4449-4d79-8cd4-cddbe5a9e04c\",\"review_text\":\"I can't take this anymore. This Spotify keeps shuffle and I can't take it anymore\"},{\"review_id\":\"ff9672ef-cb0e-4740-aa89-ef5dda87ae3f\",\"review_text\":\"You guys want to play music we don't choose and playing ads every after a song💔\"},{\"review_id\":\"a55554ab-df17-4d0d-83e9-8e684f320761\",\"review_text\":\"Useless👎🏻\"},{\"review_id\":\"f1ca8e39-728e-4181-a976-cc75c241dd5a\",\"review_text\":\"I just love it alot\"},{\"review_id\":\"1c942a73-1b30-4c43-b642-6d977067d65a\",\"review_text\":\"Boss DK sab chiz mein tujhe premium hi chaiye\"},{\"review_id\":\"539b65e0-1960-481c-9661-cabd152713c0\",\"review_text\":\"what the hell are you doing spotify? We non premium users are patiently listening to long ads ,but now you've removed the basic functionality of a music player - can't skip parts, can't go to previous song,etc. This is too much ! People ! time to switch to other alternatives .\"},{\"review_id\":\"e945a4bd-a08f-4aaf-9dae-093a92afbb92\",\"review_text\":\"Such a garbage app. Even dont respect anything\"},{\"review_id\":\"422af0ad-be2a-421d-837f-de93f32bdd99\",\"review_text\":\"Ch*tiya app\"},{\"review_id\":\"289baa03-5a52-4f6f-a0f6-0a4637ae0911\",\"review_text\":\"This is a must have for music lovers\"},{\"review_id\":\"cee4b180-7208-4286-92fd-1a109910749d\",\"review_text\":\"Shibbu\"}]}"
