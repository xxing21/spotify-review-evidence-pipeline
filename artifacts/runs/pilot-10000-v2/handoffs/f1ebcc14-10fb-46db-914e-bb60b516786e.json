        "content": "{\"reviews\":[{\"review_id\":\"e398ee3a-f2dc-4dff-b123-bbe5ae7311bb\",\"review_text\":\"After the update Front page loading takes time even though net is working\"},{\"review_id\":\"280d19cd-0d4f-4b40-a308-dd9b6aefb0e8\",\"review_text\":\"Worst update ever\"},{\"review_id\":\"e499da77-00c5-45d5-ab66-b7984b43ece6\",\"review_text\":\"wow awesome\"},{\"review_id\":\"5b1868ff-19b2-4be8-9450-a7afb976dd2b\",\"review_text\":\"Fine, pays its artists 0.000033 p per stream. Seriously. Look it up. I moved to Tidal who pay 12p per stream, better sound quality\"},{\"review_id\":\"330edc2c-625c-46d0-9cf7-66231969a84a\",\"review_text\":\"I think it's just great that i can have my music everywhere i travel all around Australia, Great job guys.\"},{\"review_id\":\"36a200b0-6003-46dd-893f-88f300a6f19a\",\"review_text\":\"Ruined\"},{\"review_id\":\"ad371f8c-74ef-4a51-b64a-d86456986874\",\"review_text\":\"It's god\"},{\"review_id\":\"1caf62d2-1d26-4a95-8f84-1a35d67ca536\",\"review_text\":\"Still learning to use all features.\"},{\"review_id\":\"76995fbc-a333-4b22-8636-7202cc7bfd17\",\"review_text\":\"000000 molarka ... ..........\"},{\"review_id\":\"d03bd05a-9bd8-4d87-93a4-b0cec418a025\",\"review_text\":\"Waste app\"}]}"
