        "content": "{\"reviews\":[{\"review_id\":\"9c49d0b7-e68c-4e8e-871f-39b2dd7ac85e\",\"review_text\":\"very very nice\"},{\"review_id\":\"f1be6b02-4e16-4170-a06e-1d9e84da2012\",\"review_text\":\"Crossfade stopped working properly\"},{\"review_id\":\"d1522936-53f1-4a95-883f-52d4a630391a\",\"review_text\":\"If i had option to give 0 rating then i would have gone for that. Very disappointed from spotify. We need to buy premium even to use the basic features.🤦‍♀️\"},{\"review_id\":\"e825690b-d260-4eda-a6b4-0df0ece8ed6b\",\"review_text\":\"12 Mar 2023: after a few months of good performance (a first, in my experience) good old Spotify bugs are back! Premium user who suddenly can't download or like songs or albums.\"},{\"review_id\":\"fab12c84-824c-4c60-9ad4-644ae27335e7\",\"review_text\":\"Great music selection .\"},{\"review_id\":\"97ae544b-3a03-475a-bdcf-83d1a457e17c\",\"review_text\":\"Very bad app good music convert bad music very bad👎\"},{\"review_id\":\"c4ae0d0f-3474-47de-9d68-bde0d3f69fc2\",\"review_text\":\"After update this app is very bad👎👎\"},{\"review_id\":\"2d7b2ebe-826f-49cd-a109-b0ab3bf52c2d\",\"review_text\":\"wth is happening with this app???? i can't find or listen to any song i try searching. It doesn't show my liked songs now that i have reinstalled it. I am paying for this app u should fix this asap\"},{\"review_id\":\"a4c8b7dc-22cf-45bc-b0da-25da4a5879e0\",\"review_text\":\"Bycoot\"},{\"review_id\":\"82e49431-bd72-43ae-807b-e99f448f74eb\",\"review_text\":\"Good after subscription\"}]}"
