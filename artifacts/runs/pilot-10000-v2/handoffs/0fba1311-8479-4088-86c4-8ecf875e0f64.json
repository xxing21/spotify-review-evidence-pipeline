        "content": "{\"reviews\":[{\"review_id\":\"2d0508d6-6a43-478c-be53-79b93eda4dee\",\"review_text\":\"Most of my time on the app is now spent hitting the back button because a search fails to load or I can't finish typing my search\"},{\"review_id\":\"40f1f835-f2be-4e4a-a5d3-38dfbe4a71ae\",\"review_text\":\"Good music sence\"},{\"review_id\":\"85b5a790-72bd-42fe-b959-79f75114cffc\",\"review_text\":\"I love it it leans you song\"},{\"review_id\":\"41115ca7-6cdd-46d3-b45e-bd677ff3af90\",\"review_text\":\"I love spotify but please fix the lyrics because its not showing up for me and im not the only one with this problem\"},{\"review_id\":\"e5bba4d2-de8c-4def-bccf-b0d77c5e6c3f\",\"review_text\":\"Very good app,\"},{\"review_id\":\"1fbdfa86-4552-45ba-b4f9-57fa7e34d45b\",\"review_text\":\"No ads.\"},{\"review_id\":\"a7a98058-9485-4a02-b150-d28522257f1e\",\"review_text\":\"Very user friendly\"},{\"review_id\":\"f9d723b6-1e43-4205-ba0e-1b8d4a06fba2\",\"review_text\":\"Too many ads and also you can not find all songs\"},{\"review_id\":\"2b30c584-ad04-4b48-881b-659a35885564\",\"review_text\":\"Has worked great for me many years now and hope many more, thank you.\"},{\"review_id\":\"4dd2abb1-14ac-4dc5-bf6c-d41c0edda5b7\",\"review_text\":\"It used to be best music app. \\\"Used to\\\" .\"}]}"
