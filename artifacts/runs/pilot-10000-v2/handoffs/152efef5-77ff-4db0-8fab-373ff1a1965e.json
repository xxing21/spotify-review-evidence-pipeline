        "content": "{\"reviews\":[{\"review_id\":\"f08b9baa-c8f3-489b-9879-c7930039d47f\",\"review_text\":\"This is the good app\"},{\"review_id\":\"2793cbb0-d7ae-43fc-8724-824f503e54b3\",\"review_text\":\"It used to be good a while back but now it's too petty. Gonna delete it\"},{\"review_id\":\"bb1881aa-68a8-45c4-a84d-a416ef94c6b9\",\"review_text\":\"I like this...\"},{\"review_id\":\"1573b98e-7054-4cf4-bff6-6ad94f4bb4e1\",\"review_text\":\"Worst app if you want to listen songs, go for any other but not Spotify, nothing is allowed without premium, I believe that Spotify board members don't want to serve and just want to sell their premium, I am deleting it right away.\"},{\"review_id\":\"15a9d710-afbd-4535-86fa-16019f6aa0d1\",\"review_text\":\"Not Good Can't Turn off the shuffle option, neither skip songs for few seconds\"},{\"review_id\":\"6fd46671-a042-4655-aba4-01f3d4d9e7b4\",\"review_text\":\"its really healpfull for me . when i was so sad i just one listened to my favourite songs n my mood got changed by spotify app so i like tht app.\"},{\"review_id\":\"ba339d8b-265e-462e-90b1-f1fe65a6c7cb\",\"review_text\":\"Keeps adding songs\"},{\"review_id\":\"d18015a0-d474-423b-ba9d-1b595ec58f5e\",\"review_text\":\"Beacause Disrespect Of Holy Quran\"},{\"review_id\":\"1768d184-6c39-444a-b549-9277745ccf16\",\"review_text\":\"You have a large library experience and I enjoy that\"},{\"review_id\":\"5875904d-0427-4142-b951-d5025c4b9bf4\",\"review_text\":\"I love❤ all songs are available\"}]}"
