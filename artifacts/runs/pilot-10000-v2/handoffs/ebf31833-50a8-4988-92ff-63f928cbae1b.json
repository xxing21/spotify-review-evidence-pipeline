        "content": "{\"reviews\":[{\"review_id\":\"6953b03d-f13f-4f19-a26d-ead4a8f7ba65\",\"review_text\":\"Best music app but your ads are getting more entertaining..i don't have premium cause i enjoy your ads 🤣\"},{\"review_id\":\"c91ac486-54a0-4d67-a8b3-c05af9f6f643\",\"review_text\":\"Damnn dide best ap ever this os lit af dude y does other music apps r there dude spotify is the best\"},{\"review_id\":\"9d9cfe63-1030-44d8-903d-3f768c6e5f0c\",\"review_text\":\"Good app to listen music\"},{\"review_id\":\"b84ac1a6-6031-4464-9c12-3ef6fc45609a\",\"review_text\":\"Fellers in Paris\"},{\"review_id\":\"07018aa5-1e8f-4f0b-bafd-d5b7655a1da2\",\"review_text\":\"4stars for app and 1 star for ad\"},{\"review_id\":\"d328ea14-49c4-419e-8b91-9b6c43cd7c6b\",\"review_text\":\"From worst country...\"},{\"review_id\":\"bcdbfbc8-d745-4bb4-b2e8-fb8ee8693049\",\"review_text\":\"The app is basically worthless if you wanted to listen to a specific song. You listen to whatever it feels like playing unless you have premium\"},{\"review_id\":\"b7a4c13a-8438-4a4c-b0bb-4b4f0bd26ef5\",\"review_text\":\"Default in premium\"},{\"review_id\":\"347622f4-f926-425d-bc1b-454af6e1ea24\",\"review_text\":\"Free version has too much ads but premium is literally THE BEST\"},{\"review_id\":\"a9fe2140-15a1-4d7b-a189-31993b05ef17\",\"review_text\":\"Have loved this app for years now. Top Knotch!\"}]}"
