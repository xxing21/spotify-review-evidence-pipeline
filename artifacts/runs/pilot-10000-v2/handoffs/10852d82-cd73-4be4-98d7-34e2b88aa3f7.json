        "content": "{\"reviews\":[{\"review_id\":\"4df88c4b-643e-4a59-aad8-7388b4d78284\",\"review_text\":\"I ❤ spotify .\"},{\"review_id\":\"bed935d4-ea44-4aed-a041-566167e5917b\",\"review_text\":\"Used it for years with and without premium great experience 😁\"},{\"review_id\":\"27d60da3-2cc6-4c81-ab35-ba70ed419683\",\"review_text\":\"What is the point of offline mode? Poor user experience for a city committee going underground frequently. If a playlist or album is downloaded it should be accessible even when offline....at the least why not make it easier to toggle between offline and online mode?\"},{\"review_id\":\"7b639ca7-cf2b-4086-b3ec-699d210506aa\",\"review_text\":\"My Spotify is not opening I tried alot wht she I do\"},{\"review_id\":\"c2d4d1a4-e523-41fa-a5c1-03035f1bac93\",\"review_text\":\"Buycat all swedan app\"},{\"review_id\":\"d82ed282-7b5e-4f97-b099-445d4834b4eb\",\"review_text\":\"It's was fine at first but now it doesn't even load like it'll stay in the spotofy logo loading scrn\"},{\"review_id\":\"00ed67ab-4abb-4ffa-9294-e62025bcbbaf\",\"review_text\":\"The latest update is really disappointing.\"},{\"review_id\":\"01bae9e0-2ad4-4ce4-98ee-aaac1fa9235a\",\"review_text\":\"Yo estoy pagando el Spotify premium, para que me cuenten el stream que hago y ahorita le quitan eso, APRENDAN A MÁS QUE SEA DISIMULAR PORQUE LO QUE HICIERON ES UN ROBO AL OJO\"},{\"review_id\":\"1d142eb7-14ee-4b53-aebc-cb56fd120edb\",\"review_text\":\"Absolutely great\"},{\"review_id\":\"7fea3a46-b149-4cf3-b30a-c6d569b0e4ee\",\"review_text\":\"Best music source ever!\"}]}"
