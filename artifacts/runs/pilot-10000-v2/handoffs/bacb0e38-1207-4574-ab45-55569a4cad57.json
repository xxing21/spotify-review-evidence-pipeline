        "content": "{\"reviews\":[{\"review_id\":\"d55288d0-6250-44ff-9526-b469aa75fbd0\",\"review_text\":\"This is so good\"},{\"review_id\":\"a782d95d-9548-45d5-94a4-c74b55cd6371\",\"review_text\":\"This update ruined this app\"},{\"review_id\":\"bf0bf4b7-253b-4063-bb2f-803dbdb28e0a\",\"review_text\":\"Nice music quality, i dont have premium tho i never get ads\"},{\"review_id\":\"dc326335-a991-46bd-b73d-2b1dd0a12cf4\",\"review_text\":\"The app is good and the music on it is original as well almost all the covers are available too. Loved this app. Have a suggestion to add an easy way to remove songs from a playlist by swiping right just like swiping left to add a song to queue\"},{\"review_id\":\"b7683c3c-59aa-4de8-a730-d4112ed93c9d\",\"review_text\":\"Hate thi application 👎\"},{\"review_id\":\"7c29d830-3960-46c7-93e7-24f8abcc2206\",\"review_text\":\"Very good app for music and with premium this is very good\"},{\"review_id\":\"67177c7f-047c-4694-89b7-f10b44df31bc\",\"review_text\":\"Sounds good\"},{\"review_id\":\"a8b31354-086f-4e9f-9e0b-1abf55fa4af2\",\"review_text\":\"Why can't I find podcasts ? I get notifications for the updates, but when I tap nothing happens\"},{\"review_id\":\"6a1f0299-16c8-46b4-bfa8-492c55ea1076\",\"review_text\":\"🥰\"},{\"review_id\":\"2fe4b92d-5b7e-4030-a99a-951721c3ddf2\",\"review_text\":\"thank you for the newest update, i really love it! but before i share the lyrics to socmeds or others, in the preview; there's a lot of space and i don't really like it. please fix it🙏🏻\"}]}"
