        "content": "{\"reviews\":[{\"review_id\":\"d7702119-07f4-49f5-901c-09914bbf7bfc\",\"review_text\":\"Where did i start i mean it is good app..Good app for ads and ads and ads . After listening only one song you can have ad which is longer then song. And with the latest updates you can't even listen to your playlist in order you can only listen on shuffle. If you're going for Spotify by assuming for free song experience.Then please don't SPOTIFY is only premium customer\"},{\"review_id\":\"0ddf7409-188c-43f9-9019-aa18091fa5b3\",\"review_text\":\"Please control your adds It's irritating always But I like this app Thank you\"},{\"review_id\":\"30469bb3-0ec3-4e5d-a154-82392da349be\",\"review_text\":\"It has helped find good and new amazing music\"},{\"review_id\":\"6ccef4c9-ad86-4390-b3a3-8c4d0fbf2d1c\",\"review_text\":\"This app is great for over-the-road truckers and those of us who can't seem to find anything on the local channels. If you're looking for specific music and you have a certain genre you'd like to hear Spotify is where you want to go.\"},{\"review_id\":\"22563046-de19-4f0e-8f56-5fca8f4acc1e\",\"review_text\":\"overrated af\"},{\"review_id\":\"f8542296-eb26-4253-9a40-b7f5f6eeae98\",\"review_text\":\"it so cool i like Spotify for music\"},{\"review_id\":\"7e571b7d-f624-4926-a004-5b3f4b573e72\",\"review_text\":\"Great app for excellent commercial-free music of all genres. 👍👍\"},{\"review_id\":\"5a30a8f2-59d5-4723-b104-b601fa4941f7\",\"review_text\":\"Not simple enough, problems left and right what comes to connect via wifi and just play and listen\"},{\"review_id\":\"5e9ec86b-eece-49be-b768-f3509b712305\",\"review_text\":\"It's a nice app to listen music\"},{\"review_id\":\"f895c016-8d3b-420e-8579-d1b901c0063c\",\"review_text\":\"Spotify is now the worst music app istg\"}]}"
