        "content": "{\"reviews\":[{\"review_id\":\"d12c56aa-47a1-4eab-af81-67c3c07cc9a8\",\"review_text\":\"i am a free user, and i dont rlly carea about the ads, so it's rlly convenient even for any type of subscriptions, whether premium or for free!!\"},{\"review_id\":\"63136c13-a334-4fa8-9143-31fbb1599462\",\"review_text\":\"Worst....\"},{\"review_id\":\"ad2944a0-2a42-4048-b139-a211b7aa657e\",\"review_text\":\"BEST 👌 👍 😍\"},{\"review_id\":\"5617d343-4a81-4432-804f-dbc4f91cf9aa\",\"review_text\":\"Best beats for the buck!\"},{\"review_id\":\"44dac2be-a857-4ad9-a3b7-d3a4a9e56c8a\",\"review_text\":\"I love my Spotify: Music, Podcast\"},{\"review_id\":\"8f628cd8-8216-449a-b9b6-482f5dbb9edf\",\"review_text\":\"Spotify has really become the worst!!!! It don't work at all!!! They really need to work on this app\"},{\"review_id\":\"5f4ffff8-311b-483c-b800-8d11c9b73e36\",\"review_text\":\"Have loved the app for a long time, but after the last update I can no longer continue playing a playlist. It finishes the last played song and then resets the entire list.\"},{\"review_id\":\"eba442c4-0725-411e-a3db-922aa3207c53\",\"review_text\":\"Very good For music Listeners 💖\"},{\"review_id\":\"d0e21821-a551-4a59-8d15-275519c12d92\",\"review_text\":\"I love to use it\"},{\"review_id\":\"e1e643fb-f21d-4081-b66e-30b2c5fb1092\",\"review_text\":\"Very beautiful\"}]}"
