        "content": "{\"reviews\":[{\"review_id\":\"7ff3490e-f193-4442-89b6-ec6a484aa4ef\",\"review_text\":\"Awesome and relaxing too\"},{\"review_id\":\"61ab8540-25c6-4a0f-8da5-580a06bd29f1\",\"review_text\":\"Boycott sweden\"},{\"review_id\":\"9110ff38-5b36-4145-b940-3e51a5d35952\",\"review_text\":\"My stress buster 😇 and it's really worth for subscription. And also quality of musics and sounds are really amazing plus impressive...\"},{\"review_id\":\"d66b12f2-920e-4f63-a2a1-e3774db15b13\",\"review_text\":\"The variety of music is right in my wheelhouse Great app\"},{\"review_id\":\"357816de-6a09-4a5d-bd7b-0b91045a26b6\",\"review_text\":\"It is easy to use and very enjoyable\"},{\"review_id\":\"933b1cf2-8fa9-46aa-9a06-85fd89533a99\",\"review_text\":\"Volume of ads is way louder than the volume of the music. Makes the app unusable.\"},{\"review_id\":\"81c3c4f2-d4cc-443d-858b-cbdd110aee32\",\"review_text\":\"It's starting to spam me with stuff everytime I open it up besides that great app...\"},{\"review_id\":\"ccdd78df-f83b-4c8b-97b2-5cef7813ab2c\",\"review_text\":\"The update is worst you can't even skip any lines from songs going to uninstall it🙌 not recommended app for music..\"},{\"review_id\":\"c83eb52a-220a-42a2-8603-80209d022288\",\"review_text\":\"Quraan\"},{\"review_id\":\"520c9ec2-a9aa-4e7e-977b-a39942734702\",\"review_text\":\"i like it but lately it's been having bugs, like not loading lyrics or the song not existing (it does). but besides that its okay i guess.\"}]}"
