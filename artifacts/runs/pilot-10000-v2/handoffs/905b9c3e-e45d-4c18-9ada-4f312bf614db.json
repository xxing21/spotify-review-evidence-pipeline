        "content": "{\"reviews\":[{\"review_id\":\"1a155c1b-a33a-4b63-9e20-8f84c5ae3821\",\"review_text\":\"Ads player\"},{\"review_id\":\"91307bce-b1f1-4a4c-a0ef-b17d474cc294\",\"review_text\":\"💥💯\"},{\"review_id\":\"1a424d7e-1eb6-4167-b98d-9ec5fb95d549\",\"review_text\":\"Hate this app Delete this\"},{\"review_id\":\"6e1019dd-472a-4d18-97a9-134fe8b1df39\",\"review_text\":\"Spotify was the best until basic features weren't for premium. Now it sucks!\"},{\"review_id\":\"8aacb7df-81cf-4689-bd8b-4c5770a80cd3\",\"review_text\":\"Truly we are both growing and I find it funny we are not communicating personal so with that. Let's get better together. Asap. We got this. P. S. I'll be promoting this app HARD! 1pL\"},{\"review_id\":\"713a00d8-f7f7-43d2-8303-2e5e92132618\",\"review_text\":\"Love Spotify. It so easy to program all your favorite songs. I recommend Spotify if you want the best music has to offer.\"},{\"review_id\":\"c56561eb-a4fb-4b8f-bcf3-f9af2d7065e8\",\"review_text\":\"Bring back the lyrics and translations!!!\"},{\"review_id\":\"99e83076-ce84-49d6-8d50-eb91d88ebde1\",\"review_text\":\"Automaticaly logout my account\"},{\"review_id\":\"98eb3d8e-ea6e-4049-8aff-9fdc9c0a7b2c\",\"review_text\":\"Some of my favourite artists aren't here but here quality music and no bugs.\"},{\"review_id\":\"da0c8e5c-d062-450d-897e-f9038c693a8f\",\"review_text\":\"Horrible, lo de cuatros anuncios de seguido es fatal, en media hora seis\"}]}"
