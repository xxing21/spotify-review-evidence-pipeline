        "content": "{\"reviews\":[{\"review_id\":\"d971e453-3c14-4a19-8f47-5cca62f532cc\",\"review_text\":\"Absolutely love the app, the appearance is spot on and there are heaps of songs to choose from! Maybe there could be a themes setting so you can change the background because that would be cool 😎\"},{\"review_id\":\"0efa0298-ed8b-403b-85cd-62efdb83cec3\",\"review_text\":\"This update is so good 🤬So I gave one star\"},{\"review_id\":\"9800b434-4d9b-433d-807d-320a1c6c6f29\",\"review_text\":\"Worth the money! 👍🏼\"},{\"review_id\":\"d57ab41e-de92-439f-998b-c47a9a747792\",\"review_text\":\"It gives a lot of adds...!....\"},{\"review_id\":\"878d6241-200f-46c5-aa39-45745cd4a55e\",\"review_text\":\"Pengiriman cepat, gratis sampah, muter aja trus sampe tolol, ngaget ngagetin aja, iklan jgn yg ngagetin\"},{\"review_id\":\"8323ebff-67ce-4108-bb5e-de77d5c85148\",\"review_text\":\"Awesome experience\"},{\"review_id\":\"dbf0122a-8d0a-4f26-a5d1-defe7da4a521\",\"review_text\":\"This app is deadd\"},{\"review_id\":\"09969f31-6ea1-4d6f-b80f-33ddfef709f4\",\"review_text\":\"Way too many ads now, I get more ads than songs. Looking for a new music streaming app.\"},{\"review_id\":\"9ce6bdaf-cbd2-41ce-8d36-bbe2e6d2ebd1\",\"review_text\":\"WHERE IS MY SPOTIFY AI DJ OPTION\"},{\"review_id\":\"7b3b7b76-9e79-4cb3-92ab-51d17bffef70\",\"review_text\":\"Jai Shree Ram 🚩🚩🚩🚩\"}]}"
