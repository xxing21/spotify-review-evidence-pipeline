        "content": "{\"reviews\":[{\"review_id\":\"62614890-4711-40c9-ae8b-a082478fae70\",\"review_text\":\"Mast song\"},{\"review_id\":\"a588c1c7-c7f7-4d81-848c-68fc202b8dad\",\"review_text\":\"How can I spend hours downloading songs and then suddenly everything diaappears and I've to re download everything. And I've paid my 900 naira. I never had this problem when i was using audiomack oh. Sportify should better rectify this or I'm going back to audiomack. It's even cheaper\"},{\"review_id\":\"924cf31c-a959-438d-b910-40614f462b85\",\"review_text\":\"Good app overall\"},{\"review_id\":\"b62fdfcf-8eca-4779-b3d7-09d636505342\",\"review_text\":\"Great❤\"},{\"review_id\":\"4f20aaff-c5cb-4300-8e46-cdefafb8ab91\",\"review_text\":\"idk why the app keeps on crashing, whenever i search a song then play it, the app automatically closes and all.\"},{\"review_id\":\"8b80bb45-087f-4603-972f-71d6a4ee3e62\",\"review_text\":\"I want to replay my music😒\"},{\"review_id\":\"f79c6860-6563-422c-8625-ba30d196aca5\",\"review_text\":\"Hate this appliction 👎\"},{\"review_id\":\"2b7b1d27-27dc-4c9c-bfd1-239bbb1b56a7\",\"review_text\":\"It's okay.\"},{\"review_id\":\"dfc00213-9470-41a9-a22c-14477b372a30\",\"review_text\":\"Tried sharing a song from Spotify but the app kept crashing, saying there's a bug on it. Hope it gets fixed soon. ×\"},{\"review_id\":\"9c0a623a-f56a-4309-9130-d6814c8ae2a8\",\"review_text\":\"Proper\"}]}"
