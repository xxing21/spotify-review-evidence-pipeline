        "content": "{\"reviews\":[{\"review_id\":\"e3ff44f8-6ca0-4fbc-a8d7-3e66cb00b9cc\",\"review_text\":\"Bahut hi ganda\"},{\"review_id\":\"922ff755-daa2-40b5-b9da-3e20eef86396\",\"review_text\":\"Best app so far <3\"},{\"review_id\":\"bd38a97c-be11-4ce3-899c-bf584660d13d\",\"review_text\":\"Favorite ✨\"},{\"review_id\":\"c98708f0-bd39-4af6-98e7-7e7c6f94332a\",\"review_text\":\"It's really good\"},{\"review_id\":\"e8eff3e5-8189-414f-bf79-1b5efc20f0cc\",\"review_text\":\"Great app with intuitive UI and solid recommendation algorithms. Gave 4 stars only after seeing their royalty rates to artists and I'll likely be switching to Napster.\"},{\"review_id\":\"1eaabe5a-7cc8-49d3-a0e4-a67c3b5c9fe5\",\"review_text\":\"Censoring artist.. what right do you have for censoring what I want to listen to because of how the company feels about an artist\"},{\"review_id\":\"f12831db-8a7b-4cb5-89e7-311adac2f86d\",\"review_text\":\"Garbage and bad app\"},{\"review_id\":\"23bca68f-f661-4d2c-8f02-c5af84939e7a\",\"review_text\":\"This is to good amazing app love it but there is am reason for giving 4 because in Pakistan we don't able to get premium with cards or goggle pay so please give us a new payment method like easypasa , jazz cash etc\"},{\"review_id\":\"2e8666c0-b720-493c-9d19-c3dfb23a1c87\",\"review_text\":\"can't view my 2022 wrap\"},{\"review_id\":\"b845ff5f-3b14-4f40-bbb3-637618843569\",\"review_text\":\"Why my dowloaded songs gets deleted and keeps on dowloading again and then again gets deleted. Fix it.\"}]}"
