        "content": "{\"reviews\":[{\"review_id\":\"f3111e23-5a71-45d2-af75-d1f19595759d\",\"review_text\":\"i hate this application\"},{\"review_id\":\"6776233d-55bf-4279-9360-41d2e138dde5\",\"review_text\":\"my downloaded songs are not playing offline after a day or two of downloading\"},{\"review_id\":\"0c08caa4-3d18-4cbd-9d08-0d1227432afd\",\"review_text\":\"It's good but too much ad\"},{\"review_id\":\"67b210a0-7a9c-4ef5-ab75-06ed9bf7bb4d\",\"review_text\":\"Songs are disappeared\"},{\"review_id\":\"41c8a7cd-7297-432a-8de9-d69003f17116\",\"review_text\":\"I love how easy it is to make playlists!\"},{\"review_id\":\"f4005b4b-057d-4785-9627-f450eb913917\",\"review_text\":\"Hate this app not Download please brothers\"},{\"review_id\":\"7d8ce1cc-1b03-42e5-bd53-f6e89679a687\",\"review_text\":\"Why do we need to pay for every thing 😔 That's too much I mean I can't even see the lyrics. Like seriously....... It was way better before the update.\"},{\"review_id\":\"7dca62ce-3cd0-4421-bd7f-9f545f254a9e\",\"review_text\":\"😡🤬\"},{\"review_id\":\"302e0462-d63e-45b7-bc2c-a31252541955\",\"review_text\":\"Greedy as hell\"},{\"review_id\":\"48a33ded-2772-485b-9402-9e27b6c2054c\",\"review_text\":\"^This is the proper way to have a pay wall system. Great app and doesn't have any problems. Still using it after all these years. Absolutely would recommend\"}]}"
