        "content": "{\"reviews\":[{\"review_id\":\"56af0f5d-4901-47e0-aad1-fcb5d767b83a\",\"review_text\":\"Still new n learning yo use the app\"},{\"review_id\":\"a4e3d3fb-aca6-4466-a30b-09d7a970e2f0\",\"review_text\":\"Everything was good but after update I'm gonna delete this app,we can skip song can't select particular songs to play i mean this app only want your money so you've to buy theire primium any how and this is very stressful this app suks nowww, gonna delete it.. don't want to give atleast one Star this app deserve minus stars after this update\"},{\"review_id\":\"c692e209-80e7-4d48-977d-09a24fc3e95b\",\"review_text\":\"worst music platform ever!\"},{\"review_id\":\"d09c3006-d00b-4f45-a87c-29bb6c3ff537\",\"review_text\":\"Currently spotify is being very annoyed due to its premium plan i can't able to enjoy my songs not giving lyrics in it right now i can't enjoy spotify 😑\"},{\"review_id\":\"dafe137f-986a-4dbe-8a9f-f32e5c283d2b\",\"review_text\":\"New update has been horrible. App crashes mid song and then will not let me reload the current playlist, makes me select a other playlist. Excessive amount of ads too. Considering YouTube music instead.\"},{\"review_id\":\"6fafb24b-41f5-497d-9e55-7359540af137\",\"review_text\":\"The best customized Playlist options\"},{\"review_id\":\"66b7c16d-2a17-4128-9977-07452c7c4d84\",\"review_text\":\"Tried the app for the very first time and already annoyed that the most basic functionality of keeping the music on repeat is not there.\"},{\"review_id\":\"350358c4-5edd-43ed-bdf0-c2c9015a822c\",\"review_text\":\"Oombiye app\"},{\"review_id\":\"04affadf-4c64-4a3f-ab60-0544687e9231\",\"review_text\":\"🏃🏃\"},{\"review_id\":\"f7969a68-80f4-4501-977e-875d4c1b9874\",\"review_text\":\"Excellent Personalized Music Service\"}]}"
