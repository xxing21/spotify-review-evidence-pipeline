        "content": "{\"reviews\":[{\"review_id\":\"842c562a-83e4-43b2-b9f9-7d41303e5b3e\",\"review_text\":\"Nice Easy to use\"},{\"review_id\":\"0eef82ff-8412-4f4a-a317-c8004ffbb911\",\"review_text\":\"I never thought i was so simple to listen to any genre that you like to thousands and of many more music and new releases\"},{\"review_id\":\"f052118d-3258-4fb1-8f11-75bf286fb273\",\"review_text\":\"I am loving it\"},{\"review_id\":\"092999d4-d5ae-4a15-b50d-57345a4358ee\",\"review_text\":\"just narrow down the ads and it'd acc good again\"},{\"review_id\":\"88b65094-b177-494c-b3cd-411c9f10cbf0\",\"review_text\":\"New update is Unless for app it is newerk issue and hang this app\"},{\"review_id\":\"e67f1dd3-8e1f-46b4-9947-4aa189d1deee\",\"review_text\":\"Always has the song I'm looking for\"},{\"review_id\":\"d7faad34-bcb9-44ad-965d-0615f46c6b30\",\"review_text\":\"Just damn worst\"},{\"review_id\":\"060cace3-7c6f-459d-bc55-918a577d4f5f\",\"review_text\":\"Ads are obnoxious. Adds songs to your playlist for you. Doesn't let you accidentally add the same song twice though, has most music, and a good shuffle feature. Mostly good.\"},{\"review_id\":\"3d169a4d-6c1e-4797-b320-13faa8e07cda\",\"review_text\":\"Add more famous songs\"},{\"review_id\":\"683db855-6f3e-411c-9ee4-a626c3009a50\",\"review_text\":\"T 6ef\"}]}"
