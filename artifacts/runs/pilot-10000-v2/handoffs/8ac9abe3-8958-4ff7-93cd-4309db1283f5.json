        "content": "{\"reviews\":[{\"review_id\":\"8d99a0c7-556f-4342-87a3-8801d12217ce\",\"review_text\":\"L app L county\"},{\"review_id\":\"2508fab7-231f-42c7-a2d4-879811cabdcf\",\"review_text\":\"We cannot go back to a song in a playlist as there's no back button and there is no forward or backward scrolling in the song and crashes suddenly\"},{\"review_id\":\"081f0404-1dcb-4506-9356-ab40d57d36cf\",\"review_text\":\"Fufu\"},{\"review_id\":\"0bf88d28-837a-460d-98ce-791f11e897d6\",\"review_text\":\"Very Very bad app dot install 🙏 full add\"},{\"review_id\":\"5f7378d3-bd35-4118-a2f8-545fa412553e\",\"review_text\":\"The only way I listen to podcasts. Easy to use and a great audio app.\"},{\"review_id\":\"a95785e5-c8c8-4f59-8c9c-40ea0c424e7c\",\"review_text\":\"Likhon\"},{\"review_id\":\"36593995-5705-4f97-98a6-93cf6e317072\",\"review_text\":\"😊😊😊😀😀😀\"},{\"review_id\":\"f1aae5bf-0a54-41cb-867f-67311190cc52\",\"review_text\":\"Recently update. Full of changes you can't play your fav. Song. You get only 6 skips song per day. You can't play any song.. Very very disappointed from this. To play your fav song you have to buy premium. Very very useless app 😒😒😒\"},{\"review_id\":\"1a9e758c-9098-404c-a8a6-c7ae9536a874\",\"review_text\":\"quite annoying these days atleast stop playing that ad -\\\" I feel good \\\", its the worst to hear.\"},{\"review_id\":\"e44cd490-22ab-47d3-b186-9a92915f3329\",\"review_text\":\"Febuless\"}]}"
