        "content": "{\"reviews\":[{\"review_id\":\"f2f39dbe-6bf7-4047-82ca-8c30bf6b3389\",\"review_text\":\"I love you\"},{\"review_id\":\"5a9cdb39-e47b-4a8b-b706-990ad87b7125\",\"review_text\":\"It makes it easier to listen to music so i give it 5stars\"},{\"review_id\":\"2039f11b-2501-4b0e-9816-46804bc37759\",\"review_text\":\"Great deal. All my music when ever I want it.\"},{\"review_id\":\"3c683dc0-ed4a-4fe8-9b85-128c26b764c3\",\"review_text\":\"I like very much\"},{\"review_id\":\"e9475613-3f39-48b1-8a58-cd176224af26\",\"review_text\":\"Worst update.. keep your app with you.. I'm moving to Amazon Prime Music\"},{\"review_id\":\"98a40dfe-f60e-46d3-b8d3-54c1a0101c78\",\"review_text\":\"After recent update you cannot que your favy songs and even cannot listen to a specific part without premium\"},{\"review_id\":\"94032ad7-ca92-44a4-b974-be8de88af527\",\"review_text\":\"This app has disappointed us. Like all basic features of a music app has changed to premium. I've uninstalled Spotify.👎\"},{\"review_id\":\"f957d8bc-b880-47dc-89a4-a6a6e4060345\",\"review_text\":\"Super ❤️❤️❤️🇮🇳\"},{\"review_id\":\"e73bec95-8a6b-4c43-956a-e5460b5fea60\",\"review_text\":\"very bad appp guys don't instal this app and decrease it's rating\"},{\"review_id\":\"02ac4fe7-7b95-4ef5-808a-e0da76d5a0ab\",\"review_text\":\"Amazing. Ima be honest, I haven't used anything but premium almost from the get-go so I don't remember what it's like without it. I love that they can give people a platform when they didn't have one before\"}]}"
