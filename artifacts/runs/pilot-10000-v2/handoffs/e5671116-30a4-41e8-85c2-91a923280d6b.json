        "content": "{\"reviews\":[{\"review_id\":\"1c4d38cb-9e3f-4f46-99d4-9b4d4880492f\",\"review_text\":\"I'm not too sure what happened, but it completely stopped working!\"},{\"review_id\":\"434e01e7-dc17-42cd-b9c3-60ed4436c0c4\",\"review_text\":\"Best streaming app on planet earth!\"},{\"review_id\":\"0629557c-88ef-4032-beaa-399ef427cf6c\",\"review_text\":\"This is a well amazing music app. I like how it can be played even when the app is still open but you come out of it to play a game it can still play but it sucks that you need premium to listen to the songs when your actually offline\"},{\"review_id\":\"a788da91-be9f-4db5-b7d3-4a1c157e7dc5\",\"review_text\":\"Too many ads.....but I like it anyway.\"},{\"review_id\":\"e68c1158-ab97-480d-9018-bf7d23c31e1a\",\"review_text\":\"jkju\"},{\"review_id\":\"0bdb6da4-2ad4-4c9b-9dd4-33c902a6c8ac\",\"review_text\":\"MY FAVOURITE SONG PLAYER ❤️\"},{\"review_id\":\"c1244074-0568-4ed2-a8f8-92122d0d46bb\",\"review_text\":\"Smooth experience only challenge is not able to identify original or remix\"},{\"review_id\":\"3d1266fe-159f-43bb-b27e-5dde6108e318\",\"review_text\":\"Brilliant app ,add free\"},{\"review_id\":\"bc671a9e-dac8-4399-9d7b-1127773b6b28\",\"review_text\":\"I had the best musical I didn't listened before I'm really happy\"},{\"review_id\":\"9bcbec2d-690f-417f-a133-8708f83d4bda\",\"review_text\":\"Your app is nonsense i cant even see the inside of this app even after updating this app this app lack a lot of things inside\"}]}"
