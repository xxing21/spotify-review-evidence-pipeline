        "content": "{\"reviews\":[{\"review_id\":\"2799a14a-639f-4af7-a264-ad6424cc2491\",\"review_text\":\"The music is great\"},{\"review_id\":\"c62dd87f-64b2-413b-9d43-0b68fb6f51af\",\"review_text\":\"Annoying!! You are cutting off some of the basic features just to make us take the premium.\"},{\"review_id\":\"73ee19a4-389d-4986-a22c-dc467cfa9b39\",\"review_text\":\"Nice selection of songs.\"},{\"review_id\":\"7a72d206-c565-49b4-be12-c6a1a992796c\",\"review_text\":\"I love this app🍓🎉🎉\"},{\"review_id\":\"18957a33-baf8-4b02-8b0f-cf01ea2eb62a\",\"review_text\":\"Horrible new home page layout!! We should be able to choose what we want on OUR home page!! Not you forcing us to look at what you want. I pay for this service.\"},{\"review_id\":\"6dfc27ea-dc74-4a88-a67e-99d9554063ef\",\"review_text\":\"Asks for Bluetooth permission every start. Impossible to sort lists.\"},{\"review_id\":\"c5053d5f-50d3-4455-8c10-e6a2a190db5c\",\"review_text\":\"Ford aap i request band this aap\"},{\"review_id\":\"b4dad39e-3eaa-4f02-8f07-d0a08ccfc263\",\"review_text\":\"I recommend Spotify for music on the go. If you wanna have your best tunes with you always, Spotify is the way to go.\"},{\"review_id\":\"818a84a2-6e60-40d1-80bf-cdb1bf00db5c\",\"review_text\":\"Best app for listening music but sometimes i used to get irritated because of too much advertisements.\"},{\"review_id\":\"3fc43286-6034-42a7-bd27-bcec46398101\",\"review_text\":\"I like it and will continue to be a subscriber\"}]}"
