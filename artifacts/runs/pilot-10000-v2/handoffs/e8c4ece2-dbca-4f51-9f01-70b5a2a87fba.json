        "content": "{\"reviews\":[{\"review_id\":\"58e905d0-1e18-4617-a3ee-874587e256c4\",\"review_text\":\"Perfect 100%\"},{\"review_id\":\"949eb6d0-d1d3-4e38-8d58-65d7fe805b3a\",\"review_text\":\"Ads are fine but please, please let me choose a song\"},{\"review_id\":\"55d65fcf-1af4-492e-863c-0854ec809a08\",\"review_text\":\"Boycott Sweden Apps\"},{\"review_id\":\"e7a5a1dc-389b-4146-9089-36d111aed87a\",\"review_text\":\"I like this app so badly\"},{\"review_id\":\"2387c109-f937-4fbe-8ca1-8bc72aad669a\",\"review_text\":\"Fantastic!\"},{\"review_id\":\"426de57a-b0d9-4e78-963b-631f8cc21532\",\"review_text\":\"I like it\"},{\"review_id\":\"cee2f8aa-272f-41af-ab18-535e3d58c384\",\"review_text\":\"Excellent app if you're a music lover. I especially love that I can access worldwide music and get to find new sounds. Great interaction with friends and love the playlists. It's also opened up a new world of podcast to me. I recommend the subscription to get rid of ads and interruptions and enablingvlistening offline\"},{\"review_id\":\"96e4815f-97f7-40f6-bfdd-814e3ec1ddca\",\"review_text\":\"Great app for online listening music.... playlists are amazing....music quality is very pure\"},{\"review_id\":\"f9f682f6-25e5-492c-80f8-4faca910f53b\",\"review_text\":\"Love the music. The ads in Spanish are horrible. I don't speak Spanish, so I have no idea what they're selling.\"},{\"review_id\":\"9a73aeb4-f2fc-4b23-a6c8-07c8826e1b01\",\"review_text\":\"This app is worst music listening app it has a policy that if you want to listen one song than it is mandatory that you have to listen it's two publicity ads first after every song...\"}]}"
