        "content": "{\"reviews\":[{\"review_id\":\"cc19d8c2-17d2-4427-a292-5d00b5b60852\",\"review_text\":\"Mind blowing ☺️☺️\"},{\"review_id\":\"94de1e58-17fe-481a-aa69-2514ce2efb40\",\"review_text\":\"Nice 👍👍🙂👍\"},{\"review_id\":\"f7ff212c-61e6-41b8-a2bd-ad131f3fbd91\",\"review_text\":\"all the playlists are empty\"},{\"review_id\":\"df821236-8d67-4fc7-b02e-90202f98b2d4\",\"review_text\":\"Nyc app\"},{\"review_id\":\"bb1a2c3c-0897-4493-9745-9e538a3a1fa9\",\"review_text\":\"Always been buggy. On the family plan, a few times a week it jumps to my daughter's playlists. Right now it defaulted to her speaker. Recommendations are for her. Last week while driving alone, stopped my music and played hers then wouldn't play myusic until I closed it. Tech support is non existent. And figure out my sleep music shouldn't be a part of recommended.\"},{\"review_id\":\"5c040a2f-63a8-4db1-9be7-89eb4b2c300f\",\"review_text\":\"V good\"},{\"review_id\":\"255cd674-8fe1-4ecd-9954-222b56acc43e\",\"review_text\":\"Nice app 👍 🙂\"},{\"review_id\":\"d4a15daf-54e2-47f4-8ffe-cdf7b96f4ee9\",\"review_text\":\"Nice👍👏😊 song s\"},{\"review_id\":\"171e7d5e-47ff-449c-950f-24beca30ab76\",\"review_text\":\"Good content and easy to access\"},{\"review_id\":\"307813b6-eb60-4fca-aa55-913f00f5e022\",\"review_text\":\"Nice I personally love it✨\"}]}"
