        "content": "{\"reviews\":[{\"review_id\":\"9b206229-ebdb-446f-9f8c-c4f17663a0f8\",\"review_text\":\"The most beautiful music app I've ever used\"},{\"review_id\":\"7bcfcf15-265b-4c3b-afa7-b0b2930e61dc\",\"review_text\":\"Spotify is worse now\"},{\"review_id\":\"40243cf8-0149-4f05-9308-08abdb27e4d6\",\"review_text\":\"Very bad for musicians😡🤬\"},{\"review_id\":\"21a61c5c-2892-4bb9-ae25-536b77727d1d\",\"review_text\":\"Use it everyday!\"},{\"review_id\":\"090dd1b0-a166-4f3a-954c-4f535fea4649\",\"review_text\":\"You can't even listen to a specific song unless you pay every playlist and album is shuffled and you can't pick what one you wanna listen to without paying the 10 dollars a month maybe make stuff like that not blocked by a pay wall\"},{\"review_id\":\"885018bf-1829-40fa-8ac8-016d0ec83377\",\"review_text\":\"World for music lovers\"},{\"review_id\":\"b694023c-021d-4974-96b7-f25f35f1eca4\",\"review_text\":\"Thank you for Nepali song added\"},{\"review_id\":\"a835c23b-3e27-493c-a9df-1a9b5ee04f09\",\"review_text\":\"I paid for the ad free but there's ad's\"},{\"review_id\":\"81a94fdb-e93a-40ad-81ae-b96e6c49a145\",\"review_text\":\"Way too many ads... forcing us to purchase premium\"},{\"review_id\":\"2e57601f-5eaa-488c-a603-c5dda325522a\",\"review_text\":\"This app is amazing and it always calms me down and helps me when i am stressed\"}]}"
