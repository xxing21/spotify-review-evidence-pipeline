        "content": "{\"reviews\":[{\"review_id\":\"6c5f5e2b-781d-465f-a409-0ac4daebccfe\",\"review_text\":\"😡😡😡😡😡😡😡😡\"},{\"review_id\":\"85cbf393-19d0-4303-961b-a5fec30b63c3\",\"review_text\":\"It was such a good app bht now it has become the worst music playing app. Who the hell asks for premium for even changing songs\"},{\"review_id\":\"32aa399c-bef2-411f-9d4d-776db0c2c704\",\"review_text\":\"Can't play songs Doesn't show my created playlists even after logging in multiple times\"},{\"review_id\":\"4c1a0065-923a-4bc7-9a41-b34598ea1937\",\"review_text\":\"Have had Spotify Family Premium for over a decade and we have recently started getting pop ups. Most annoying! Might be tempted to change to another provider as a result.\"},{\"review_id\":\"c52b4394-74af-4a88-9bd6-0d81dab33305\",\"review_text\":\"the app won't let me login with my number even though I'm entering the correct number please help\"},{\"review_id\":\"b5f7c57e-58b4-416d-ba02-0b7399ed3149\",\"review_text\":\"I give only 2 stars only for clarity there are many Ads in it.it's make uncomfort at night becoz usually I'm hearing song in this app for sleeping I felt asleep suddenly wake up becoz of this ads plz avoid tha ads atleast at night 🥴🥴\"},{\"review_id\":\"4490658d-4588-4428-aa92-9211f3d69a42\",\"review_text\":\"It is beacoming worse to use ot for free they are decreasing the quality until you buy premium...... now i am uninstalling this app now....\"},{\"review_id\":\"4a93b23e-fea8-4842-99ce-dd2f53c0f392\",\"review_text\":\"Hate it 👎\"},{\"review_id\":\"c658516b-3ee5-4d0b-bbbd-825a79155d86\",\"review_text\":\"New update is worst\"},{\"review_id\":\"f3ce02f5-229a-4658-9be9-6c292408993a\",\"review_text\":\"Very nice.\"}]}"
