        "content": "{\"reviews\":[{\"review_id\":\"ff0217f6-9473-404b-83da-56c1fd4ac8aa\",\"review_text\":\"I like this app 😘\"},{\"review_id\":\"fbdf5f23-c999-4f9e-bbb7-507a55d226b8\",\"review_text\":\"Too much ads other apps better\"},{\"review_id\":\"9f29c862-80cb-4e3c-9643-b8a9a5f515a2\",\"review_text\":\"Because so bad 😔\"},{\"review_id\":\"350925d7-2e51-481a-8c53-15c82dbf7480\",\"review_text\":\"Girl fr I love ur app, but can you please please pleaseee put the lyrics on when I cast it on our TV so that I can do a little karaoke 😭 And I also love that u have this once in a while creative playlist u help me make 💗 Hope y'all have a Merry New Year ✨ Keep slayinnnnn 💅✨\"},{\"review_id\":\"04afd9e2-8f9c-4a02-8b46-e01b2d5e2c51\",\"review_text\":\"Though they defo don't give you 30 minutes clean for watching an ad I can't complain bc I'm cheap, so pretty good overall 👍\"},{\"review_id\":\"70a1c30c-f625-4d57-a1ad-9bf5f049e1d9\",\"review_text\":\"This app is very unstable after the recent update It keeps lagging and crashes my device\"},{\"review_id\":\"8421e1a7-4618-46d1-bec3-80dfcd19a6e0\",\"review_text\":\"6 adds in a row all 30 seconds long because I did not want to buy the premium? Do better:|\"},{\"review_id\":\"68d3cba0-e754-46c1-acc4-576b7a06349c\",\"review_text\":\"This is a cool app to listen to music and make ur own playlists\"},{\"review_id\":\"a0b7082c-7240-4bbe-90e2-1221067427d6\",\"review_text\":\"Its a good music app...but your favorite martion is not avilibal without premium\"},{\"review_id\":\"d84c3d16-81be-4d49-8585-82f73e1691c5\",\"review_text\":\"Used to be best music app, now it's the worst. Features that are available in pretty much any music playing application is now only available in Spotify for premium users. I've switched to a different app alteady\"}]}"
