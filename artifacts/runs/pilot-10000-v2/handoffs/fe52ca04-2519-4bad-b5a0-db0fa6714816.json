        "content": "{\"reviews\":[{\"review_id\":\"3e3b92ef-dc95-4ddd-97e4-5b992c60db26\",\"review_text\":\"Too many ads can't play songs properly\"},{\"review_id\":\"4b4a312d-45fb-4122-bf3f-08c3c1cad049\",\"review_text\":\"Pretty good and has a lot of music to choose from compared to Apple Music.\"},{\"review_id\":\"8d767e0d-8f4f-404d-bc3b-379b5e6a51a7\",\"review_text\":\"Worst App !! Used it only for 10 days 😂\"},{\"review_id\":\"55bf4953-a41d-41ce-9542-5df514af43d0\",\"review_text\":\"Best so far 😅👍🏻👍🏻\"},{\"review_id\":\"9af97e15-811e-4604-a441-36cf9c68ffcd\",\"review_text\":\"A very fantastic app I've used 🤩 but the only problem that's found in it it's that I can't loop the songs I kept on my queue so may you please adjust there 😪 and everything will be mwaaa ❤️😅\"},{\"review_id\":\"f60786f2-d16e-47cd-a97b-b5c91bca37d3\",\"review_text\":\"Love music from this app and the way you can listen for free\"},{\"review_id\":\"7b0c1f22-60de-4899-911c-127ea4b0e651\",\"review_text\":\"Playing liked songs are broken.\"},{\"review_id\":\"52e50d81-b02b-4812-9b66-2f6164261b2d\",\"review_text\":\"Most of the time it shows offline even if my internet is on :/\"},{\"review_id\":\"ca510be7-f229-431a-9767-e31993011673\",\"review_text\":\"You can't pick any song you want it puts it on shuffle unless you pay you get limited skips so you is you get a random song you don't like your screwed\"},{\"review_id\":\"7bcf2db2-75f8-4d0a-9912-f8616af0b336\",\"review_text\":\"Stupid update! Hateeeeeee it\"}]}"
