        "content": "{\"reviews\":[{\"review_id\":\"6780c85c-2847-42ba-85d4-ca1780e4f068\",\"review_text\":\"i hate Spotify update app. It's just like changing the whole app. we didn't get to play songs like us.\"},{\"review_id\":\"6b83b768-650c-43c1-ba47-05f14419b7d2\",\"review_text\":\"I tried to play waka waka by Shakira and it would not. It played a complety different song\"},{\"review_id\":\"4cb86d8e-9a86-4b83-a98e-9793549c698e\",\"review_text\":\"It doesn't let you play the songs that you pick last update it did\"},{\"review_id\":\"dd63f13f-ce4f-4869-9ea5-6f27136c4cf1\",\"review_text\":\"⚡⚡\"},{\"review_id\":\"158760c3-9b6d-494a-8755-dcc43c7dbdf5\",\"review_text\":\"Super amma\"},{\"review_id\":\"3afbaeb9-c468-4c83-8efb-0ca4acc69e4f\",\"review_text\":\"10/10 Awesome\"},{\"review_id\":\"db693ad1-7e8c-422e-93b4-937ec1c3a4f5\",\"review_text\":\"Very good for Music\"},{\"review_id\":\"863f20bd-acc2-47bc-a6b3-0a7519d6d221\",\"review_text\":\"Premium is way overpriced and the free version is absolutely saturated with adds. I recommend listening to the radio more than downloading this app.\"},{\"review_id\":\"441030e1-faa5-4ef9-8338-c771399951e2\",\"review_text\":\"You name a song it's on Spotify\"},{\"review_id\":\"b66592e1-60d6-4bd5-8e08-ba98fa7a7d0a\",\"review_text\":\"Lots of ads\"}]}"
