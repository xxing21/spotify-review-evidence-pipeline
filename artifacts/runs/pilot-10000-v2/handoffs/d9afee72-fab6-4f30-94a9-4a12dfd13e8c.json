        "content": "{\"reviews\":[{\"review_id\":\"d2041557-c376-411d-b016-58596afa68c5\",\"review_text\":\"Spotify for life.\"},{\"review_id\":\"efcae8ec-b052-455d-9e21-87ca104c0af7\",\"review_text\":\"Don't install this app\"},{\"review_id\":\"56b40f39-4e5d-4542-a7d7-b63408627519\",\"review_text\":\"I think spotify just need to hire a punjabi employee to right a perfect punjabi lyrics for punjabi songs then it will be excillent as there are many listener who wants to sing a song while listening as me 😁. I just noticed that there are many wrong lyrics over there. Overall it is good app\"},{\"review_id\":\"982c3b8c-ee10-40d3-9a72-5c2a82665a05\",\"review_text\":\"Why shuffle and no playback control\"},{\"review_id\":\"3df00649-7a30-49ad-b5cf-1cad359240bd\",\"review_text\":\"New update makes it disable a lot of features\"},{\"review_id\":\"adbbafb7-642d-4335-87c5-9406b946411f\",\"review_text\":\"Great list of songs\"},{\"review_id\":\"71776573-1025-44f0-bb96-ee777d784d5a\",\"review_text\":\"Spotify started showing its colour this app was good but now it is changed\"},{\"review_id\":\"159b3543-d37f-45ef-b961-129bb5a78a68\",\"review_text\":\"Epic fantasy\"},{\"review_id\":\"331451b2-4596-4aa1-bcf9-31c47124249a\",\"review_text\":\"Beautiful Songs. I like it\"},{\"review_id\":\"e86f3876-a0ea-4dff-907c-8b2922c53128\",\"review_text\":\"Overall fantastic service their library of genres is phenomenal\"}]}"
