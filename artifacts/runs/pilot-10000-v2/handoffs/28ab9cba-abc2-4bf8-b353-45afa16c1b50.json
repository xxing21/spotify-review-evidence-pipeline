        "content": "{\"reviews\":[{\"review_id\":\"87713c79-5d4c-4948-8dab-4a6ab1ea1ec2\",\"review_text\":\"Best music service ever.\"},{\"review_id\":\"7a824d6b-d4cf-4a3d-8fd5-eef2f40108a3\",\"review_text\":\"Bakwas\"},{\"review_id\":\"ba8acd84-a311-46e6-a2bb-406bdfdcc58f\",\"review_text\":\"They made the app even worse\"},{\"review_id\":\"eb358010-b2e1-497c-aa8f-716b26075834\",\"review_text\":\"This app gets worse after each update\"},{\"review_id\":\"4e0f1fa5-2d31-45ad-bcf5-afa73fc51f21\",\"review_text\":\"I Love Spotify premium so I do not get any ads and I love that they make a daily mix that is really good.\"},{\"review_id\":\"6263d7a9-a576-4005-b2f1-f863610ada44\",\"review_text\":\"I can't use it in iran\"},{\"review_id\":\"bf49fdea-abb6-4d93-bd14-8fb4e60e107c\",\"review_text\":\"This app now cannot let me play middle past of song. Dispointing\"},{\"review_id\":\"6293e177-4339-4c24-a09b-6ab363e607f3\",\"review_text\":\"LATEST UPDATE BROKE THE APP. ONLY PLAYS ONE SONG THEN STOPS. Constantly needing to open the app and select another song despite being a Playlist, on shuffle, on repeat. What Is the deal ???!!!\"},{\"review_id\":\"426f9d43-4738-4fef-a317-becbe251bb54\",\"review_text\":\"it's perfect. Whenever ur using head phones.\"},{\"review_id\":\"9483215d-f162-4f30-b042-ba6dfccc5616\",\"review_text\":\"taktahu\"}]}"
