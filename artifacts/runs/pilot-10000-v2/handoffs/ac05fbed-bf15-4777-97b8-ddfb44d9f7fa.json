        "content": "{\"reviews\":[{\"review_id\":\"bc419a71-f97e-4971-9c50-99fed872895c\",\"review_text\":\"Hate this application. Swedan crossed the limit. I like Islam\"},{\"review_id\":\"9b9f4d2c-16fa-4bff-b12b-55a50a0bcb94\",\"review_text\":\"I LOVE IT SO MUCH!\"},{\"review_id\":\"a101f272-bd3d-49cb-9dda-ad61c623c8d8\",\"review_text\":\"I love hearing music and I had to here my favorite song over and over again\"},{\"review_id\":\"957dd8c7-4db7-4d86-9a1f-bd6c178e97f6\",\"review_text\":\"Tried to subscribe to Premium but they keep telling me that I'm not elligible even though I've never tried the 1 free month on this account. Really disapointing.\"},{\"review_id\":\"31362afa-9422-4810-9362-5f744f4ba524\",\"review_text\":\"සුපිරි 😍❤️ superb ❤️❤️\"},{\"review_id\":\"07997e14-5059-4fbb-adf8-4959f4b3f8e6\",\"review_text\":\"unable to login on spotify.\"},{\"review_id\":\"0534b9a0-715d-4eee-8b59-0a79d9031738\",\"review_text\":\"Impressed\"},{\"review_id\":\"0232d614-b09c-4234-95ae-8be8ba86b4e4\",\"review_text\":\"Absolutley love Spotify. So easy to use and find all of the songs I like. Definitley worth the $10 a month.\"},{\"review_id\":\"98b70953-0480-460a-b24c-0f13678a67ce\",\"review_text\":\"Enjoying the smooth jazz.\"},{\"review_id\":\"c5382aef-58f5-4253-8abd-493a1cca7b9c\",\"review_text\":\"Very nice!! Sorta glitchy at times and it can be frustrating but it's nice\"}]}"
