        "content": "{\"reviews\":[{\"review_id\":\"40e12885-99f6-454d-abcb-3df755089b7d\",\"review_text\":\"Wow awesome, good quality. Music is my soul... Premium is the best, try it!\"},{\"review_id\":\"a5be1ca2-9ec5-41eb-beed-0a464213d209\",\"review_text\":\"Spotify is the best thing ever to happen to music listeners worldwide.\"},{\"review_id\":\"fa1c14be-a1cb-42a0-8b5e-aafb25f2ce52\",\"review_text\":\"This is so wonderful creation app\"},{\"review_id\":\"3a6481bb-c892-4b3e-aaa4-6a7a8fdcebc2\",\"review_text\":\"i love it, thanks for music.\"},{\"review_id\":\"8f780688-cbf8-476d-bca9-0261b0a5766a\",\"review_text\":\"bad application\"},{\"review_id\":\"a997224a-7e47-471e-a808-4cbd15ecaeb8\",\"review_text\":\"top quality, top music, top artists, top algorithms, top app👌👌👌💯💯💯🎧🎧🎧 (if u have premium) free version is utterely rubbish otherwise, cant skip songs cant look at lyrics lots of ads especially about premium after literally every song\"},{\"review_id\":\"d0e849ca-2d53-40b0-a4d3-0b6f38f12584\",\"review_text\":\"Wow\"},{\"review_id\":\"53c76f61-ad2e-4b2a-84e1-0151b6201cc1\",\"review_text\":\"mobile free sucks but premium is awesome\"},{\"review_id\":\"b0b81704-45ad-43f6-9e69-617ff33d5d7b\",\"review_text\":\"My phone disconnects from one phone to another not being able to hold my Bluetooth option connecting to random phones\"},{\"review_id\":\"7cbb7280-0009-48b9-a529-852996997d94\",\"review_text\":\"OMG we hear 2 ads after listening one song iritating\"}]}"
