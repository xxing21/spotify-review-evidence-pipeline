        "content": "{\"reviews\":[{\"review_id\":\"50a0b897-9f87-4273-9586-7f09b60ea668\",\"review_text\":\"My whole family use this app.\"},{\"review_id\":\"36b21118-517e-401b-95a7-7e8200359f7a\",\"review_text\":\"Boycot sewedan\"},{\"review_id\":\"8a2542ac-8686-43a9-beb1-aea9586917a1\",\"review_text\":\"I have a good experience 😌 I like it\"},{\"review_id\":\"41d56bc8-4fec-4808-97e6-aaf65a097fe5\",\"review_text\":\"Love the new ai DJ but definitely need the option to change the voice. Some different voice options would be definitely 5 star\"},{\"review_id\":\"d28e7b1e-3aa3-404e-aedd-dc2ccf207cca\",\"review_text\":\"Wrost app\"},{\"review_id\":\"eec5eef1-0e86-458e-949a-8a066a5a7c46\",\"review_text\":\"WENT FROM A GREAT APP TO THE WORST APP EVER\"},{\"review_id\":\"a253b1e0-ef22-4309-b02b-ca9265c532d9\",\"review_text\":\"It works, but i cant choose what to play unless i pay for premium, use an alternative if you dont want to pay.\"},{\"review_id\":\"dcd431dc-eb7d-4e28-bc3e-88b76bff8c36\",\"review_text\":\"this app sucks now, the new update ruined everything. this was the best listening platform but now you can't even listen to the same song because it requires premium -_-\"},{\"review_id\":\"938fabce-30d2-48d2-b5b4-b8cfdcaee04d\",\"review_text\":\"Band kro band kro 🙏\"},{\"review_id\":\"3cfd9749-c8ec-4923-bd06-5eaa4a0e51f4\",\"review_text\":\"All most everything you would want to listen too!\"}]}"
