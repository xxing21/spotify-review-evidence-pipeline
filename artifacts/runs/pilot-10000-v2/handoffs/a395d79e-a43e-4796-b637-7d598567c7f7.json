        "content": "{\"reviews\":[{\"review_id\":\"34e4d6df-9687-4eb2-9d12-70543687ea8c\",\"review_text\":\"Enjoy on the music on there easy to use\"},{\"review_id\":\"c6c71fc5-accb-4c8e-9dda-e298bdb9e094\",\"review_text\":\"An Irritating application I have ever used\"},{\"review_id\":\"789c939c-be54-43c6-825f-17af09f609e8\",\"review_text\":\"Great, but Spotify free pretty underwhelming\"},{\"review_id\":\"e580377e-cf70-427b-959c-405d5f092ab9\",\"review_text\":\"Good experience\"},{\"review_id\":\"077fbf8e-f439-49b1-8c40-c23d50796371\",\"review_text\":\"I fux w/Spotify\"},{\"review_id\":\"28c5e28e-0985-4e3a-acba-4f827124560d\",\"review_text\":\"Worst experience, even to play a song you need to take premium, even the playlist had no meaning,even giving one star isn't worth , YouTube is better\"},{\"review_id\":\"fa1150c5-ff72-48e1-a0d7-5777f4b257c6\",\"review_text\":\"I like this app for song's...i love it...🥰\"},{\"review_id\":\"12b0406d-1623-4849-83ba-084bd7814449\",\"review_text\":\"The quality of recommendations keeps going down. They don't even have lossless audio.\"},{\"review_id\":\"d5e6c5da-d95e-402c-913c-ad1a10281991\",\"review_text\":\"I love Premium but $10/month is way too expensive considering Sirius is like $5/month. If Premium was $5/month like Sirius it would be absolutely worth it!!\"},{\"review_id\":\"e09d1e41-dba8-41c4-a025-648e4e382d53\",\"review_text\":\"I love this service\"}]}"
