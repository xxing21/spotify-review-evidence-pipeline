        "content": "{\"reviews\":[{\"review_id\":\"515a4fef-45be-478d-be68-9c84b312043c\",\"review_text\":\"But how can we share our own liked song albums\"},{\"review_id\":\"c4a37e9e-769b-4cb0-82e2-128ddf4014bc\",\"review_text\":\"If I could rate it zero stars I would. It's become just a blatant cash grab, with so many ridiculous restrictions for free users that you'd either have to pay for premium or use a different music app.\"},{\"review_id\":\"13f38d79-10de-42ba-afaa-5a77b107c583\",\"review_text\":\"Yo! All i can say is this app is lit lit lit💖\"},{\"review_id\":\"b0eb09bc-56c6-411c-82b3-4c0a6a98080d\",\"review_text\":\"It's awesome 👌\"},{\"review_id\":\"b094e805-6839-4b91-8b14-0904d9c93ad7\",\"review_text\":\"I can't log in to this app somebody help me\"},{\"review_id\":\"7e89cd90-fac4-438d-8cbf-1a3fa1530da3\",\"review_text\":\"This is a legendary music app\"},{\"review_id\":\"c7101a30-63ec-49c4-af65-1dcc34de394b\",\"review_text\":\"Because the app doesn't play song with out premium 🤬😡\"},{\"review_id\":\"28df7699-4354-4771-9f90-fe38d157ad27\",\"review_text\":\"I can't login my old Spotify account my phone number is also correct but Spotify show error and don't send OTP\"},{\"review_id\":\"445386d9-40a9-4c37-920e-dd559c5c5ad8\",\"review_text\":\"Gatiya app\"},{\"review_id\":\"737d408a-8c56-4509-8944-ad73e0376a03\",\"review_text\":\"Bycote this app i get too problems from this\"}]}"
