        "content": "{\"reviews\":[{\"review_id\":\"1904a093-2e86-43d0-977b-b8cdc513cbf3\",\"review_text\":\"I love this app but sometimes the song keeps stop playing\"},{\"review_id\":\"8d385094-a90e-4102-b1e6-f8956763d8dc\",\"review_text\":\"Pleasee. Lessen down the adsssss\"},{\"review_id\":\"2c31fa31-7550-42b8-90cf-f84044288326\",\"review_text\":\"The ads are becoming unbearable. unskipable ads after every one or two songs is just ridiculous\"},{\"review_id\":\"f487b486-4a5c-4610-b345-9f6608aba1ca\",\"review_text\":\"I enjoy it alot, great music\"},{\"review_id\":\"2c9b8405-2667-44f7-a3e3-87cbef6d5a1d\",\"review_text\":\"Great to stream just what I want, whenever I want\"},{\"review_id\":\"7e0f5566-f38e-4bcf-b050-4cfb0f1ea8c7\",\"review_text\":\"The spotify shuffle button is only a play button and no longer shuffles when i press play\"},{\"review_id\":\"198fe4fc-846a-4aa4-93a3-624d43a8158e\",\"review_text\":\"Yeah\"},{\"review_id\":\"25841298-6e32-4bab-bdbe-e9029d7dbd67\",\"review_text\":\"ad ad ad ad ad ad\"},{\"review_id\":\"ad456291-841a-444d-b74f-766500baa2cf\",\"review_text\":\"Bad quality\"},{\"review_id\":\"018253e3-b9bf-4840-bb9b-c74652daf443\",\"review_text\":\"I like this app...but there is big problem for add ..and so on..\"}]}"
