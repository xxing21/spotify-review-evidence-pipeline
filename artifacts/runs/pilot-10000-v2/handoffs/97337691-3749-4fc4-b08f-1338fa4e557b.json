        "content": "{\"reviews\":[{\"review_id\":\"01f0c94a-f470-48ad-b32e-f1801372cf02\",\"review_text\":\"AMAZING great service and music for all generations can't believe it's taken me so long to download.\"},{\"review_id\":\"56bc531e-9531-4f4b-96fb-032fae167132\",\"review_text\":\"Terrible, worst app ever.\"},{\"review_id\":\"e5579b0b-f662-479b-9103-e13d263b9459\",\"review_text\":\"Bad application Volume will jump in / increasing after next song Risk of loss of hearing\"},{\"review_id\":\"2041dabb-6e80-4078-bb1e-efc91b65b79a\",\"review_text\":\"بی بی بی ٹی جی جی v\"},{\"review_id\":\"81e957cd-022e-4991-978c-2f16238acf37\",\"review_text\":\"DJ X is a nice feature. It has helped me discover new artists. Recent changes to the account page make it really easy to manage my account.\"},{\"review_id\":\"cc6b10d2-a4a8-4883-a54b-1889f336e0f1\",\"review_text\":\"Goat\"},{\"review_id\":\"5c880ac0-78ee-4c8d-ad9c-f857bc4c892a\",\"review_text\":\"Awesome 👍👍\"},{\"review_id\":\"f7251c58-fd4b-4b3c-ac18-6c639144cec7\",\"review_text\":\"Obviously the recent app update is the wrost update I have ever scene in this app which was the best music app ever\"},{\"review_id\":\"64ac5469-2380-4ac3-a26c-6b2664e42eb4\",\"review_text\":\"This app is amazing when you're having premium, but horrible by using free.\"},{\"review_id\":\"94de1725-c137-4e50-bda0-99e3cf48fe15\",\"review_text\":\"Very bad ......\"}]}"
