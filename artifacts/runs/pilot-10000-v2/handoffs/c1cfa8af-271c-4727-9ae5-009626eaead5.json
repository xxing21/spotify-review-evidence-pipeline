        "content": "{\"reviews\":[{\"review_id\":\"a0f95cb8-89fa-4c8a-aad0-8c5feee78d26\",\"review_text\":\"Very bad experience 😕\"},{\"review_id\":\"1284b956-7a27-4bf0-b87e-bdfea637fb27\",\"review_text\":\"Nice song as my favorite\"},{\"review_id\":\"62a2357a-534c-4c2f-bf19-4b429c9bbe7b\",\"review_text\":\"3000 love\"},{\"review_id\":\"f0393faa-969b-408a-b76a-3bde06f30a75\",\"review_text\":\"Had a great experience wheather I use free or Premium versions both in Spotify. There are Diverse Genres of music & lots of impressive podcasts available to listen. Also there are Audio books of great authors. Really Spotify is the best place for your all types of audio experiences.\"},{\"review_id\":\"aae4066a-b1ba-48db-9c17-49eae089606a\",\"review_text\":\"Very worst experience as a free user 🤣\"},{\"review_id\":\"21ddfe12-8433-4bad-b0f8-e7f605c056ae\",\"review_text\":\"Collects too much personal information\"},{\"review_id\":\"a4877b5f-514e-4d48-8864-2ace0f85c0c4\",\"review_text\":\"Such a disgusting application 👎👎\"},{\"review_id\":\"b0400d77-55c7-4c23-bebc-4562ef064899\",\"review_text\":\"It a nice play to play music, you can also hear music when the phone is off screen . Love so much and overall love it\"},{\"review_id\":\"11515f5e-f238-4255-8665-b066fed96aab\",\"review_text\":\"Couldn't live without my Spotify, it's that good!\"},{\"review_id\":\"16f48c2b-a7bc-4c14-8901-119cf68bb79a\",\"review_text\":\"I v r 1 1 Pv\"}]}"
