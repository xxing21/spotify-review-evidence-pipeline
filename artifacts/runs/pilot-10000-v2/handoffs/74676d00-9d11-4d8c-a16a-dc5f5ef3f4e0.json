        "content": "{\"reviews\":[{\"review_id\":\"358ff3d3-3028-4ec1-bdc5-832cb188219c\",\"review_text\":\"It's amazing app Mind blowing app\"},{\"review_id\":\"948e1b1c-612e-449e-8edc-b3789642c3d5\",\"review_text\":\"Been using since 2016 and this is by far the best music streaming app.\"},{\"review_id\":\"91d85b28-8960-4fef-aa44-2fed61fd9938\",\"review_text\":\"It's awesome\"},{\"review_id\":\"b1cb613f-189b-45ec-9b8e-d189534ac1a3\",\"review_text\":\"great !\"},{\"review_id\":\"5e547065-0137-48b1-ad95-4db4019b0939\",\"review_text\":\"Best Experience ever to setup a new device. Keep the good work up!\"},{\"review_id\":\"8d050946-462c-4165-bbee-918174694c78\",\"review_text\":\"good, slays, most music ever, goog, :)\"},{\"review_id\":\"e45f5890-b380-4fba-ad43-b7a2f55cba16\",\"review_text\":\"Great options\"},{\"review_id\":\"88313e23-58c0-49ed-be65-1b7dbfd2e88d\",\"review_text\":\"So easy to build playlist: songs and artist very easy to find. I love it❤\"},{\"review_id\":\"d197da5e-97e1-4a54-ae92-f4b43c2d535e\",\"review_text\":\"New update is horrible\"},{\"review_id\":\"a3e53b9e-5f38-4775-b459-e63730f4379d\",\"review_text\":\"Worst music app of century\"}]}"
