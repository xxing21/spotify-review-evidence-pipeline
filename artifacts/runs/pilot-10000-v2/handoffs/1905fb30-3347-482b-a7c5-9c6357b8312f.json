        "content": "{\"reviews\":[{\"review_id\":\"a5defbc4-5d4e-4039-a391-eb64ff3e7813\",\"review_text\":\"It's just the best thing you could use for Music\"},{\"review_id\":\"64692eda-8450-4997-a0ee-093bbc9f5fd4\",\"review_text\":\"Very happy no ads\"},{\"review_id\":\"b4e5935b-3782-4852-8675-f55a0036d100\",\"review_text\":\"Cool, stress less, and satisfying\"},{\"review_id\":\"0767ec86-0d81-4e8a-869b-81622fc01507\",\"review_text\":\"Too much adds...\"},{\"review_id\":\"c9877f19-368d-44ad-925b-8b6e808adf1e\",\"review_text\":\"When your trying to listen to religious song then the ads are about podcast concerning lust and love. A great time to uninstall it. Hate it.\"},{\"review_id\":\"51b63d5b-424c-4109-a2e8-b493c4382681\",\"review_text\":\"Enjoy listening\"},{\"review_id\":\"c4356017-a823-4c4b-b890-ad0ba31a1b33\",\"review_text\":\"Am having an issue the app logged me out and won't log me In on my phone I can log in on browser but not the app or on my ps4 so please what's the issue??? Its been almost a week\"},{\"review_id\":\"50033852-dc1a-4b8a-ab65-dc68f9731d26\",\"review_text\":\"Music selection is great. App quality is great now\"},{\"review_id\":\"7ff18251-04c6-4818-ad3d-ffc12a5dda5a\",\"review_text\":\"Sounds clarity is good, but nowadays adds, and others features irritating 😒😬😏\"},{\"review_id\":\"b136767c-c057-40e5-aaef-4870a9a52457\",\"review_text\":\"I just love this Spotify\"}]}"
