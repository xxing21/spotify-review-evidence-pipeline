        "content": "{\"reviews\":[{\"review_id\":\"4040fe73-aefb-4771-ae7f-a8c677a788fe\",\"review_text\":\"I could have given 5 star but it lack in one feature that is specially seen in resso and other popular app , the feature is microphone feature.....\"},{\"review_id\":\"ff66083b-1136-403c-953a-8d4a7ed01480\",\"review_text\":\"I am not able to play prev track,shuffle list with free subscription. It shows thats only for premium users. Then whats the meaning of having a music app\"},{\"review_id\":\"ae8b8562-09f4-429f-b625-433e831b1a68\",\"review_text\":\"the lyrics aren't appearing\"},{\"review_id\":\"41c0c736-6617-466a-8e4d-3a2b551185e5\",\"review_text\":\"I had unsubscribed, and Spotify stole My money!!!\"},{\"review_id\":\"d48a4890-5eae-4c99-8658-36a87059137f\",\"review_text\":\"No appearance of lyrics is getting irritating now... increase in ads was tolerable, but now lyrics too? before I loved spotify now I am at the verge to delete the app.....\"},{\"review_id\":\"c8ff8961-f881-47e0-a1f5-78a81ea03f4b\",\"review_text\":\"Don\\\"t needed\"},{\"review_id\":\"eea7a582-f65e-45f5-9be6-bd64f6ca8ebe\",\"review_text\":\"Невозможно войти в приложение. Пишет something went wrong\"},{\"review_id\":\"3e7016b6-3d08-48d1-aba6-86f1243330af\",\"review_text\":\"Tumhare bas ka nhi h muje gaane sunana\"},{\"review_id\":\"5b7b12f0-3410-44dc-a92b-8cd8e2e7ebad\",\"review_text\":\"Excellent service and very easy to find songs and download them\"},{\"review_id\":\"a6aec8ae-d4e9-40c4-9d1f-d7353e894ad0\",\"review_text\":\"Music go brrrrr\"}]}"
