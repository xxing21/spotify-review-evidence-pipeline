        "content": "{\"reviews\":[{\"review_id\":\"61f70ee8-8156-4c7c-a9fc-e75d9ff0ecec\",\"review_text\":\"Stops playing in the middle of the song and then starts from beginning. Latest version of app Lattest version of android New samsung phone.\"},{\"review_id\":\"f318668e-0699-4338-9403-e2b8cd440b60\",\"review_text\":\"👍🏻\"},{\"review_id\":\"bac8a2f6-fe06-4e11-af0f-a50a32601a58\",\"review_text\":\"Just quit the download and delete it many times and restart it many times please tell me how to do\"},{\"review_id\":\"d68429ae-167d-45a8-b8fd-bd8da2cc93a6\",\"review_text\":\"So many song are deleted from this app 🤬\"},{\"review_id\":\"92f56a58-bde4-44fc-a69a-f3fbe20aa46b\",\"review_text\":\"Tati\"},{\"review_id\":\"5cd4d248-849f-4d3e-b966-430cea9512a7\",\"review_text\":\"Awful, go to Apple Music or YT music, I’ve changed to Apple and it’s so much better\"},{\"review_id\":\"c079ccc0-bdc3-4eee-bc15-3aef8c6aa3e9\",\"review_text\":\"Best app in 40 MB\"},{\"review_id\":\"327c50a6-7dee-4c79-aa55-06cc9b105fca\",\"review_text\":\"I highly recommend!\"},{\"review_id\":\"5f4c16e5-5388-4c58-9748-26c61aa9e9a7\",\"review_text\":\"the new update is so useless. how can you remove the most basic thing ever needed in a music app? thats so dumb ugh\"},{\"review_id\":\"2323e42d-a4c1-4b98-87f9-3b81b611f2bb\",\"review_text\":\"I also bought Spotify premium recently. but Spotify wrapped up doesn't available in my country. I'm really disappointed\"}]}"
