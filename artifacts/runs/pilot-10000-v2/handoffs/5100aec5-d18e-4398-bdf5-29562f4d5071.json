        "content": "{\"reviews\":[{\"review_id\":\"61bf3f3f-036f-4142-ab47-54949d9980e9\",\"review_text\":\"Not all music is on here\"},{\"review_id\":\"09ef28d8-35db-499a-abd4-329c0b8a3aa7\",\"review_text\":\"If you don't have money for premium, don't bother. They play two songs then 4 commercials. GARBAGE\"},{\"review_id\":\"c5da4a18-ce7c-4d25-a8cd-4913d30e9c94\",\"review_text\":\"The perfect grace music\"},{\"review_id\":\"8f862fac-1a81-494b-9c1d-f6ce17d543d9\",\"review_text\":\"This app is really good i enjoy the music\"},{\"review_id\":\"f1f5ea27-9ce7-4bea-95ea-557d6d402f62\",\"review_text\":\"Arranging your own Playlist\"},{\"review_id\":\"502aa230-c858-4113-81c0-2f46c819a9b6\",\"review_text\":\"Continuously plays music not in your playlist while in the Andriod Auto app connected in your car. Only plays a few songs on your playlist then goes to random unwanted songs. You cant loop your library. Only advance and not able to repeat.\"},{\"review_id\":\"4d388921-b6fa-4021-b71a-b050e72ac56c\",\"review_text\":\"Love how easy it is to use\"},{\"review_id\":\"ec0b9368-fab3-4220-869d-bd3a78b00d61\",\"review_text\":\"I love it but the ads no but I respect it I love it\"},{\"review_id\":\"4a8a27a1-b8af-44ee-a366-8771ad825958\",\"review_text\":\"Super😎\"},{\"review_id\":\"5370b7b1-cd2e-48bd-9a44-9cf9400a96b3\",\"review_text\":\"The new layout for the homepage is the worse. The suggestions are totally out of line and not relevant. Is impossible to find the music I like in an easy way. There should be an option to go back to the old layout.\"}]}"
