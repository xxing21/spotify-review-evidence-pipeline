        "content": "{\"reviews\":[{\"review_id\":\"e89712aa-fb32-4df6-8195-71b31578c2e5\",\"review_text\":\"Best\"},{\"review_id\":\"a88d3260-3816-41b6-a3c7-43f589c080d5\",\"review_text\":\"To many adverts\"},{\"review_id\":\"13aaca55-cd33-4b4c-8c95-7f2dd9b03062\",\"review_text\":\"Hate this application Pakistani people do fast this is Sweden application\"},{\"review_id\":\"b74e0e5e-d1a1-49b9-8a18-58496dfe8ebc\",\"review_text\":\"Nyc\"},{\"review_id\":\"ee29ecdc-87fd-4cca-aa67-100325eb41d5\",\"review_text\":\"Very user friendly, with wide range and good recommendations. I'm enjoying it.\"},{\"review_id\":\"031cc9c5-33ba-46b2-af70-e6d6c2a2bc48\",\"review_text\":\"The free version worked absolutely fine and I loved it until now. IT IS FLOODED WITH ADS MAN and now it doesn't even play songs specifically on demand. GET THE FREE VERSION BACK TO ITS ORIGINAL STATE PLEASE 😭\"},{\"review_id\":\"dd71abc9-c7b6-4547-9ad9-bd2784052bf2\",\"review_text\":\"Looser music appp\"},{\"review_id\":\"82580d59-b2e8-4161-a741-f39d725077f9\",\"review_text\":\"The new update is bad I hate it 😕\"},{\"review_id\":\"968774a7-055f-42b2-8159-d6ed52db7a1e\",\"review_text\":\"Doesn't allow to repeat song or play other song without subscription\"},{\"review_id\":\"30cf2683-158f-406a-a634-3b4498d71378\",\"review_text\":\"Listen to adds to get 30 minutes add free but 2 minutes into the first song played it stops and 5-6 adds begin again and again I've had 3 songs played now and adds halfway in the song and after every song Very frustrating Just plays one song and 5 or 6 adds. Sometimes it happens in the middle of the song\"}]}"
