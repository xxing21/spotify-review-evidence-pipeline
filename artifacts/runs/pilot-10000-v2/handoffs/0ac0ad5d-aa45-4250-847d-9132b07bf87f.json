        "content": "{\"reviews\":[{\"review_id\":\"1ff06123-a289-42b2-aad5-c3183dd935e0\",\"review_text\":\"It's an awful app that provides bad service to force you to pay\"},{\"review_id\":\"88690576-89de-48d9-86cd-952f8df5b134\",\"review_text\":\"This is vorst app #bycootsweden\"},{\"review_id\":\"dcea8edb-4d51-404c-b66b-b166f421933f\",\"review_text\":\"Remove new updates\"},{\"review_id\":\"146e927f-35ae-4062-8567-e03cd24777d7\",\"review_text\":\"My favourite app♥️\"},{\"review_id\":\"5af4a134-9f76-41ab-968f-de0ff1dd4c1e\",\"review_text\":\"I love spotify and all and works fine on wbeething BUT a phone, for example I'll go to play Flaws and Sins then push play and play something else. Please fix!!!\"},{\"review_id\":\"7a1bcec2-b554-4699-ba96-62a056bf9475\",\"review_text\":\"Sets out a great play list based on my taste in music\"},{\"review_id\":\"83b0806e-62f9-44b3-978c-eb4da20ac938\",\"review_text\":\"The new update ruined the app it was a great app I was using the app since 2019 but now it doesn't even allow basic features if I get another streaming app I am shifting.\"},{\"review_id\":\"07455293-fa71-4ce2-b9ed-8cc8df4390c2\",\"review_text\":\"Nonsense of adds\"},{\"review_id\":\"c608b4e2-af45-4940-aef0-2424da586894\",\"review_text\":\"I am a loyal Spotify user but nowadays I hate this app because of You remove all features of this app,\"},{\"review_id\":\"f1ee731f-348f-431f-bb6f-b9b20b311cfa\",\"review_text\":\"Gud platform\"}]}"
