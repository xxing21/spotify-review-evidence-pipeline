        "content": "{\"reviews\":[{\"review_id\":\"b6331430-c7b0-4b1a-a9b1-a4a1dae61c96\",\"review_text\":\"Am well with it\"},{\"review_id\":\"d3d511fe-8432-4f4d-a532-5fcc71df4fc7\",\"review_text\":\"Charge premium for the basic features and this is what you get a single star\"},{\"review_id\":\"f3770e6a-5c12-42c2-b842-f5099343ecf3\",\"review_text\":\"Too many ads and no way ti remove podcasts\"},{\"review_id\":\"31c1e1d5-c081-430d-a1b1-172a32de35e7\",\"review_text\":\"It's good 👍\"},{\"review_id\":\"7ec6f222-1b48-4101-ab81-72b7c2532fb7\",\"review_text\":\"Shuffle feature doesn't work.\"},{\"review_id\":\"634045c3-9a77-4a44-8f0e-8bf509426e38\",\"review_text\":\"What can I do if it said \\\" The subscription isn't available in your google play country\\\" when I want to buy premium\"},{\"review_id\":\"3f7fbd21-2932-4f56-81de-1dc478eedac2\",\"review_text\":\"I love Spotify I love how you find many songs and stuff but honestly the ads never stop. I've had the app for years now and I've notcied how many ads play daily, I've used premium for free and it was amazing but the amount of ads is just waaaayyyyyy too much. I only listened to one song before 2 ads played, like honestly can you guys just turn it down a notch?? I honestly care about you guys making money but please make this easier for me to hear music on the daily then go uninstall it everytime\"},{\"review_id\":\"ad4e9da8-f6ac-47b6-9506-2b61586cfb3e\",\"review_text\":\"Make it user friendly\"},{\"review_id\":\"c93cb086-3162-462f-a776-b0174a0cdc38\",\"review_text\":\"Exceptional experience\"},{\"review_id\":\"1804c795-6513-47b6-9460-daa037082a81\",\"review_text\":\"🇯🇴🇯🇴\"}]}"
