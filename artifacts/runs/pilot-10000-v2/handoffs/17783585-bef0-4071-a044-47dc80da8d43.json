        "content": "{\"reviews\":[{\"review_id\":\"1b788a1a-edf2-4cad-add6-e3b3f330013c\",\"review_text\":\"Love the music selection and the fact that no matter where I am, still can listen my favorite music\"},{\"review_id\":\"4c5697c3-6753-43ae-a96e-41efa0135865\",\"review_text\":\"Greatest app out there\"},{\"review_id\":\"538d1be7-edb0-4a38-abed-df5d5aa49e0c\",\"review_text\":\"Fantastic\"},{\"review_id\":\"0ea3b30d-23a6-4c70-a191-ec0fa67cfd36\",\"review_text\":\"Now its just boring che\"},{\"review_id\":\"37f0afed-3273-44f8-b5b1-9b2d7c6f1af7\",\"review_text\":\"I was I could skip ads for free\"},{\"review_id\":\"465830ea-c4b6-43bf-acdd-90a0a9f244b7\",\"review_text\":\"amazing app for all music\"},{\"review_id\":\"74a04c66-051b-4593-aec8-fdca4eb668fc\",\"review_text\":\"Magra mevaseba\"},{\"review_id\":\"ad194a56-53e2-4cd7-a996-08f5a0557a73\",\"review_text\":\"❤️\"},{\"review_id\":\"7d62e05d-4d25-4aea-9389-e6c1764c5fd1\",\"review_text\":\"I can't receive OTP.\"},{\"review_id\":\"9397488c-6376-4fb9-9b34-747fc7559df9\",\"review_text\":\"Why does it constantly need internet to open up downloaded playlists? Why does it need internet to play downloaded songs? As much as I love Spotify, the app is not fit for purpose.\"}]}"
