        "content": "{\"reviews\":[{\"review_id\":\"fb908616-42f8-44c2-a9f8-50dd1c457bd3\",\"review_text\":\"Used to be the best music app but horrible after the latest update.\"},{\"review_id\":\"e867db5a-9ef2-48f7-93de-b1561ff80a18\",\"review_text\":\"😌\"},{\"review_id\":\"bb14e4f0-7d44-428b-aa43-0b2ad3bc7a28\",\"review_text\":\"Very good music 🎵🎶\"},{\"review_id\":\"fef9e245-a867-4e97-b327-9c5bb44ac1ae\",\"review_text\":\"Even basic features are included in premium\"},{\"review_id\":\"f194e2f2-3372-45db-8c72-afbee54d0b7e\",\"review_text\":\"I like this app , I'm just Not to say with new technology ☹️but I Love to hear old music from time to time♥️\"},{\"review_id\":\"f5c44a01-ce1c-4f5d-9dc5-476b3fbb742f\",\"review_text\":\"This is my only platform for healing my emotions,pain, and every conditions... This is an addiction ❤️‍🩹\"},{\"review_id\":\"5046e5f4-0618-4647-9ce3-e308a67e90c1\",\"review_text\":\"New update is worst , i Uninstalled this app\"},{\"review_id\":\"9b23baab-3f51-464a-86d2-cead2f192df6\",\"review_text\":\"Very bad app and the only thing to orpreat the app is subscription without subscription this app is nothing very bad experience 😡😡\"},{\"review_id\":\"575125f0-0bc5-44a1-b3b6-8086b603c750\",\"review_text\":\"bad app\"},{\"review_id\":\"53d12edd-d69d-4d1c-8a34-07745db63aab\",\"review_text\":\"The best app ever used yet the adds are way too annoying sometimes\"}]}"
