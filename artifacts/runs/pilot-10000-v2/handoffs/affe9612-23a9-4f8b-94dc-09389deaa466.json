        "content": "{\"reviews\":[{\"review_id\":\"7c06e055-2ae9-4eb3-9b5d-07ca5efbbf73\",\"review_text\":\"Great like 80% of the time, works poorly when you have a poor internet connection (even with offline content)\"},{\"review_id\":\"1480e8d9-c41f-4ae3-b031-c5ccea9c799c\",\"review_text\":\"Worst app,after update\"},{\"review_id\":\"098a883d-39cb-478c-9bdd-de5f24b5da13\",\"review_text\":\"I can't rewind songs to good bits eny more please tell me it is a glitch and not an joke because not funny dude\"},{\"review_id\":\"ac9624f4-cf9f-475a-813d-a925c0ce52d4\",\"review_text\":\"Large list of entertainers. Great choices. Easy to Navigate.\"},{\"review_id\":\"546ef64f-c973-46c7-9dae-4f38686804c7\",\"review_text\":\"Coolest music app\"},{\"review_id\":\"60a3b79e-59a7-4643-9d96-a268f39efcf3\",\"review_text\":\"Dumbest app\"},{\"review_id\":\"128a2a6e-b28b-4c1f-90ee-bdb47eb75c0e\",\"review_text\":\"7 advertisements in a row is absolutely ridiculous 🙄\"},{\"review_id\":\"1767ffa9-eb60-4450-827d-6fc1073754c2\",\"review_text\":\"Listen to all the music you want to hear at your fingertips......\"},{\"review_id\":\"c681115e-2974-4c3b-9761-ff0ba9885962\",\"review_text\":\"3 ads between every song.. just greedy now\"},{\"review_id\":\"ebf66a3c-205c-4628-bacb-1e088ed15c0f\",\"review_text\":\"Best in industry.\"}]}"
