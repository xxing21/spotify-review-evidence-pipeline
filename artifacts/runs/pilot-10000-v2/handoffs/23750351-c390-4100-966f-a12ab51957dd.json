        "content": "{\"reviews\":[{\"review_id\":\"512efecf-448e-4343-9d14-93ce589d7cd2\",\"review_text\":\"boykot sweeden\"},{\"review_id\":\"c8bd5247-63d7-44f7-b78a-63ec9adfbe75\",\"review_text\":\"So great\"},{\"review_id\":\"c6802dc4-94a9-4ead-92f5-54f8174f00eb\",\"review_text\":\"Is nxa\"},{\"review_id\":\"176dc290-6d64-4f77-82d5-4939c88fd32e\",\"review_text\":\"I love this app, I have Spotify premium (student plan) and honestly I can't imagine a day with using spotify.\"},{\"review_id\":\"4d058a04-6e32-40b8-abe1-4dcaaf56b252\",\"review_text\":\"There are thousands of songs that I listen to and it's amazing to see how much there is to offer. All my favorite creators are on Spotify which is awesome because I get to listen to every song ever!!\"},{\"review_id\":\"f8065ceb-5af2-466e-80d1-7b80d4744d38\",\"review_text\":\"Nice music app😈\"},{\"review_id\":\"4a3bc8da-0e84-4e52-a169-94fe0d6e702a\",\"review_text\":\"Why can't I skip further into songs, and why are there SO MANY DAMN ADS\"},{\"review_id\":\"aa894df0-861c-4264-8f4c-a41e7e9505b8\",\"review_text\":\"After the update I cannot skip the song after six attempts...its really bag experience\"},{\"review_id\":\"2eb8ba32-69d0-4e0a-81ca-1c4535a4c476\",\"review_text\":\"the best 🙌🏻\"},{\"review_id\":\"80bc68c2-a052-4111-955b-9ccbfe5d78ed\",\"review_text\":\"Ital music all the way. Jah Christfari.\"}]}"
