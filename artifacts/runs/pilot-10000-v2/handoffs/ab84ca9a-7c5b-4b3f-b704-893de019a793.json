        "content": "{\"reviews\":[{\"review_id\":\"9eb843c6-ab2d-459d-8507-5b8128279fcc\",\"review_text\":\"Absolutely can't use it anymore, can't skip to particular part in songs , can't use skip button or replay button , the app won't play the songs next but will play another song in the playlist abd sometimes one that even isn't in playlist, please fix it\"},{\"review_id\":\"87f9a3fd-f30c-43d0-b677-38b210c43310\",\"review_text\":\"Make this a paid app at this point\"},{\"review_id\":\"aa79fe52-744f-4cab-adb2-b99aca01fdae\",\"review_text\":\"app is kind of no use if u dont buy the premium\"},{\"review_id\":\"b082bff4-07d1-431e-9abe-f3d1b8748015\",\"review_text\":\"ESPETACULAR! FENOMENAL!\"},{\"review_id\":\"70b8e8f1-bcdc-4ee5-b9c9-c9e85ff196fc\",\"review_text\":\"What the heck is wrong with this now youtube is much better nowadays!!\"},{\"review_id\":\"c2c3f38f-409a-4a69-b38d-a20e88d78206\",\"review_text\":\"👍👍👌\"},{\"review_id\":\"3dcac15f-f923-4698-b7d0-80ac7e8123f1\",\"review_text\":\"i don't know if i can continue using this with so many restrictions as i cannot affort premium\"},{\"review_id\":\"87e22adb-3064-43d3-9b88-f9b28289b99b\",\"review_text\":\"The best app for everything music 🙌🏿\"},{\"review_id\":\"d8ef1fc0-01b4-4ea3-86ef-8fbf3584863d\",\"review_text\":\"rubbish app\"},{\"review_id\":\"93d5b460-4138-47a7-8865-3b8e2b0d7201\",\"review_text\":\"It's an amazing platform for music lovers!!!!!\"}]}"
