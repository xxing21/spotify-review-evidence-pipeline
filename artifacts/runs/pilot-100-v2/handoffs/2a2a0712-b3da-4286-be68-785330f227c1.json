        "content": "{\"reviews\":[{\"review_id\":\"084077ee-f9be-446a-9935-9e58550d5153\",\"review_text\":\"Thik thak hi hai\"},{\"review_id\":\"ff14ea84-fdec-4363-9b1b-a23dcab287c5\",\"review_text\":\"Good at all\"},{\"review_id\":\"dc73ecd9-3293-4ede-90d5-dd6cd1e8d087\",\"review_text\":\"Great\"},{\"review_id\":\"a78d831a-69f4-428a-9235-cfdd9775c509\",\"review_text\":\"You can't even listen to music you want it just shuffles it, like what the hell? This app is killing it self and forcing you to pay premium for basic things like just listening to music.\"},{\"review_id\":\"d146397f-4a94-4980-be00-ae9212eca3a7\",\"review_text\":\"This was fine till the last update, now you can't even pick a certain song without Spotify premium, and now you can only skip 6 songs, like please just let the songs fit my mood!\"},{\"review_id\":\"4c0242ca-099a-4c89-b11b-219ef28f1e16\",\"review_text\":\"Love it\"},{\"review_id\":\"42f0c9d1-088c-437b-bfc8-c1c36114a8f0\",\"review_text\":\"Fantastic experience\"},{\"review_id\":\"5bc203df-dac3-41ae-8b8d-ee0e8b9d9f50\",\"review_text\":\"Awesome app and music\"},{\"review_id\":\"b39971d2-e3f0-4559-96da-a609f54d9cb4\",\"review_text\":\"Best for listening songs\"},{\"review_id\":\"797d12c7-78dd-4805-a066-342ace701805\",\"review_text\":\"Kudos spotify\"}]}"
