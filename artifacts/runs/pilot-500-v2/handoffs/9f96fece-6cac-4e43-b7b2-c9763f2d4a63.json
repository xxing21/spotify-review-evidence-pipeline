        "content": "{\"reviews\":[{\"review_id\":\"68107809-52c1-469d-a78a-569280e49ed6\",\"review_text\":\"It's not even a basic music player anymore... Spotify more like Shity-fy\"},{\"review_id\":\"130820bc-da31-46d3-9088-b09cb62cf241\",\"review_text\":\"Worse app, useless\"},{\"review_id\":\"8216dafb-b5e2-47e2-b342-9f73c203b56e\",\"review_text\":\"sucks\"},{\"review_id\":\"ad718533-a53f-475b-b200-58ab07d07d5b\",\"review_text\":\"nice song\"},{\"review_id\":\"5fb51bd0-dbe9-4a19-a466-a77f0c14393e\",\"review_text\":\"No good\"},{\"review_id\":\"86adc9b6-be58-400c-9a08-aa082ff0535c\",\"review_text\":\"Very bad experience ever faced by any app. They are literally forcing us to purchase Spotify premium.\"},{\"review_id\":\"5d5e08d1-1686-4c86-b9bd-cb0f3a719e0b\",\"review_text\":\"Time to switch to another platform. Spotify team has made a bad decision with the new updates.\"},{\"review_id\":\"46b77196-0d17-4a48-b376-03a50b3d7440\",\"review_text\":\"Simply awesome\"},{\"review_id\":\"b7b8c665-4ca5-4123-8ff4-fc874a4a7f93\",\"review_text\":\"Nice song app\"},{\"review_id\":\"f1c0acd2-8eaf-421c-8143-9908a9a527fc\",\"review_text\":\"🔥🔥🔥🔥🔥\"}]}"
