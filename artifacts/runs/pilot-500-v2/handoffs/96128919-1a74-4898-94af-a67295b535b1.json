        "content": "{\"reviews\":[{\"review_id\":\"55bc2f5d-0157-467b-8f5c-2f9c7d1b0c04\",\"review_text\":\"Roasted app\"},{\"review_id\":\"710e1aee-ed80-4753-9c4e-c63bee84fd56\",\"review_text\":\"Excellent\"},{\"review_id\":\"0839f80d-e672-4954-b50e-20f85c2b8d16\",\"review_text\":\"noice\"},{\"review_id\":\"b45ac639-166c-4089-a716-d462162a918b\",\"review_text\":\"I Love it so much\"},{\"review_id\":\"0fcf89b2-0b81-4838-bf5f-41c684e43b2d\",\"review_text\":\"When I playing song the app is shoutdowning\"},{\"review_id\":\"e2fc1a52-c841-4122-8124-02e2ada9a345\",\"review_text\":\"Best music app\"},{\"review_id\":\"651e6e7b-f93e-4369-9631-15c73ddcd4ad\",\"review_text\":\"I dont know what happened, but the app experience has gotten worse over the course of a month. There are random long pauses when gapless playback is on, the music randomly stops and won't play/pause on demand, and recently the entire app wont load past the first screen. I have re downloaded the app countless times, restarted my phone and cleared the data on the app and nothing is working. This is very unfortunate and has me reconsidering how great this app actually is.\"},{\"review_id\":\"8f848aef-444d-4f95-8868-8579f690beb0\",\"review_text\":\"Worst app for listening music ...\"},{\"review_id\":\"4001e2ec-2621-4256-b42d-c4988458a293\",\"review_text\":\"Very cheap App\"},{\"review_id\":\"b4f4440f-d952-405d-bf7b-f19fb0adf484\",\"review_text\":\"Please bring back the search function in my playlist I don't know why you ever got rid of it epic fail bring it back.\"}]}"
