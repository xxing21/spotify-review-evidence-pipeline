        "content": "{\"reviews\":[{\"review_id\":\"16929558-ce1e-4b87-8738-a1de3f557f66\",\"review_text\":\"I paid my subscription and im still getting a pause subscription screen and can't access my music...... help me\"},{\"review_id\":\"d26566f7-a898-4298-a06a-50bd3f7319c1\",\"review_text\":\"Could be doing with hi-res audio don't like getting bombarded with playlist recommendations when the option is turned off\"},{\"review_id\":\"6db48f4b-20a0-460f-9beb-e07cd20f9fab\",\"review_text\":\"Awesom\"},{\"review_id\":\"890aeb60-e7cf-4f0d-a321-03a1c8b65757\",\"review_text\":\"Bad everything is about premium no basic features\"},{\"review_id\":\"61d5fc66-9bd1-4a18-8185-ae9a451e05a3\",\"review_text\":\"Best experience\"},{\"review_id\":\"d27e9b26-a7af-469c-9a4e-8deea2db72ae\",\"review_text\":\"Great place for music. Bad for smaller artists and a platform for idiots like Joe Rogan and Steven Crowder to spread their stupidity.\"},{\"review_id\":\"e667ab56-1b04-4596-bfd9-69f5919dcc10\",\"review_text\":\"Just need the download button on mobile to show for ever song\"},{\"review_id\":\"7e610236-5f6a-404f-a503-ed466c6700eb\",\"review_text\":\"Good quality of songs and more number of accounts with premium plans\"},{\"review_id\":\"5fb2a0b0-bb06-4d73-b6ff-1a2d332fae37\",\"review_text\":\"Just awesome\"},{\"review_id\":\"35008b46-daf1-497c-ac9b-fe98f120f912\",\"review_text\":\"Good app\"}]}"
