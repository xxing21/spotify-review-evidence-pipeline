        "content": "{\"reviews\":[{\"review_id\":\"c3fd591f-890c-4721-bd99-57c3600ae82c\",\"review_text\":\"It's really very easy for streaming different songs\"},{\"review_id\":\"ee17dcd6-07c0-4441-8e64-e7ea57877c78\",\"review_text\":\"Too much adds🙄🥲\"},{\"review_id\":\"b551645f-204f-4134-b3ec-dd37dda36d95\",\"review_text\":\"Best app for listeners\"},{\"review_id\":\"e81ef9d4-212d-47fc-b360-f9a1914f2bcf\",\"review_text\":\"Stunning\"},{\"review_id\":\"6f51891d-fa49-45e5-b2b2-27172682ab8f\",\"review_text\":\"I love this app!\"},{\"review_id\":\"9db060c5-2ff5-493a-8a19-01a3da91ff1d\",\"review_text\":\"The made everything paid at this point they will take money to play the song almost all features are gone limited songs of your choice\"},{\"review_id\":\"aa8fec15-2de4-46af-a911-1b49bcb4eb4c\",\"review_text\":\"This was the best app to listen music but the new feature ruined this app 😒 I MEAN WHAT THE HELL IS WRONG WITH SPOTIFY AB !!! you put every basic feature in the premium pack and we can't even listen song in ROW NOW !!! worst update in history of spotify in my opinion\"},{\"review_id\":\"bc1c4825-00c5-458d-ac00-098ce729c76d\",\"review_text\":\"Best app ever... GET PRENIUM ITS WORTH TRUST!!! uuhhh yeah thats abt it!!! love spotify... m eyah\"},{\"review_id\":\"9f7a013a-082e-4ec1-8a65-a1e0a0395d20\",\"review_text\":\"Nice app but why can't the lyrics of song on my playlist load?\"},{\"review_id\":\"f9e87b89-b080-48a2-a019-5c5dcf1689a6\",\"review_text\":\"I enjoye beautiful music and works very well.\"}]}"
